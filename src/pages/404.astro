---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { SOLUCIONES } from '../data/sitio';
---

<Base titulo="Página no encontrada | Data Studio" descripcion="La página que buscas no existe o cambió de dirección.">
  <section class="seccion no-encontrada" data-tema="oscuro" aria-labelledby="nf-titulo">
    <div class="contenedor">
      <p class="etiqueta">Error 404</p>
      <h1 id="nf-titulo" class="titulo-seccion no-encontrada__titulo">Esta página no existe o cambió de dirección.</h1>
      <p class="entrada">Revisa la dirección o sigue por alguna de nuestras soluciones.</p>
      <ul class="no-encontrada__enlaces" role="list">
        {SOLUCIONES.map((s) => (
          <li>
            <a href={s.href}>
              <span>{s.nombre}</span>
              <Icono nombre="flecha" />
            </a>
          </li>
        ))}
      </ul>
      <div class="acciones">
        <a class="boton boton--primario" href="/">Volver al inicio</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .no-encontrada {
    min-height: 70vh;
  }

  .no-encontrada .contenedor {
    display: grid;
    gap: var(--space-5);
  }

  .no-encontrada__titulo {
    max-width: 20ch;
  }

  .no-encontrada__enlaces {
    display: grid;
    max-width: 34rem;
    margin: var(--space-3) 0;
    padding: 0;
  }

  .no-encontrada__enlaces li + li {
    border-top: 1px solid var(--linea);
  }

  .no-encontrada__enlaces a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.25rem;
    color: var(--texto);
    font-weight: var(--peso-medio);
    text-decoration: none;
  }

  .no-encontrada__enlaces a:hover {
    color: var(--acento);
  }

  .no-encontrada__enlaces :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--acento);
  }
</style>
