---
/**
 * Inicio: presenta la marca y distribuye hacia las subpáginas de producto.
 * Portada (sticky) → Soluciones (telón que sube; las barras del logo se abren en los
 * cuatro productos) → Vitrinas por producto → Manifiesto (cierra con la forma de trabajo).
 * La explicación completa y los botones de WhatsApp viven en cada subpágina.
 */
import Base from '../layouts/Base.astro';
import Portada from '../components/inicio/Portada.astro';
import Soluciones from '../components/inicio/Soluciones.astro';
import Vitrinas from '../components/inicio/Vitrinas.astro';
import Manifiesto from '../components/inicio/Manifiesto.astro';
import { SITIO, SOLUCIONES } from '../data/sitio';

const listaSoluciones = {
  '@type': 'ItemList',
  '@id': `${SITIO.url}/#soluciones`,
  name: 'Soluciones de Data Studio',
  itemListElement: SOLUCIONES.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.nombre.replace('‑', '-'),
    url: `${SITIO.url}${s.href}`,
  })),
};
---

<Base inicio datosEstructurados={[listaSoluciones]}>
  <div class="telon">
    <!-- Marca de posición: el encabezado es transparente mientras esta franja está en pantalla -->
    <div class="telon__marca" data-portada aria-hidden="true"></div>
    <Portada />
    <Soluciones />
  </div>
  <Vitrinas />
  <Manifiesto />
</Base>

<style>
  /* La portada lee dos líneas de tiempo de la sección de soluciones: --telon (la hoja que
     sube) y --grafico (las barras que se llenan mientras las del logo se vacían). */
  .telon {
    position: relative;
    timeline-scope: --telon, --grafico;
  }

  .telon__marca {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 85svh;
    pointer-events: none;
  }
</style>
