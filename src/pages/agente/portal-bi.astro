/**
 * La base de conocimiento del agente de IA de WhatsApp (Meta) sobre el Portal BI. ADR-023.
 * Página OCULTA (src/data/ocultas.mjs): noindex, fuera del sitemap, sin enlaces públicos.
 *
 * Meta la lee desde su dirección y guarda lo que extrae. Después de cambiarla, hay que pedirle al
 * agente que la vuelva a leer: no se entera solo de cada cambio.
 *
 * Lo que el agente lee lo puede repetir textual a un cliente, así que acá no va nada interno: ni
 * cómo está construido el portal, ni nombres de clientes, ni acuerdos con socios. Oculta no es
 * privada: los precios quedan a la vista de quien tenga la dirección, como en la propuesta a
 * Ribentek (ADR-020).
 *
 * Los números salen de src/data/sitio.ts, y la lista del ahorro se calcula: nunca a mano. En los
 * chats de noviembre, las cuentas hechas a mano salieron mal justo en el mensaje del ahorro.
 * Las reglas de qué decir y qué no salen de los chats reales (docs/ventas.md del portal).
 */
import PaginaOculta from '../../components/PaginaOculta.astro';
import {
  CONTACTO,
  MENSAJES,
  PRECIO_LICENCIA_USD,
  PRECIO_PREMIUM_USUARIO_USD,
  PRECIOS_PORTAL_USD,
} from '../../data/sitio';
import '../../styles/agente.css';

const LIC = PRECIO_LICENCIA_USD;
const PREMIUM = PRECIO_PREMIUM_USUARIO_USD;
const CODIGO = PRECIOS_PORTAL_USD.codigo;
const SUSCRIPCION = PRECIOS_PORTAL_USD.suscripcionMensual;

/** 1512 → «1.512», como se escribe en el chat. */
const n = (x: number) => String(Math.round(x)).replace(/\B(?=(\d{3})+(?!\d))/g, '.');

/** En cuánto se paga el código con lo que se ahorra cada mes, dicho como en una conversación. */
function plazo(meses: number): string {
  if (meses < 0.95) return 'menos de un mes';
  if (meses < 1.25) return 'un mes';
  if (meses < 1.75) return 'un mes y medio';
  const redondo = Math.round(meses);
  const diferencia = meses - redondo;
  if (Math.abs(diferencia) < 0.1) return `${redondo} meses`;
  return diferencia < 0 ? `casi ${redondo} meses` : `poco más de ${redondo} meses`;
}

/* Los tamaños que aparecieron en los chats, más los redondos */
const PERSONAS = [5, 6, 8, 10, 20, 30, 40, 50, 100, 150, 200];
const AHORRO = PERSONAS.map((personas) => {
  const hoy = personas * LIC;
  const ahorro = (personas - 1) * LIC;
  const resto = ahorro - SUSCRIPCION;
  return {
    personas,
    hoy,
    premium: personas * PREMIUM,
    ahorro,
    anual: ahorro * 12,
    codigo: plazo(CODIGO / ahorro),
    suscripcion:
      resto < 0
        ? `La suscripción cuesta US$ ${n(-resto)} al mes más que lo que ahorra.`
        : `Con la suscripción les quedan US$ ${n(resto)} al mes.`,
  };
});
