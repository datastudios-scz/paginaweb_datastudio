---
/**
 * Propuesta a Ribentek: que revendan el Portal BI a sus clientes. ADR-020.
 * Página OCULTA: cuelga de /propuestas/ (noindex, fuera del sitemap, sin enlaces públicos).
 *
 * Es el anuncio del Portal BI, el mismo de redes, en su versión para quien lo revende
 * (<Anuncio variante="socio" />): el recorrido entero —el ingreso con la marca, los tableros
 * de cada uno, el tablero abierto, el chat con IA al costado— y al final lo que es para ellos:
 * nosotros lo instalamos, lo dejamos funcionando y lo mantenemos; ellos venden y cobran; les
 * cobramos US$ 60 al mes por cliente; la IA la paga cada cliente.
 *
 * Revisión del dueño (18/10/2026): la primera versión eran doce láminas con texto, una
 * calculadora del margen y «te facturamos». Pidió sacar las cuentas («no son tontos»), lo de
 * facturar (no facturamos) y el texto, y mostrar el anuncio, que cuenta el recorrido entero.
 * Se reproduce solo y vuelve a empezar; el formato sigue a la pantalla (16:9 acostada, 9:16
 * parada). Oculta no es privada: el precio está a la vista de quien tenga la dirección.
 */
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Logo from '../../components/Logo.astro';
import Anuncio from '../../components/anuncio/Anuncio.astro';
import '../../components/anuncio/anuncio.css';
---

<Base
  titulo="Portal BI para Ribentek · Data Studio"
  descripcion="El Portal BI para que Ribentek lo revenda: Power BI para toda la empresa de sus clientes, con una sola licencia, su marca y un chat con IA. Nosotros lo instalamos y lo dejamos funcionando."
  imagen="/og/portal-bi.png"
  inmersiva
  indexar={false}
>
  <div class="an an--socio" data-a="raiz" data-formato-auto>
    <header class="an-barra">
      <p class="an-barra__firma">
        <Logo variante="icono" decorativo />
        <span>Data Studio × Ribentek</span>
      </p>
      <h1 class="an-barra__nombre">Portal BI para Ribentek · 62 s</h1>
      <div class="an-controles">
        <button type="button" class="an-control" data-a="pausa" aria-label="Pausar" title="Pausar (espacio)">
          <span class="an-control__pausar"><Icono nombre="pausa" /></span>
          <span class="an-control__seguir"><Icono nombre="reproducir" /></span>
        </button>
        <button type="button" class="an-control" data-a="reiniciar" aria-label="Desde el principio" title="Desde el principio">
          <Icono nombre="reiniciar" />
        </button>
        <button type="button" class="an-control" data-a="completa" aria-label="Pantalla completa" title="Pantalla completa">
          <Icono nombre="expandir" />
        </button>
      </div>
    </header>

    <div class="an-sala an-sala--sola">
      <div class="an-marco">
        <Anuncio variante="socio" />
      </div>
    </div>
  </div>

  <script>
    import '../../scripts/anuncio';
  </script>
</Base>
