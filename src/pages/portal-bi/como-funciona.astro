---
/**
 * El recorrido animado del Portal BI: lo que vive una persona de tu equipo, del ingreso al
 * chat con IA, como una grabación de pantalla con narración. Se llega desde el botón
 * «Mira cómo funciona» del héroe de /portal-bi/ (con #ver arranca solo; si se entra directo,
 * la pantalla espera el botón Reproducir).
 *
 * La pantalla es el portal dibujado a tamaño real (RecorridoPantalla.astro); el marco (barra,
 * ventana, portada, cierre y narración) es RecorridoMarco.astro, compartido con el recorrido
 * del administrador; el guion vive en src/scripts/recorrido.ts y el motor que lo anima en
 * recorrido-motor.ts; los estilos en recorrido.css (lo común) y recorrido-pantalla.css (esta
 * pantalla).
 * Datos de ejemplo (ADR-013). Decisión: ADR-015.
 */
import Base from '../../layouts/Base.astro';
import RecorridoMarco from '../../components/portal/RecorridoMarco.astro';
import RecorridoPantalla from '../../components/portal/RecorridoPantalla.astro';
import { SITIO } from '../../data/sitio';
import { migas } from '../../scripts/esquemas';
import '../../components/portal/recorrido.css';
import '../../components/portal/recorrido-pantalla.css';

const URL_PAGINA = `${SITIO.url}/portal-bi/como-funciona/`;

/** El guion: un paso, una frase. Cada afirmación es algo que el producto hace hoy. */
const PASOS = [
  {
    titulo: 'Cada persona entra con su usuario.',
    detalle: 'Sin cuenta de Power BI y sin una licencia propia. La pantalla lleva tu marca, tus colores y tu logo.',
  },
  {
    titulo: 'Encuentra solo lo que le asignaste.',
    detalle: 'Los tableros aparecen agrupados por área en el menú. Un operador ve uno; una gerente, los de todas sus sucursales.',
  },
  {
    titulo: 'Abre Power BI dentro de tu portal.',
    detalle: 'El reporte se dibuja desde tu propio Power BI, en el momento. Con una sola licencia: la de la cuenta que publica.',
  },
  {
    titulo: 'Se lleva los datos cuando los necesita.',
    detalle: 'Exporta a Excel desde los visuales del reporte. Y si en un tablero prefieres que no, lo ocultas desde el panel.',
  },
  {
    titulo: 'Y ahora, tus datos hablan.',
    detalle: 'El chat se abre con un clic, al costado del tablero, para preguntar mirando los mismos datos.',
  },
  {
    titulo: 'Pregunta como le hablaría a un analista.',
    detalle: 'En español y con sus palabras. El chat la traduce a una consulta sobre tu modelo de Power BI y la ejecuta.',
  },
  {
    titulo: 'Responde con tus datos y te muestra cómo.',
    detalle: 'La consulta que se ejecutó queda a la vista: quien conoce el modelo puede revisarla antes de decidir.',
  },
  {
    titulo: 'Y si se entiende mejor dibujado, lo dibuja.',
    detalle: 'Un gráfico a pedido, listo para copiarlo como imagen y pegarlo en un informe.',
  },
];

/** Lo que dice la narración antes de empezar y al terminar. */
const INICIO = {
  n: 'Portal BI · 1 minuto',
  titulo: 'Así lo vive tu equipo.',
  detalle: 'Del ingreso a conversar con tus datos, en una sola toma: lo que ve cada persona cuando entra a tu portal.',
};
const CIERRE = {
  n: 'Portal BI',
  titulo: 'Todo esto, con una sola licencia de Power BI.',
  detalle: 'El código es tuyo y la marca también. Lo implementas tú o lo implementamos por ti.',
};
---

<Base
  titulo="Cómo funciona el Portal BI, paso a paso · Data Studio"
  descripcion="Mira en un minuto lo que vive tu equipo con el Portal BI: entra con su usuario, abre Power BI sin licencia propia, descarga los datos y conversa con ellos."
  imagen="/og/portal-bi.png"
  imagenAlt="Portal BI de Data Studio: Power BI para toda la empresa con una sola licencia. Y ahora, tus datos hablan."
  inmersiva
  datosEstructurados={[
    migas([
      { nombre: 'Inicio', url: `${SITIO.url}/` },
      { nombre: 'Portal BI', url: `${SITIO.url}/portal-bi/` },
      { nombre: 'Cómo funciona', url: URL_PAGINA },
    ]),
  ]}
>
  <RecorridoMarco
    nombre="Cómo funciona"
    nombreExtra=" el Portal BI"
    url="portal.tuempresa.com"
    escena="ingreso"
    inicio={INICIO}
    pasos={PASOS}
    cierre={CIERRE}
    otro={{ href: '/portal-bi/como-funciona/administrador/#ver', texto: 'Ver cómo se administra' }}
  >
    <span class="rc-descarga" data-r="descarga" slot="barra">
      <span class="rc-descarga__ico">
        <svg class="rc-descarga__bajando" viewBox="0 0 24 24"><path d="M12 4v12M6 11l6 6 6-6" /></svg>
        <svg class="rc-descarga__ok" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
      </span>
      Ventas por sucursal.xlsx
    </span>
    <RecorridoPantalla />
  </RecorridoMarco>

  <script>
    import '../../scripts/recorrido';
  </script>
</Base>
