---
/**
 * Página de Social Metrics BI (SMB). Contenido entregado por el dueño (ortografía corregida)
 * y verdad del producto en public/privacidad/: Meta es el núcleo; también YouTube y TikTok,
 * siempre de solo lectura. Se contrata como servicio (MENSAJES.social).
 * Recorrido: héroe → antes/después (el dolor de juntar métricas a mano) → qué es → el tablero →
 * qué incluye → acceso → implementación → tus datos → preguntas → cierre con la pregunta del dueño.
 * Acción principal: «Contrata tu tablero de redes». Esta página no lleva montos.
 * La sección "Tus datos" es además la descripción pública que revisan las plataformas:
 * no quitarla ni cambiar su significado sin revisar docs/seguridad.md.
 */
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Migas from '../components/Migas.astro';
import Ventana from '../components/portal/Ventana.astro';
import MaquetaTablero from '../components/social/MaquetaTablero.astro';
import Preguntas, { type Pregunta } from '../components/Preguntas.astro';
import { CONTACTO, MENSAJES, SITIO, enlaceWhatsApp } from '../data/sitio';
import { faqPage, migas } from '../scripts/esquemas';
import '../styles/producto.css';

const URL_PAGINA = `${SITIO.url}/social-metrics-bi/`;
const contratar = enlaceWhatsApp(MENSAJES.social);
const correo = `mailto:${CONTACTO.email}?subject=${encodeURIComponent('Social Metrics BI')}`;

const PREGUNTAS: Pregunta[] = [
  {
    pregunta: '¿Qué redes sociales puedo conectar?',
    respuesta:
      '<p>El núcleo es Meta: <strong>Facebook e Instagram</strong>, a través de sus APIs oficiales. También conectamos <strong>YouTube y TikTok</strong>.</p><p>En todos los casos el acceso es de solo lectura y se limita a las cuentas que tú autorizas.</p>',
  },
  {
    pregunta: 'Ya veo las estadísticas dentro de cada red. ¿Qué gano con esto?',
    respuesta:
      '<p>Dentro de cada red las ves por separado y, para compararlas, alguien tiene que copiar los números a una hoja de cálculo. Con Social Metrics BI llegan todas juntas a un solo tablero de Power BI, con todo tu histórico y la comparación contra el período anterior.</p><p>Y tu equipo ya no tiene que entrar a cada red: abre un solo tablero, con su usuario en el Portal BI o dentro de tu sitio web.</p>',
  },
  {
    pregunta: '¿Qué métricas voy a ver en el tablero?',
    respuesta:
      '<p>Las métricas clave de tus redes: alcance, interacciones, campañas, reacciones, comentarios, veces compartido, seguidores y publicaciones. En video, también visualizaciones, tiempo de reproducción y retención de audiencia.</p><p>La audiencia se muestra siempre en forma agregada (por país, edad, género y fuentes de tráfico), y con todo el histórico de tus cuentas. Cada red entrega sus propias métricas, así que no todas existen en todas las plataformas.</p>',
  },
  {
    pregunta: '¿Cómo entra mi equipo al tablero?',
    respuesta:
      '<p>De dos formas: con su usuario y contraseña en nuestro <a href="/portal-bi/">Portal BI</a>, o incrustado en una página de tu sitio web (modalidad iframe).</p><p>Quiénes tienen acceso se define en las reuniones de coordinación, junto con el aprovisionamiento de usuarios.</p>',
  },
  {
    pregunta: '¿Cómo se actualizan los datos?',
    respuesta:
      '<p>Solos. Las actualizaciones son automáticas y programadas, así que nadie tiene que exportar ni cargar archivos. Los detalles se definen en las reuniones de coordinación, junto con la infraestructura del servicio.</p>',
  },
  {
    pregunta: '¿Qué hacen con mis datos? ¿Puedo retirar el acceso?',
    respuesta:
      '<p>Solo los leemos: no publicamos, no editamos y no eliminamos nada en tus cuentas. Los usamos únicamente para los tableros de tu empresa y no los vendemos ni los compartimos con terceros.</p><p>Puedes revocar el acceso cuando quieras, sin pedírnoslo: en Meta, desde Configuración, en «Aplicaciones y sitios web»; en YouTube, desde los permisos de tu cuenta de Google; en TikTok, desde Configuración, en «Seguridad y permisos» y luego «Administrar aplicaciones». El detalle está en la <a href="/privacidad/">Política de Privacidad</a>.</p>',
  },
  {
    pregunta: '¿Cuánto cuesta?',
    respuesta:
      '<p>Escríbenos por WhatsApp y te respondemos con el precio. Cuéntanos qué redes quieres conectar y cómo va a abrir el tablero tu equipo: con login en el Portal BI o dentro de tu sitio web.</p>',
  },
  {
    pregunta: '¿Cómo empezamos?',
    respuesta:
      '<p>Escríbenos por WhatsApp. Coordinamos una primera reunión para definir la infraestructura del servicio y los usuarios, y seguimos a distancia: todo el proceso es 100 % remoto, desde cualquier país.</p><p>Tu parte es autorizar tus cuentas con el acceso oficial de cada red. El resto lo coordinamos contigo.</p>',
  },
];

const METRICAS = [
  { grupo: 'Alcance y rendimiento', lista: ['alcance', 'interacciones', 'campañas', 'reacciones', 'comentarios', 'veces compartido'] },
  { grupo: 'Video', lista: ['visualizaciones', 'tiempo de reproducción', 'retención de audiencia'] },
  { grupo: 'Comunidad', lista: ['seguidores', 'suscriptores', 'publicaciones'] },
  { grupo: 'Audiencia, siempre agregada', lista: ['país', 'edad', 'género', 'fuentes de tráfico'] },
];

const INCLUYE = [
  { fuerte: 'Conexión directa con Meta', resto: '(Facebook e Instagram). También YouTube y TikTok.' },
  { fuerte: 'Todos los datos históricos', resto: 'de tus redes sociales, no solo los últimos días.' },
  { fuerte: 'Métricas clave:', resto: 'alcance, interacciones, campañas y más.' },
  { fuerte: 'Visualización integrada en Power BI.', resto: '' },
  { fuerte: 'Monitorea y actúa', resto: 'sin depender de múltiples plataformas.' },
  { fuerte: 'Interfaz de login de usuario:', resto: 'tus datos seguros en nuestro Portal BI.' },
  { fuerte: 'Apertura de tableros', resto: 'en modalidad iframe, incrustados en tu sitio web.' },
  { fuerte: 'Actualizaciones automáticas', resto: 'programadas.' },
];

const PASOS = [
  { titulo: 'Reuniones de coordinación', texto: 'Definimos contigo la infraestructura del servicio: qué cuentas se conectan y dónde se procesan los datos.' },
  { titulo: 'Conexión de tus cuentas', texto: 'Autorizas cada cuenta con el acceso oficial de su plataforma, en modo solo lectura.' },
  { titulo: 'Aprovisionamiento de usuarios', texto: 'Damos de alta a las personas de tu equipo que van a abrir el tablero.' },
  { titulo: 'Tablero funcionando', texto: 'Tu equipo entra con su usuario o lo ve en tu sitio, y los datos se actualizan solos.' },
];

const REGLAS = [
  { titulo: 'Solo lectura', texto: 'No publicamos, no editamos y no eliminamos nada en tus cuentas.' },
  { titulo: 'Solo lo que autorizas', texto: 'Accedemos únicamente a las cuentas que tú autorizas, con el acceso oficial de cada plataforma.' },
  { titulo: 'Uso interno', texto: 'Los datos alimentan los tableros de tu empresa y nada más. No los usamos para publicidad ni para entrenar modelos.' },
  { titulo: 'Sin terceros', texto: 'No vendemos, no cedemos y no compartimos tu información con terceros.' },
  { titulo: 'Revocable', texto: 'Retiras el acceso cuando quieras desde la configuración de cada red, sin tener que pedírnoslo.' },
];
---

<Base
  titulo="Social Metrics BI | Métricas de Facebook, Instagram, YouTube y TikTok en Power BI · Data Studio"
  descripcion="Deja de copiar métricas a mano: Facebook, Instagram, YouTube y TikTok en un solo tablero de Power BI, con todo tu histórico. Solo lectura, APIs oficiales."
  imagen="/og/social-metrics-bi.png"
  imagenAlt="Social Metrics BI de Data Studio: tus redes sociales en un solo tablero de Power BI"
  datosEstructurados={[
    migas([
      { nombre: 'Inicio', url: `${SITIO.url}/` },
      { nombre: 'Social Metrics BI', url: URL_PAGINA },
    ]),
    faqPage(PREGUNTAS, URL_PAGINA),
    {
      '@type': 'Service',
      '@id': `${URL_PAGINA}#servicio`,
      name: 'Social Metrics BI',
      alternateName: 'SMB',
      serviceType: 'Analítica de redes sociales en Power BI',
      description:
        'Métricas de Facebook e Instagram desde las APIs oficiales de Meta, y también de YouTube y TikTok, integradas en un tablero de Power BI con histórico y actualizaciones automáticas programadas. Acceso de solo lectura.',
      provider: { '@id': `${SITIO.url}/#organizacion` },
      areaServed: 'Worldwide',
      url: URL_PAGINA,
    },
  ]}
>
  <!-- ═════════ HÉROE: la frase del dueño a la izquierda, el tablero a la derecha ═════════ -->
  <section class="prod-heroe" data-tema="oscuro" aria-labelledby="smb-titulo">
    <div class="contenedor">
      <Migas actual="Social Metrics BI" solucion="social-metrics" />

      <div class="prod-heroe__rejilla">
        <div class="prod-heroe__texto">
          <h1 id="smb-titulo" class="prod-heroe__titulo">
            Empodera tu marketing con <span class="prod-acento">Social Metrics BI.</span>
          </h1>
          <p class="prod-heroe__bajada">
            Tus métricas de Facebook, Instagram, YouTube y TikTok en un solo tablero de Power BI. Impulsa tu equipo
            de marketing con análisis detallados, resultados medibles y los datos clave al alcance de tu mano.
          </p>
          <div class="acciones">
            <a class="boton boton--primario" href={contratar} target="_blank" rel="noopener noreferrer">
              <Icono nombre="whatsapp" />
              <span>Contrata tu tablero de redes</span>
            </a>
            <a class="boton boton--secundario" href="#tablero">Mira cómo se ve el tablero</a>
          </div>
          <p class="smb-heroe__nota">
            No publicamos nada en tus cuentas y retiras el acceso cuando quieras.
            <a class="enlace" href="#datos">Así tratamos tus datos</a>.
          </p>
          <ul class="prod-sellos" role="list">
            <li><Icono nombre="check" />APIs oficiales</li>
            <li><Icono nombre="check" />Solo lectura</li>
            <li><Icono nombre="check" />Con todo tu histórico</li>
            <li><Icono nombre="check" />Se actualiza solo</li>
          </ul>
        </div>

        <div class="smb-heroe__visual">
          <Ventana
            url="portal.tuempresa.com/tableros/redes"
            descripcion="Maqueta de la vista de publicaciones de Social Metrics BI con datos de ejemplo: publicaciones del período, alcance medio, tasa de interacción y el ranking de las publicaciones de Instagram con más alcance."
          >
            <MaquetaTablero variante="publicaciones" />
          </Ventana>
        </div>
      </div>

      <nav class="prod-indice" aria-label="En esta página">
        <span class="prod-indice__rotulo">En esta página</span>
        <a href="#que-es">Qué es</a>
        <a href="#tablero">El tablero</a>
        <a href="#incluye">Qué incluye</a>
        <a href="#acceso">Acceso</a>
        <a href="#implementacion">Implementación</a>
        <a href="#datos">Tus datos</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
    </div>
  </section>

  <!-- ═════════ ANTES / DESPUÉS: el dolor de juntar métricas a mano, fila por fila ═════════ -->
  <section class="seccion prod-seccion" data-tema="blanco" aria-labelledby="dolor-titulo">
    <div class="contenedor">
      <header class="prod-cabecera">
        <h2 id="dolor-titulo" class="titulo-seccion">¿Cuántas pestañas abres cada lunes para armar el reporte de redes?</h2>
        <p class="entrada">
          El tiempo se va en juntar números, no en decidir qué hacer con ellos. Con Social Metrics BI, las métricas
          de todas tus cuentas llegan solas a un mismo tablero.
        </p>
      </header>
      <div class="prod-antes-despues">
        <div class="prod-ad prod-ad--antes">
          <h3>Red por red, a mano</h3>
          <ul role="list">
            <li><Icono nombre="cerrar" /><span>Entras a cada red por separado.</span></li>
            <li><Icono nombre="cerrar" /><span>Copias los números a una hoja de cálculo, a mano.</span></li>
            <li><Icono nombre="cerrar" /><span>Para comparar con meses anteriores, buscas archivos viejos.</span></li>
            <li><Icono nombre="cerrar" /><span>Cuando el reporte está listo, los datos ya cambiaron.</span></li>
          </ul>
        </div>
        <div class="prod-ad prod-ad--despues">
          <h3>Con Social Metrics BI</h3>
          <ul role="list">
            <li><Icono nombre="check" /><span>Todas tus redes en un solo tablero de Power BI.</span></li>
            <li><Icono nombre="check" /><span>Los datos llegan solos, con actualizaciones programadas.</span></li>
            <li><Icono nombre="check" /><span>Todo tu histórico en el mismo lugar, no solo los últimos días.</span></li>
            <li><Icono nombre="check" /><span>Tu equipo decide con datos frescos, cuando los necesita.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════ QUÉ ES: el texto del dueño + el recorrido de los datos ═════════ -->
  <section class="seccion prod-seccion" id="que-es" data-tema="claro" aria-labelledby="que-es-titulo">
    <div class="contenedor prod-par prod-par--inicio">
      <div class="smb-columna">
        <header class="prod-cabecera">
          <h2 id="que-es-titulo" class="titulo-seccion">Tus redes sociales, directo a Power BI.</h2>
          <p class="entrada">
            <strong>SMB, Social Metrics BI,</strong> conecta directamente con las APIs oficiales de Meta (Facebook e
            Instagram) y visualiza todas las métricas clave de tus redes sociales, integradas en un solo tablero de
            Power BI.
          </p>
          <p class="entrada">
            Ideal para equipos de marketing, comercial y alta gerencia que necesitan tomar decisiones con datos
            frescos, claros y visuales.
          </p>
        </header>

        <div class="smb-metricas">
          <h3 class="prod-subtitulo">Lo que llega a tu tablero</h3>
          <dl class="smb-metricas__lista">
            {METRICAS.map((m) => (
              <div>
                <dt>{m.grupo}</dt>
                <dd>{m.lista.join(' · ')}</dd>
              </div>
            ))}
          </dl>
          <p class="smb-nota">Cada red entrega sus propias métricas: no todas existen en todas las plataformas.</p>
        </div>
      </div>

      <figure class="smb-flujo">
        <figcaption class="solo-lectores">Cómo llegan tus datos al tablero, de tus cuentas a tu equipo.</figcaption>
        <ol class="smb-flujo__etapas" role="list">
          <li class="smb-etapa">
            <span class="smb-etapa__nodo"><Icono nombre="redes" /></span>
            <div class="smb-etapa__cuerpo">
              <h3 class="smb-etapa__titulo">Tus cuentas</h3>
              <ul class="smb-redes" role="list">
                <li class="smb-red smb-red--nucleo"><Icono nombre="facebook" />Facebook</li>
                <li class="smb-red smb-red--nucleo"><Icono nombre="instagram" />Instagram</li>
                <li class="smb-red"><Icono nombre="youtube" />YouTube</li>
                <li class="smb-red"><Icono nombre="tiktok" />TikTok</li>
              </ul>
              <p class="smb-etapa__texto">Meta es el núcleo. También YouTube y TikTok.</p>
            </div>
          </li>
          <li class="smb-etapa">
            <span class="smb-etapa__nodo"><Icono nombre="tableros" /></span>
            <div class="smb-etapa__cuerpo">
              <h3 class="smb-etapa__titulo">Un solo tablero de Power BI</h3>
              <p class="smb-etapa__texto">Leído por las APIs oficiales, solo en lectura. Con todo el histórico de tus cuentas y actualizaciones automáticas programadas.</p>
            </div>
          </li>
          <li class="smb-etapa">
            <span class="smb-etapa__nodo"><Icono nombre="usuarios" /></span>
            <div class="smb-etapa__cuerpo">
              <h3 class="smb-etapa__titulo">Tu equipo</h3>
              <ul class="smb-redes" role="list">
                <li class="smb-red"><Icono nombre="portal" />Portal BI, con login</li>
                <li class="smb-red"><Icono nombre="globo" />Tu sitio web, por iframe</li>
              </ul>
            </div>
          </li>
        </ol>
      </figure>
    </div>
  </section>

  <!-- ═════════ EL TABLERO ═════════ -->
  <section class="seccion prod-seccion" id="tablero" data-tema="blanco" aria-labelledby="tablero-titulo">
    <div class="contenedor">
      <header class="prod-cabecera">
        <h2 id="tablero-titulo" class="titulo-seccion">Así se ve tu tablero.</h2>
        <p class="entrada">
          El lunes abres un solo tablero: filtras por plataforma, comparas contra el período anterior y encuentras
          la publicación que mejor funcionó.
        </p>
      </header>

      <div class="prod-bloque">
        <Ventana
          url="portal.tuempresa.com/tableros/redes"
          descripcion="Maqueta completa del tablero de Social Metrics BI con datos de ejemplo: filtros por plataforma, cuatro indicadores con su variación contra el período anterior, alcance por semana, interacciones por plataforma, publicaciones destacadas y pestañas del informe."
        >
          <MaquetaTablero variante="completa" />
        </Ventana>
        <p class="smb-nota smb-nota--pie">
          Maqueta con datos de ejemplo. Tu tablero muestra los datos de tus propias cuentas.
        </p>
        <p class="smb-siguiente">
          ¿Lo quieres con tus propios números?
          <a class="enlace" href={contratar} target="_blank" rel="noopener noreferrer">Contrata tu tablero de redes</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ═════════ QUÉ INCLUYE: las ocho características del dueño ═════════ -->
  <section class="seccion prod-seccion" id="incluye" data-tema="petroleo" aria-labelledby="incluye-titulo">
    <div class="contenedor prod-par prod-par--inicio">
      <header class="prod-cabecera">
        <h2 id="incluye-titulo" class="titulo-seccion">Lo que incluye tu Social Metrics BI.</h2>
        <p class="entrada">
          Todo lo que necesitas para medir tus redes y compartir los resultados con tu equipo, en un solo lugar.
        </p>
      </header>
      <ul class="prod-lista prod-lista--grande" role="list">
        {INCLUYE.map((c) => (
          <li>
            <Icono nombre="check" />
            <span><strong>{c.fuerte}</strong> {c.resto}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═════════ ACCESO: login en el Portal BI o incrustado en tu sitio ═════════ -->
  <section class="seccion prod-seccion" id="acceso" data-tema="claro" aria-labelledby="acceso-titulo">
    <div class="contenedor">
      <header class="prod-cabecera">
        <h2 id="acceso-titulo" class="titulo-seccion">Tu equipo lo abre con su usuario, o dentro de tu sitio.</h2>
        <p class="entrada">
          Dos formas de abrir el mismo tablero, sin que nadie tenga que entrar a las redes. En las dos, los datos se
          actualizan solos.
        </p>
      </header>

      <div class="smb-accesos">
        <div class="smb-acceso">
          <Ventana
            url="portal.tuempresa.com"
            variante="mini"
            descripcion="Maqueta de la pantalla de inicio de sesión del Portal BI: usuario, contraseña y botón para entrar."
          >
            <div class="smb-login">
              <div class="smb-login__caja">
                <span class="smb-login__marca"><span class="smb-login__cuadro"></span>PORTAL BI</span>
                <p class="smb-login__titulo">Inicia sesión</p>
                <span class="smb-login__campo"><span>Usuario</span>mariana.s</span>
                <span class="smb-login__campo"><span>Contraseña</span>········</span>
                <span class="smb-login__boton">Entrar</span>
              </div>
            </div>
          </Ventana>
          <h3 class="prod-subtitulo">Con login en el Portal BI</h3>
          <p class="prod-subtexto">
            Cada persona entra con su usuario y su contraseña a nuestro Portal BI y encuentra el tablero listo. Tus
            datos quedan protegidos detrás del inicio de sesión.
          </p>
          <a class="enlace smb-acceso__enlace" href="/portal-bi/">Conoce el Portal BI</a>
        </div>

        <div class="smb-acceso">
          <Ventana
            url="www.tuempresa.com/resultados"
            variante="mini"
            descripcion="Maqueta de un sitio web con el tablero de Social Metrics BI incrustado en una de sus páginas."
          >
            <div class="smb-sitio">
              <div class="smb-sitio__nav">
                <span class="smb-sitio__logo">tuempresa</span>
                <span class="smb-sitio__links"><i></i><i></i><i></i></span>
              </div>
              <p class="smb-sitio__titulo">Resultados en redes</p>
              <div class="smb-sitio__marco">
                <span class="smb-sitio__etiqueta">iframe</span>
                <div class="smb-sitio__kpis">
                  <span><b>1,28&nbsp;M</b>Alcance</span>
                  <span><b>86,4&nbsp;mil</b>Interacciones</span>
                  <span><b>5.920</b>Seguidores</span>
                </div>
                <div class="smb-sitio__barras">
                  <i class="smb-sitio__b1"></i><i class="smb-sitio__b2"></i><i class="smb-sitio__b3"></i><i class="smb-sitio__b4"></i><i class="smb-sitio__b5"></i><i class="smb-sitio__b6"></i><i class="smb-sitio__b7"></i><i class="smb-sitio__b8"></i>
                </div>
              </div>
            </div>
          </Ventana>
          <h3 class="prod-subtitulo">Incrustado en tu sitio web</h3>
          <p class="prod-subtexto">
            El tablero se abre dentro de una página de tu sitio, en modalidad iframe. Quien lo consulta no tiene que
            salir de tu web ni entrar a otra plataforma.
          </p>
        </div>
      </div>

      <p class="smb-actualiza">
        <Icono nombre="reloj" />
        <span><strong>Actualizaciones automáticas programadas.</strong> Nadie exporta ni carga archivos: el tablero
          se refresca solo.</span>
      </p>
    </div>
  </section>

  <!-- ═════════ IMPLEMENTACIÓN: la secuencia importa, por eso va en pasos ═════════ -->
  <section class="seccion prod-seccion" id="implementacion" data-tema="blanco" aria-labelledby="implementacion-titulo">
    <div class="contenedor">
      <header class="prod-cabecera">
        <h2 id="implementacion-titulo" class="titulo-seccion">Lo ponemos en marcha contigo, a distancia.</h2>
        <p class="entrada">
          Tú autorizas tus cuentas con el acceso oficial de cada red. La infraestructura del servicio y el alta de
          tu equipo las coordinamos contigo en reuniones. Todo 100&nbsp;% remoto, desde cualquier país.
        </p>
      </header>
      <ol class="prod-pasos" role="list">
