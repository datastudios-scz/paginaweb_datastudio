---
/**
 * El anuncio «A tu Power BI le faltan 3 cosas» (ADR-022). Página OCULTA, dentro de /anuncios/:
 * sin indexar y fuera del sitemap (src/data/ocultas.mjs).
 *
 * La sala es la misma herramienta que /portal-bi/anuncio/ (ADR-016): el formato, los controles,
 * el lienzo y el panel de descargas. Los MP4 los graba la Action «Grabar el anuncio 3 cosas» y
 * quedan en el release `anuncio-tres-cosas`; los botones enlazan ahí.
 */
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import AnuncioTresCosas from '../../components/anuncio/AnuncioTresCosas.astro';
import { FORMATOS, videoTresCosas, portadaTresCosas } from '../../data/anuncios';
import '../../components/anuncio/anuncio.css';
import '../../components/anuncio/anuncio-3c.css';

/* El banco comprueba que esto coincida con el reloj (--duracion en anuncio-3c.css) */
const SEGUNDOS = 24;
---

<Base
  titulo="Anuncio «A tu Power BI le faltan 3 cosas» · Data Studio"
  descripcion={`Anuncio de ${SEGUNDOS} segundos del Portal BI para redes sociales.`}
  imagen="/og/portal-bi.png"
  inmersiva
  indexar={false}
>
  <div class="an" data-a="raiz">
    <header class="an-barra">
      <a class="an-barra__volver" href="/anuncios/" aria-label="Volver a los anuncios">
        <Icono nombre="anterior" />
        <span>Anuncios</span>
      </a>
      <h1 class="an-barra__nombre">A tu Power BI le faltan 3 cosas · {SEGUNDOS} s</h1>
      <div class="an-formatos" role="group" aria-label="Formato del video">
        {FORMATOS.map((f) => (
          <button type="button" class="an-formato" data-formato-boton={f.id} aria-pressed={f.id === '9x16' ? 'true' : 'false'} title={f.uso}>
            {f.nombre}
          </button>
        ))}
      </div>
      <div class="an-controles">
        <button type="button" class="an-control" data-a="pausa" aria-label="Pausar" title="Pausar (espacio)">
          <span class="an-control__pausar"><Icono nombre="pausa" /></span>
          <span class="an-control__seguir"><Icono nombre="reproducir" /></span>
        </button>
        <button type="button" class="an-control" data-a="reiniciar" aria-label="Desde el principio" title="Desde el principio">
          <Icono nombre="reiniciar" />
        </button>
        <button type="button" class="an-control" data-a="completa" aria-label="Pantalla completa" title="Pantalla completa (para grabarlo)">
          <Icono nombre="expandir" />
        </button>
      </div>
    </header>

    <div class="an-sala">
      <div class="an-marco">
        <AnuncioTresCosas />
      </div>

      <aside class="an-panel" aria-labelledby="an-panel-titulo">
        <h2 id="an-panel-titulo">Descargar el video</h2>
        <p>MP4 de 60 cuadros por segundo, listo para subir. Uno por formato:</p>
        <ul class="an-descargas">
          {FORMATOS.map((f) => (
            <li>
              <a class="an-descarga" href={videoTresCosas(f.id)} download>
                <span>{f.nombre} · {f.uso}</span>
                <small>{f.px}</small>
              </a>
            </li>
          ))}
        </ul>
        <p>
          Y la portada de cada uno (la lista con sus tres renglones tapados, para elegirla como
          miniatura):
          <a class="enlace" data-a="descarga-actual" data-molde={portadaTresCosas('{f}')} href={portadaTresCosas('9x16')} download>la del formato que estás viendo</a>.
        </p>
        <h2>Cómo medirlo</h2>
        <p>
          Gana si trae más conversaciones de gente que decide (la que toca «Soy gerente o dueño»
          o que pide la demo), no más reacciones.
        </p>
        <h2>Música</h2>
        <p>
          No trae audio: en las redes casi todo se mira sin sonido. Los cortes caen cada medio
          segundo, así que cualquier tema a <strong>120 BPM</strong> calza.
        </p>
        <h2>Grabarlo tú mismo</h2>
        <p>
          Elige el formato, toca pantalla completa y graba la pantalla: el anuncio vuelve a empezar
          solo al terminar. Espacio pausa; las flechas avanzan o retroceden un segundo.
        </p>
      </aside>
    </div>
  </div>

  <script>
    import '../../scripts/anuncio';
  </script>
</Base>
