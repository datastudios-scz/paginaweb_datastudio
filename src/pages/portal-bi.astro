    overflow: hidden;
    border-radius: 24px;
    background: #f3f5f2;
  }

  .pb-telefono__barra {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 22px 15px 13px;
    background: var(--color-abismo);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .pb-telefono__menu {
