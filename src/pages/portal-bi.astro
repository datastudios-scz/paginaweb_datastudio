---
/**
 * Página del Portal BI. Adaptada a la marca Data Studio desde la página de producto
 * preparada en el repositorio del Portal BI (ver docs/contenido.md).
 * Se lee como un informe de BI: reglas finas, cifras tabulares, sin rótulos sobre los títulos.
 * El producto está dibujado en la página: las maquetas reproducen el portal real.
 * Se vende como compra de código + guía de implementación (con curso grabado y chequeo).
 * Estilos genéricos en src/styles/producto.css (prod-*); aquí solo lo propio de esta página.
 */
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Migas from '../components/Migas.astro';
import Ventana from '../components/portal/Ventana.astro';
import MaquetaPortal from '../components/portal/MaquetaPortal.astro';
import MaquetaChat from '../components/portal/MaquetaChat.astro';
import Calculadora from '../components/portal/Calculadora.astro';
import Preguntas, { type Pregunta } from '../components/Preguntas.astro';
import { MENSAJES, PRECIO_LICENCIA_USD, CONTACTO, SITIO, enlaceWhatsApp } from '../data/sitio';
import { dolares, calcularAhorro } from '../scripts/formato';
import { faqPage, migas } from '../scripts/esquemas';
import '../styles/producto.css';

const URL_PAGINA = `${SITIO.url}/portal-bi/`;
const compra = enlaceWhatsApp(MENSAJES.portalCompra);
const demo = enlaceWhatsApp(MENSAJES.portal);
const conMil = calcularAhorro(1000, PRECIO_LICENCIA_USD);

const PREGUNTAS: Pregunta[] = [
  {
    pregunta: '¿Qué compro exactamente?',
    respuesta:
      '<p>El <strong>código del portal</strong> y la <strong>guía de implementación completa</strong>. El código es tuyo: lo instalas en tu servidor o en tu nube, lo personalizas y lo escalas como quieras.</p><p>Con la compra recibes también el <strong>curso grabado</strong>, capítulo por capítulo, y el <strong>chequeo automático</strong> que revisa la instalación punto por punto.</p>',
  },
  {
    pregunta: '¿Mis datos salen de Power BI?',
    respuesta:
      '<p>No. El portal no copia, no replica y no guarda tus datos. Cada vez que alguien abre un tablero, el portal pide un acceso temporal y el reporte se dibuja desde tu propio Power BI. Si mañana apagas el portal, tus datos siguen exactamente donde estaban.</p>',
  },
  {
    pregunta: '¿Quién lo instala? ¿Hay que contratar el servicio?',
    respuesta:
      '<p>Lo instalas tú, con la guía de implementación completa y el curso grabado, paso a paso.</p><p>Lo que suele demorar no es el portal: es que el área de sistemas habilite la aplicación de Azure y agregue la cuenta a los workspaces. Por eso la guía trae esa lista escrita y el portal trae un chequeo que la verifica, para pedir todo junto y una sola vez.</p>',
  },
  {
    pregunta: '¿Cómo hace para que no necesiten licencia?',
    respuesta:
      '<p>Usa el mecanismo de inserción que Power BI provee: el portal se autentica con la cuenta que publica y muestra el reporte dentro de tu página. Tus usuarios no entran a Power BI; entran a tu portal.</p><p>Para el encuadre de licenciamiento de tu caso, tu representante de Microsoft es la fuente. Nosotros te explicamos exactamente qué hace el portal, para que esa conversación sea corta.</p>',
  },
  {
    pregunta: 'Atiendo a varias empresas. ¿Se puede?',
    respuesta:
      '<p>Sí, y es uno de los motivos por los que existe. Se configura una conexión por cliente, cada una con su propia cuenta de Power BI. El portal resuelve solo con cuál abrir cada tablero, y una conexión nunca alcanza lo de otra.</p>',
  },
  {
    pregunta: '¿Y si quiero que cada persona vea solo sus filas?',
    respuesta:
      '<p>El portal aplica una <strong>vista personalizada</strong>: la persona abre el tablero y lo encuentra filtrado a lo suyo. Resuelve el caso cotidiano: que cada uno vea su sucursal sin duplicar el reporte.</p><p>Si necesitas aislamiento estricto, con datos que por contrato no pueden cruzarse, eso se resuelve en el modelo de Power BI y te acompañamos a diseñarlo. Preferimos decirlo antes que prometerlo.</p>',
  },
  {
    pregunta: '¿La IA es obligatoria? ¿Quién paga ese consumo?',
    respuesta:
      '<p>No es obligatoria: el portal funciona completo sin ella. El chat se enciende cuando cargas un proveedor y se habilita tablero por tablero.</p><p>Las claves son tuyas, así que el consumo lo controlas tú. Puedes configurar varios proveedores en cadena: si uno se queda sin cuota, el portal pasa al siguiente sin que nadie lo note.</p>',
  },
  {
    pregunta: '¿Qué pasa si mañana quiero dejar de usarlo?',
    respuesta:
      '<p>No pasa nada. Tus reportes, tus modelos y tus datos están en tu Power BI y siguen ahí. El portal es una puerta de entrada, no un depósito: apagarlo no te deja sin nada.</p>',
  },
];

const RASGOS_PORTAL = [
  { titulo: 'Cada uno ve lo suyo', texto: 'Las tarjetas se agrupan por empresa en el menú. Un operador ve una; un gerente regional, las de sus cinco sucursales.' },
  { titulo: 'Vista personalizada', texto: 'Dos personas abren el mismo tablero y lo encuentran filtrado a lo suyo: su sucursal, su cartera, su período. Sin duplicar el reporte.' },
  { titulo: 'Varias empresas a la vez', texto: 'Si atiendes a más de un cliente, cada uno entra con su propia conexión a Power BI. Un portal, varios orígenes, sin mezclar.' },
  { titulo: 'Herramientas y enlaces', texto: 'Además de tableros, cada persona recibe los accesos que usa todos los días. El portal es la puerta única, no una más.' },
  { titulo: 'Queda registrado', texto: 'Quién entró, cuándo y qué abrió. Útil el día que hay que demostrar quién vio qué.' },
  { titulo: 'Se instala una sola vez', texto: 'Después todo se administra desde el panel: usuarios, asignaciones, colores. Nadie vuelve a tocar un archivo.' },
];

const RASGOS_IA = [
  { titulo: 'La consulta queda a la vista', texto: 'Una IA que se equivoca no devuelve un error: devuelve un número creíble. Por eso mostramos el DAX que se ejecutó, para que alguien que conoce el modelo pueda verificarlo antes de decidir.' },
  { titulo: 'Gráficos a pedido', texto: 'Si la respuesta se entiende mejor dibujada, el chat elige la forma que corresponde y la arma. Se copia como imagen para pegarla en un informe.' },
  { titulo: 'Preguntar hablando', texto: 'Un botón de micrófono transcribe lo que dices y envía la pregunta. Pensado para quien está en la calle con el celular en la mano.' },
  { titulo: 'El proveedor lo eliges tú', texto: 'No está casado con ninguno: se configuran varios y si uno se queda sin cuota, salta al siguiente. Las claves son tuyas y el consumo también.' },
  { titulo: 'También sin tablero', texto: 'Puedes asignar solo el modelo de datos: la persona recibe una tarjeta que abre únicamente el chat. Para quien consulta y no analiza.' },
  { titulo: 'Se puede apagar', texto: 'El chat se habilita tablero por tablero. El portal funciona completo sin IA: tableros, asignaciones, marca y auditoría.' },
];

/** Lo que se compra. El primero es el centro de la oferta: el código es del cliente. */
const COMPRA = [
  { icono: 'codigo', titulo: 'El código del portal', texto: 'Es tuyo: lo instalas, lo personalizas y lo escalas como quieras.' },
  { icono: 'guia', titulo: 'La guía de implementación completa', texto: 'Escrita paso a paso, con la lista literal de permisos de Azure y de Power BI que hay que pedirle a sistemas.' },
  { icono: 'ojo', titulo: 'El curso grabado', texto: 'Capítulo por capítulo, con la pantalla a la vista. Se mira al ritmo de cada uno y queda para quien entre después.' },
  { icono: 'check', titulo: 'El chequeo automático de la instalación', texto: 'Revisa la planilla, la conexión, los permisos y las claves, y te dice qué falta. Se corre las veces que quieras.' },
] as const;

const PASOS_INSTALACION = [
  { hora: '0:00', titulo: 'Levantas el portal', texto: 'Copias el archivo de configuración y pegas el ID de la planilla. El servidor arranca y te avisa a qué hora arrancó.' },
  { hora: '0:20', titulo: 'Conectas Power BI', texto: 'Cargas la conexión desde el panel. El portal la prueba al guardar: si algo falta, lo dice ahí mismo y con nombre propio.' },
  { hora: '1:00', titulo: 'Cargas personas y asignas', texto: 'Usuarios, empresas y tableros desde el panel. El constructor de vistas recorre tu modelo y arma el filtro solo.' },
  { hora: '1:45', titulo: 'Verificas y publicas', texto: 'Un comando revisa la instalación entera y enumera lo que falte. Cuando todo está en verde, abres el portal a tu equipo.' },
];

const REQUISITOS = [
  { icono: 'llave', titulo: 'Una cuenta de Power BI Pro.', texto: 'La que ya publica tus reportes. Una sola, no una por usuario.' },
  { icono: 'candado', titulo: 'Una aplicación registrada en Azure.', texto: 'Diez minutos en Entra ID. El portal la usa para pedir el acceso temporal.' },
  { icono: 'tableros', titulo: 'Una planilla de Google.', texto: 'Ahí viven los usuarios y las asignaciones. Se administra desde el panel, pero puedes abrirla y verla.' },
  { icono: 'infraestructura', titulo: 'Un lugar donde correrlo.', texto: 'Un servidor pequeño alcanza. También corre en la nube, con HTTPS.' },
] as const;

const LIMITES = [
  { titulo: 'Reemplaza a Power BI', texto: 'No diseña reportes: los publica. Sigues modelando en Power BI Desktop como hasta hoy, y el portal reparte lo que ya hiciste.' },
  { titulo: 'Aísla datos por contrato', texto: 'La vista personalizada es de presentación, no de seguridad. Si tienes datos que por contrato no pueden cruzarse, eso se resuelve en el modelo de Power BI, y te acompañamos a diseñarlo.' },
  { titulo: 'Guarda tus datos', texto: 'No copia, no replica, no almacena. Cada tablero se dibuja contra tu propio Power BI en el momento. Si apagas el portal, no pierdes nada.' },
  { titulo: 'Inventa respuestas', texto: 'El chat consulta tu modelo y te muestra la consulta que ejecutó. Si el dato no está en el modelo, no lo adivina: te dice que no está.' },
];

const SERVICIO = {
  '@type': 'Service',
  '@id': `${URL_PAGINA}#servicio`,
  name: 'Portal BI',
  serviceType: 'Portal de Power BI con marca propia',
  description:
    'Código del portal y guía de implementación para compartir tableros de Power BI con toda la empresa usando una sola licencia, con marca propia y chat con IA sobre el modelo. Incluye curso grabado y chequeo automático de la instalación.',
  provider: { '@id': `${SITIO.url}/#organizacion` },
  areaServed: 'Worldwide',
  url: URL_PAGINA,
};
---

<Base
  titulo="Portal BI | Power BI para toda la empresa con una sola licencia · Data Studio"
  descripcion="Portal con tu marca para abrir Power BI a toda la empresa con una sola licencia y chat con IA. Compras el código y la guía, y lo instalas tú."
  imagen="/og/portal-bi.png"
  imagenAlt="Portal BI de Data Studio: Power BI para toda la empresa con una sola licencia"
  datosEstructurados={[
    migas([
      { nombre: 'Inicio', url: `${SITIO.url}/` },
      { nombre: 'Portal BI', url: URL_PAGINA },
    ]),
    SERVICIO,
    faqPage(PREGUNTAS, URL_PAGINA),
  ]}
>
  <!-- ═════════ HÉROE: a la izquierda el argumento, a la derecha el producto ═════════ -->
  <section class="prod-heroe" data-tema="oscuro" aria-labelledby="pb-titulo">
    <div class="contenedor">
      <Migas actual="Portal BI" solucion="portal-bi" />

      <div class="prod-heroe__rejilla">
        <div class="prod-heroe__texto">
          <h1 id="pb-titulo" class="prod-heroe__titulo">
            Power BI para toda la empresa. <span class="prod-acento">Una sola licencia.</span>
          </h1>
          <p class="prod-heroe__bajada">
            Cada persona entra con su usuario y encuentra sus tableros, sin cuenta de Power BI ni una licencia por
            cabeza. Y puede preguntarle a los datos en español.
          </p>
          <div class="prod-ancla pb-ancla">
            <p>
              Darle Power BI Pro a 1.000 personas cuesta <b><span class="dato">{dolares(conMil.conLicencias)}</span> por año</b>.
              Con el portal, la licencia la necesita una sola cuenta: la que publica.
            </p>
            <a class="enlace pb-ancla__enlace" href="#ahorro">
              <span>Calcula lo que ahorras</span>
              <Icono nombre="flecha" />
            </a>
          </div>
          <div class="acciones">
            <a class="boton boton--primario" href={compra} target="_blank" rel="noopener noreferrer">
              <Icono nombre="whatsapp" />
              <span>Comprar código + guía</span>
            </a>
            <a class="boton boton--secundario" href={demo} target="_blank" rel="noopener noreferrer">
              <span>Pide una demo · 30 min</span>
            </a>
          </div>
          <ul class="prod-sellos" role="list">
            <li><Icono nombre="check" />Compras el código</li>
            <li><Icono nombre="check" />Tus datos no se mueven</li>
            <li><Icono nombre="check" />Con tu marca</li>
            <li><Icono nombre="check" />Funciona en el celular</li>
          </ul>
        </div>

        <div class="pb-heroe__visual">
          <Ventana
            url="portal.tuempresa.com/tableros"
            descripcion="Maqueta del Portal BI: menú lateral con tableros agrupados por área, modelos semánticos y herramientas, y tarjetas de tableros de Power BI."
          >
            <MaquetaPortal />
          </Ventana>
        </div>
      </div>

      <nav class="prod-indice" aria-label="En esta página">
        <span class="prod-indice__rotulo" aria-hidden="true">En esta página</span>
        <a href="#portal">El portal</a>
        <a href="#chat">Chat con IA</a>
        <a href="#compra">Qué compras</a>
        <a href="#instalar">Instalación</a>
        <a href="#ahorro">Lo que ahorras</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
    </div>
  </section>

  <!-- ═════════ FRANJA DE HECHOS ═════════ -->
  <div class="prod-franja" data-tema="salvia">
    <div class="contenedor prod-franja__rejilla">
      <div class="prod-hecho">
        <p class="prod-hecho__cifra">1 licencia</p>
        <p class="prod-hecho__texto">La cuenta de Power BI Pro que ya publica tus reportes. No hace falta otra.</p>
      </div>
      <div class="prod-hecho">
        <p class="prod-hecho__cifra">+1.000 personas</p>
        <p class="prod-hecho__texto">Entran con su usuario del portal. Ninguna necesita cuenta de Power BI.</p>
      </div>
      <div class="prod-hecho">
        <p class="prod-hecho__cifra">Código + guía</p>
        <p class="prod-hecho__texto">Compras el código y la guía, y lo instalas tú siguiendo el curso grabado.</p>
      </div>
    </div>
  </div>

  <!-- ═════════ EN QUÉ AYUDA ═════════ -->
  <section class="seccion prod-seccion" data-tema="claro" aria-labelledby="ayuda-titulo">
    <div class="contenedor">
      <header class="prod-cabecera">
        <h2 id="ayuda-titulo" class="titulo-seccion">El reporte deja de pasar por ti.</h2>
        <p class="entrada">
          La mayoría de las personas que necesitan mirar un número no necesitan construir nada. Pero hoy, para
          mirarlo, tienen que pedírselo a alguien.
        </p>
      </header>
      <div class="prod-antes-despues">
        <div class="prod-ad prod-ad--antes">
          <h3>Como viene siendo</h3>
          <ul role="list">
            <li><Icono nombre="cerrar" />El supervisor pide el reporte por WhatsApp, un lunes a las 8.</li>
            <li><Icono nombre="cerrar" />Alguien exporta a Excel, lo recorta y lo envía por correo.</li>
            <li><Icono nombre="cerrar" />A media mañana circulan tres versiones del mismo archivo.</li>
            <li><Icono nombre="cerrar" />Comprar licencias para todos sale más caro que el proyecto entero.</li>
          </ul>
        </div>
        <div class="prod-ad prod-ad--despues">
          <h3>Con el portal</h3>
          <ul role="list">
            <li><Icono nombre="check" />Cada persona entra con su usuario y el tablero ya está, actualizado.</li>
            <li><Icono nombre="check" />Ve solo lo suyo: su empresa, su sucursal, su cartera.</li>
            <li><Icono nombre="check" />Si le falta un dato, se lo pregunta al chat y lo tiene.</li>
            <li><Icono nombre="check" />Una sola licencia publica para todos los que miran.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════ EL PORTAL ═════════ -->
  <section class="seccion prod-seccion" id="portal" data-tema="blanco" aria-labelledby="portal-titulo">
    <div class="contenedor">
      <header class="prod-cabecera">
        <h2 id="portal-titulo" class="titulo-seccion">Tus tableros de Power BI, con tu marca.</h2>
        <p class="entrada">
          El reporte que se abre es el tuyo, completo e interactivo: los mismos filtros, los mismos gráficos, el
          mismo detalle al hacer clic. Lo que cambia es quién puede abrirlo y cómo le llega.
        </p>
      </header>

      <ul class="prod-rasgos" role="list">
        {RASGOS_PORTAL.map((r) => (
          <li class="prod-rasgo">
            <span class="prod-rasgo__marca" aria-hidden="true"></span>
            <h3>{r.titulo}</h3>
            <p>{r.texto}</p>
          </li>
        ))}
      </ul>

      <div class="prod-bloque">
        <h3 class="prod-subtitulo">El mismo portal, tu identidad</h3>
        <p class="prod-subtexto">
          Nombre, logo, colores, tipografía y hasta el ícono de la pestaña salen de la configuración. Se cambian
          desde el panel, sin tocar código y sin reiniciar. Estas dos pantallas son la misma instalación del
          portal.
        </p>
        <div class="pb-dos-marcas">
          <div>
            <Ventana url="bi.acme.com" marca="acme" variante="mini" descripcion="El Portal BI con la marca de ejemplo ACME: menú negro y acento verde.">
              <MaquetaPortal
                variante="mini"
                marca="ACME"
                inicial="A"
                tarjetas={[{ titulo: 'Ventas' }, { titulo: 'Metas' }, { titulo: 'Cartera' }]}
              />
            </Ventana>
            <p class="pb-pie-marca">Instalación A</p>
          </div>
          <div>
            <Ventana url="datos.nordex.com" marca="nordex" variante="mini" descripcion="El mismo Portal BI con la marca de ejemplo NORDEX: menú azul marino y acento ámbar.">
              <MaquetaPortal
                variante="mini"
                marca="NORDEX"
                seccion="Logística"
                inicial="N"
                tarjetas={[{ titulo: 'Rutas' }, { titulo: 'Flota' }, { titulo: 'Costos' }]}
              />
            </Ventana>
            <p class="pb-pie-marca">Instalación B</p>
          </div>
        </div>
      </div>

      <div class="prod-bloque prod-par">
        <div>
          <h3 class="prod-subtitulo">En el celular, como una app</h3>
          <p class="prod-subtexto">
            Se agrega a la pantalla de inicio y abre sin el navegador a la vista. El menú se colapsa al riel de
            íconos, las tarjetas se apilan y el tablero entra completo: el mismo detalle, para quien está en la
            calle y necesita el número ahora.
          </p>
          <ul class="prod-lista" role="list">
            <li><Icono nombre="chat" /><span>El chat con IA funciona igual, y el <strong>micrófono</strong> le sirve a quien tiene las manos ocupadas.</span></li>
            <li><Icono nombre="check" /><span>No hay que instalar nada desde una tienda de aplicaciones ni pedirle permiso a nadie.</span></li>
            <li><Icono nombre="usuarios" /><span>Si la persona cambia de teléfono, entra con su usuario y ya está todo.</span></li>
          </ul>
        </div>
        <figure class="pb-telefono">
          <figcaption class="solo-lectores">Maqueta del Portal BI en un celular: tarjetas de tableros apiladas.</figcaption>
          <div class="pb-telefono__cuerpo" aria-hidden="true">
            <div class="pb-telefono__pantalla">
              <div class="pb-telefono__barra"><span class="pb-telefono__menu"></span>Comercial</div>
              <div class="pb-telefono__tarjetas">
                {['Ventas por sucursal', 'Cumplimiento de metas', 'Cartera y cobranzas'].map((t) => (
                  <div class="pb-telefono__tarjeta">
                    <svg viewBox="0 0 41.5 41.5"><path d="M0.5,12.6h8.7V41H0.5V12.6z M16.7,0.5h8.1V41h-8.1V0.5z M32.9,23.7H41V41h-8.1V23.7z" /></svg>
                    <span>{t}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- ═════════ CHAT CON IA: banda oscura, es lo más diferencial ═════════ -->
  <section class="seccion pb-chat" id="chat" data-tema="oscuro" aria-labelledby="chat-titulo">
    <div class="contenedor">
      <header class="prod-cabecera">
        <h2 id="chat-titulo" class="titulo-seccion">
          Pregunta en español. <span class="prod-acento">Mira la consulta.</span>
        </h2>
        <p class="entrada">
          Al lado del tablero hay un chat que conoce tu modelo: sus tablas, sus columnas y sus medidas. Escribes
          como se lo pedirías a un analista, y responde con los datos reales, no con un resumen inventado.
        </p>
      </header>

      <!-- data-revelar con significado: dispara la secuencia de la maqueta (pasos, mapa de calor, línea) -->
      <div class="prod-bloque" data-revelar>
        <Ventana
          url="portal.tuempresa.com/tableros/chat?nombre=Ventas"
          descripcion="Maqueta del chat con IA del Portal BI: una pregunta sobre ventas por vendedor, los pasos de la consulta, el código DAX ejecutado, un mapa de calor y un gráfico de líneas con datos de ejemplo."
        >
          <MaquetaChat />
        </Ventana>
      </div>

      <ul class="prod-rasgos" role="list">
        {RASGOS_IA.map((r) => (
          <li class="prod-rasgo">
            <span class="prod-rasgo__marca" aria-hidden="true"></span>
            <h3>{r.titulo}</h3>
            <p>{r.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═════════ ADMINISTRACIÓN ═════════ -->
  <section class="seccion prod-seccion" id="admin" data-tema="claro" aria-labelledby="admin-titulo">
    <div class="contenedor">
      <header class="prod-cabecera">
        <h2 id="admin-titulo" class="titulo-seccion">Sumar a alguien es una fila.</h2>
        <p class="entrada">
          Todo se administra desde el panel: usuarios, asignaciones, conexiones a Power BI, colores y logos. Sin
          tocar código y sin reiniciar nada.
        </p>
      </header>

      <div class="prod-bloque">
        <Ventana
          url="portal.tuempresa.com/admin/asignaciones"
