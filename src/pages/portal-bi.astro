<style>
  /* Solo lo propio de esta página. Lo genérico vive en src/styles/producto.css (prod-*). */

  /* ── Héroe: enlace a la calculadora dentro del dato de anclaje ──────── */
  .pb-ancla {
    display: grid;
    gap: var(--space-1);
    padding-bottom: var(--space-2);
  }

  .pb-ancla__enlace {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    min-height: 2.75rem;
  }

  .pb-ancla__enlace :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .pb-ancla__enlace:hover :global(svg) {
    transform: translateX(3px);
  }

  .pb-heroe__visual {
    min-width: 0;
  }

  /* Acción principal + la otra vía (contratar la implementación) como enlace de texto */
  .pb-heroe__cta {
    display: grid;
    gap: var(--space-2);
  }

  .pb-alterna {
    font-size: var(--text-sm);
    color: var(--texto-2);
  }

  .pb-alterna a,
  .pb-caminos__demo a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  /* Objetivo táctil de 44 px en el índice de la página */
  .prod-indice a {
    min-height: 2.75rem;
  }

  /* ── Cualidades: la lista arranca alineada con el subtítulo ─────────── */
  .pb-cualidades {
    margin-top: 0;
  }

  /* ── Marca blanca ──────────────────────────────────────────────────── */
  .pb-dos-marcas {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .pb-pie-marca {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--texto-3);
  }

  /* ── Teléfono: el bisel es el fondo del cuerpo, la pantalla va adentro ── */
  .pb-telefono {
    margin: 0;
    justify-self: center;
  }

  .pb-telefono__cuerpo {
    width: 15.75rem;
    max-width: 100%;
    padding: 10px;
    border-radius: 34px;
