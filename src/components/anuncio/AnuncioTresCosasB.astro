---
/**
 * «A tu Power BI le faltan 3 cosas», versión cinemática (/anuncios/tres-cosas-b/): 24 s (ADR-022).
 *
 * El mismo guion que la versión A (AnuncioTresCosas.astro) —las mismas tres cosas, los mismos
 * titulares, el mismo cierre— con otro nivel de movimiento, para que el dueño elija cuál sale:
 *  · el gancho: un tablero de Power BI flotando en 3D con tres huecos numerados (lo que falta);
 *  · 1 · Ahorro: mil licencias, de a una, en una grilla que implota en una sola licencia dorada,
 *    y alrededor mil personas que se encienden en anillos (un lienzo, efectos-3c.ts);
 *  · 2 · Control total: un nodo «Tú» con un cable de luz a cada persona; con cada cambio un pulso
 *    viaja por el cable, y la ventana vista por esa persona;
 *  · 3 · Lo mejor de todo: una revelación (estrella, rayos y onda) y el chat con su aura, la cuenta
 *    del dato hasta +18,4 % y sus chispas;
 *  · Ahora sí: el tablero del gancho otra vez, y las tres piezas vuelan y encajan en sus huecos;
 *  · los cambios de toma con un barrido de luz, y chispas de fondo en todo el anuncio.
 *
 * Reusa los estilos de la versión A (anuncio-3c.css: el paso, el chip de IA, el chat, las
 * personas, el cierre) y agrega lo propio en anuncio-3c-b.css. Lo que se dibuja según el tiempo
 * (las partículas) va en src/scripts/efectos-3c.ts, que el motor llama en cada cuadro: el mismo
 * instante da siempre el mismo cuadro, como el resto del anuncio.
 *
 * Las mismas reglas que la versión A: dice qué ve cada persona, nunca que los datos queden
 * aislados; sin precios; español neutro.
 */
import AnuncioReporte from './AnuncioReporte.astro';
import AnuncioTableroHuecos from './AnuncioTableroHuecos.astro';
import { PBI } from './datos';
import { CONTACTO } from '../../data/sitio';
import { LOGO_BARRAS, LOGO_WORDMARK } from '../../data/logo';

const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const frase = (...partes: (string | [string, string])[]) => {
  let k = 0;
  const palabra = (w: string) => `<span class="an-p w${k++}"><span>${esc(w)}</span></span>`;
  return partes
    .map((p) => (typeof p === 'string' ? p.split(' ').map(palabra).join(' ') : `<span class="${p[1]}">${p[0].split(' ').map(palabra).join(' ')}</span>`))
    .join(' ');
};

const TILDE = 'M5 12.5 10 17.5 19 7';
const ARCO = 'M8 10.5V8a4 4 0 0 1 8 0v2.5';
const OJO = 'M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z';
const EMBUDO = 'M3.5 4.5h17l-6.5 7.7v6.1l-4 2.2v-8.3Z';
const CONTROLES = 'M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1M15 4v4M9 10v4M17 16v4';
const DESTELLO = 'M12 2l1.9 5.6L19.5 9l-5.6 1.9L12 16.5l-1.9-5.6L4.5 9l5.6-1.4z';
const CHISPA = 'M12 0C12.7 6.7 17.3 11.3 24 12 17.3 12.7 12.7 17.3 12 24 11.3 17.3 6.7 12.7 0 12 6.7 11.3 11.3 6.7 12 0Z';

const QUIEN = [
  { id: 1, inicial: 'G', nombre: 'Gerencia' },
  { id: 2, inicial: 'V', nombre: 'Ventas' },
  { id: 3, inicial: 'C', nombre: 'Cliente' },
];

/* Los cables del nodo «Tú» a cada persona (viewBox 0 0 600 120): salen del centro de arriba y
   llegan al centro de cada columna (100, 300 y 500) */
const CABLES = ['M300 0C300 70 100 50 100 120', 'M300 0V120', 'M300 0C300 70 500 50 500 120'];

/* Las chispas del dato: ocho, en círculo */
const CHISPAS = [0, 1, 2, 3, 4, 5, 6, 7];

const PREGUNTA = '¿Qué sucursal creció más?';
---

<div class="an-lienzo an-lienzo--tc an-lienzo--tcb" data-a="lienzo" data-formato="9x16" data-movimiento-propio aria-hidden="true">
  <!-- El reloj: una animación lineal de 24 s que el script lee para saber en qué segundo va -->
  <i class="an-reloj" data-a="reloj"></i>

  <!-- Fondo vivo y, encima, las chispas que dibuja efectos-3c.ts (debajo de las tomas) -->
  <div class="an-fondo"><i></i><i></i></div>
  <canvas class="tcb-chispas" data-fx="chispas"></canvas>

  <!-- ═══ 1 · EL GANCHO (0 – 2,75 s): el tablero flotando, con tres huecos ═══ -->
  <section class="an-escena tcb-s1">
    <div class="an-texto tcb-s1-texto">
      <p class="an-h1 tc-s1-titular">A tu <span class="tc-amarillo">Power BI</span> le faltan <span class="tc-tres tcb-tres">3 cosas.</span></p>
    </div>
    <div class="an-visual tcb-s1-visual">
      <i class="tcb-halo"></i>
      <AnuncioTableroHuecos direccion="app.powerbi.com" />
    </div>
  </section>

  <!-- ═══ 2 · AHORRO (2,4 – 7,1 s): mil licencias que implotan en una ═══
       La grilla de mil, la implosión, el destello y los anillos de gente los dibuja el lienzo
       (efectos-3c.ts, data-fx="mil"). Acá, la cuenta, la licencia que queda, la gente y el sello. -->
  <section class="an-escena tcb-s2">
    <div class="an-texto">
      <span class="tc-paso"><b>1</b>Ahorro</span>
      <p class="an-h1 tc-s2-titulo" set:html={frase('Deja de pagar por cada usuario.')} />
      <p class="an-h3 tcb-s2-sub">1 sola licencia para toda tu empresa.</p>
    </div>
    <div class="an-visual tcb-mil">
      <canvas class="tcb-mil__lienzo" data-fx="mil"></canvas>
      <div class="tcb-cuenta">
        <span class="tcb-cuenta__n">
          <span class="tcb-cuenta__sube" data-a="kpi" data-desde="0" data-hasta="1000" data-en="2.7" data-dur="1.05">0</span>
          <span class="tcb-cuenta__baja" data-a="kpi" data-desde="1000" data-hasta="1" data-en="4.15" data-dur="0.7">1.000</span>
        </span>
        <span class="tcb-cuenta__t">licencias de Power BI, una por persona</span>
      </div>
      <div class="tcb-licencia">
        <span class="tcb-licencia__ico"><svg viewBox="0 0 41.5 41.5"><path d={PBI} /></svg></span>
        <span class="tcb-licencia__t"><b>1 licencia</b><em>de Power BI</em></span>
        <span class="tcb-sello"><svg viewBox="0 0 24 24"><path d={TILDE} /></svg>999 licencias que ya no pagas</span>
      </div>
      <span class="tcb-gente"><svg viewBox="0 0 24 24"><path d={TILDE} /></svg>1.000 personas con acceso</span>
    </div>
  </section>

  <!-- ═══ 3 · CONTROL TOTAL (7 – 12 s): el nodo «Tú», sus cables y la ventana de cada persona ═══ -->
  <section class="an-escena tc-s3 tcb-s3">
    <div class="an-texto">
      <span class="tc-paso"><b>2</b>Control total</span>
      <p class="an-h1 tc-s3-titulo" set:html={frase('Tú decides qué ve cada persona.')} />
      <p class="an-h3 tc-verbos"><span class="tc-verbo tc-verbo--1">Filtra.</span> <span class="tc-verbo tc-verbo--2">Oculta.</span> <span class="tc-verbo tc-verbo--3">Muestra solo lo que debe.</span></p>
    </div>
    <div class="an-visual tc-s3-visual">
      <div class="tcb-red">
        <span class="tcb-tu"><svg viewBox="0 0 24 24"><path d={CONTROLES} /></svg>Tú</span>
        <svg class="tcb-cables" viewBox="0 0 600 120" preserveAspectRatio="none">
          {CABLES.map((d, i) => (
            <>
              <path class={`tcb-cable tcb-cable--${i + 1}`} d={d} pathLength="1" />
              <path class={`tcb-pulso tcb-pulso--${i + 1}`} d={d} pathLength="1" />
            </>
          ))}
        </svg>
        <div class="tc-quien tcb-quien">
          {QUIEN.map((q) => (
            <span class="tcb-quien__col"><span class={`tc-quien__p tc-quien__p--${q.id}`}><i>{q.inicial}</i>{q.nombre}</span></span>
          ))}
        </div>
      </div>
      <div class="tc-estado">
        <span class="tc-estado__e tc-estado__e--1"><svg viewBox="0 0 24 24"><path d={OJO} /><circle cx="12" cy="12" r="3" /></svg>Ve todo</span>
        <span class="tc-estado__e tc-estado__e--2"><svg viewBox="0 0 24 24"><path d={EMBUDO} /></svg>Solo la sucursal Norte</span>
        <span class="tc-estado__e tc-estado__e--3"><svg viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" rx="2" /><path d={ARCO} /></svg>2 páginas ocultas · solo lectura</span>
      </div>
      <div class="an-ui an-ventana tc-s3-ventana">
        <div class="an-ui__in">
          <div class="an-ventana__barra"><i></i><i></i><i></i><span>portal.tuempresa.com/visor</span><em>Datos de ejemplo</em></div>
          <div class="tc-s3-rep">
            <AnuncioReporte />
            <span class="tc-filtro"><svg viewBox="0 0 24 24"><path d={EMBUDO} /></svg>Sucursal: <b>Norte</b></span>
          </div>
          <div class="tc-pestanas">
            <span class="tc-pestana tc-pestana--si">Ventas</span>
            <span class="tc-pestana tc-pestana--2">Margen<svg viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" rx="2" /><path d={ARCO} /></svg></span>
            <span class="tc-pestana tc-pestana--3">Cartera<svg viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" rx="2" /><path d={ARCO} /></svg></span>
            <span class="tc-lectura"><svg viewBox="0 0 24 24"><path d={OJO} /><circle cx="12" cy="12" r="3" /></svg>Solo lectura</span>
          </div>
          <i class="tcb-barre tcb-barre--1"></i>
          <i class="tcb-barre tcb-barre--2"></i>
          <i class="tcb-barre tcb-barre--3"></i>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ LA REVELACIÓN (11,9 – 12,95 s): se apaga todo, y en el centro, la estrella de la IA ═══
       Las chispas que convergen las dibuja el lienzo de fondo (efectos-3c.ts) -->
  <section class="an-escena tcb-revela">
    <i class="tcb-revela__velo"></i>
    <div class="tcb-revela__centro">
      <i class="tcb-rayos"></i>
      <i class="tcb-onda"></i>
      <svg class="tcb-estrella" viewBox="0 0 24 24"><path d={CHISPA} /></svg>
    </div>
    <p class="an-h3 tcb-revela__t">Y lo mejor de todo…</p>
  </section>

  <!-- ═══ 4 · LO MEJOR DE TODO: POTENCIADO POR IA (12,7 – 18,3 s) ═══
       La toma de la IA de la versión A, con su aura, el dato que cuenta y sus chispas -->
  <section class="an-escena tc-s4 tcb-s4">
    <div class="an-texto tc-s4-texto">
      <span class="tc-paso tc-paso--ia"><b>3</b>Lo mejor de todo</span>
      <p class="an-h1 tc-s4-titulo"><span class="an-p w0"><span>Potenciado</span></span> <span class="an-p w1"><span>por</span></span> <span class="tc-chip"><svg class="tc-chip__chispa" viewBox="0 0 24 24"><path d={CHISPA} /></svg>IA</span></p>
    </div>
    <div class="an-visual tc-ia">
      <div class="an-ui an-ventana tc-ia__ventana">
        <i class="tcb-aura"></i>
        <div class="an-ui__in">
          <div class="an-ventana__barra"><i></i><i></i><i></i><span>portal.tuempresa.com/visor</span><em>Datos de ejemplo</em></div>
          <div class="an-s6-escena">
            <div class="an-s6-rep"><AnuncioReporte /></div>
            <span class="an-s6-lengueta"><svg viewBox="0 0 24 24"><path d={DESTELLO} /></svg><b>Chat IA</b></span>
            <i class="an-toque an-s6-toque"></i>
            <div class="an-s6-panel">
              <div class="an-s6-cab">
                <span class="an-s6-cab__ico"><svg viewBox="0 0 24 24"><path d={DESTELLO} /></svg></span>
                <span class="an-s6-cab__id"><b>Ventas por sucursal</b><span>Pregunta sobre los datos de este tablero</span></span>
              </div>
              <div class="an-s6-hilo">
                <div class="tc-ia__hilo">
                  <p class="an-s6-yo">{PREGUNTA}</p>
                  <div class="an-s6-pasos">
                    <span class="an-s6-paso tc-ia-paso--1"><i></i>Leyendo la estructura del modelo</span>
                    <span class="an-s6-paso tc-ia-paso--2"><i></i>Redactando la consulta</span>
                    <span class="an-s6-paso tc-ia-paso--3"><i></i>Consultando Power BI</span>
                  </div>
                  <p class="an-s6-resp"><b>Aeropuerto</b> lidera: <b>+18,4 %</b>, más del doble del promedio.</p>
                  <div class="tc-ia__dato">
                    <span>Aeropuerto · contra 2025</span>
                    <b><span data-a="kpi" data-signo="+" data-desde="0" data-hasta="18.4" data-en="16.25" data-dur="0.8" data-sufijo=" %">+18,4 %</span></b>
                    {CHISPAS.map((k) => <svg class={`tcb-chispa tcb-chispa--${k + 1}`} viewBox="0 0 24 24"><path d={CHISPA} /></svg>)}
                  </div>
                </div>
              </div>
              <div class="an-s6-campo">
                <span class="an-s6-input">
                  <span class="an-s6-ph">Pregunta algo sobre estos datos…</span>
                  <span class="an-s6-txt"><span data-a="tipeo" data-texto={PREGUNTA} data-en="14.7" data-fin="15.3"></span></span>
                  <i class="an-s6-caret"></i>
                </span>
                <span class="an-s6-enviar"><svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7" /></svg></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 5 · AHORA SÍ (18,2 – 20,3 s): el tablero del gancho, y las piezas que encajan ═══ -->
  <section class="an-escena tcb-s5">
    <div class="an-texto">
      <p class="an-h1 tc-s5-titulo" set:html={frase('Ahora sí, no le falta nada.')} />
    </div>
    <div class="an-visual tcb-s5-visual">
      <i class="tcb-halo"></i>
      <AnuncioTableroHuecos direccion="portal.tuempresa.com/visor" piezas />
    </div>
  </section>

  <!-- Las cuatro barras del logo como cortina, para entrar al cierre -->
  <div class="an-barras tc-barras"><i></i><i></i><i></i><i></i></div>

  <!-- ═══ 6 · CIERRE (20,2 s – fin) ═══ -->
  <section class="an-escena tc-s6 tcb-s6">
    <i class="tcb-s6-luz"></i>
    <div class="an-cierre">
      <div class="an-logo">
        <svg class="an-logo__icono" viewBox="0 0 1893 1895">
          <path class="an-logo__pantalla" d="M0 1107V130A130 130 0 0 1 130 0h1633a130 130 0 0 1 130 130v977Z" />
          {LOGO_BARRAS.map((b, i) => (
            <rect class={`an-logo__barra an-logo__barra--${i + 1}`} x={b.x} y={b.y} width="233" height={b.alto} />
          ))}
          <path class="an-logo__pie" d="M0 1181h1893v201a120 120 0 0 1-120 120h-669v153h273a120 120 0 0 1 120 120v120H396v-120a120 120 0 0 1 120-120h273v-153H120A120 120 0 0 1 0 1382ZM596.5 1260h70a41.5 41.5 0 0 1 0 83h-70a41.5 41.5 0 0 1 0-83ZM911.5 1260h70a41.5 41.5 0 0 1 0 83h-70a41.5 41.5 0 0 1 0-83ZM1226.5 1260h70a41.5 41.5 0 0 1 0 83h-70a41.5 41.5 0 0 1 0-83Z" fill-rule="evenodd" />
        </svg>
        <svg class="an-logo__wordmark" viewBox="0 0 4733 484"><path d={LOGO_WORDMARK} /></svg>
      </div>
      <p class="an-h1 an-s9-titulo" set:html={frase('Power BI para toda tu empresa.')} />
      <ul class="an-fichas">
        <li>1 licencia</li>
        <li>Control total</li>
        <li>Potenciado por IA</li>
        <li>El código es tuyo</li>
      </ul>
      <p class="an-cta tcb-cta">
        <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.3-.1.6.2.3.8 1.4 1.8 2.2 1.2 1.1 2.3 1.4 2.6 1.6.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.8-.1 1.4Z" /></svg>
        <span>Pide tu demo: {CONTACTO.telefonoVisible}</span>
      </p>
      <p class="an-url">datastudio.es/portal-bi</p>
    </div>
  </section>

  <!-- Los barridos de luz que cambian de toma -->
  <i class="tcb-barrido tcb-barrido--1"></i>
  <i class="tcb-barrido tcb-barrido--2"></i>
  <i class="tcb-barrido tcb-barrido--3"></i>

  <!-- La firma y el avance, como en la versión A -->
  <div class="an-firma">
    <svg viewBox="0 0 28 28"><rect x="3" y="14" width="5" height="11" rx="1.2" /><rect x="11.5" y="8" width="5" height="17" rx="1.2" /><rect x="20" y="3" width="5" height="22" rx="1.2" /></svg>
    <span>Portal BI</span>
  </div>
  <div class="tc-avance">
    {[1, 2, 3].map((n) => <span class={`tc-avance__p tc-avance__p--${n}`}>{n}</span>)}
  </div>

  <!-- La viñeta: oscurece apenas los bordes, como un lente -->
  <i class="tcb-vineta"></i>
</div>
