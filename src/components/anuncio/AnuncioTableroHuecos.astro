---
/**
 * El tablero de Power BI con tres huecos, de la versión cinemática de «A tu Power BI le faltan 3
 * cosas» (ADR-022). Lo usan dos tomas: el gancho, donde faltan las piezas (los huecos numerados),
 * y «Ahora sí», donde las tres piezas vuelan y encajan. Una sola copia, para que encajen justo
 * donde estaban los huecos.
 *
 * Los huecos tapan las tres zonas del reporte de ejemplo (AnuncioReporte.astro): los indicadores,
 * las barras por sucursal y las líneas por mes. Sus medidas, en --m (1/960 de la ventana).
 */
import AnuncioReporte from './AnuncioReporte.astro';
import { PBI } from './datos';

interface Props {
  /** La dirección de la barra: el Power BI de siempre o el del portal. */
  direccion: string;
  /** Si trae las piezas que encajan (la toma «Ahora sí»). */
  piezas?: boolean;
}

const { direccion, piezas = false } = Astro.props;

const TILDE = 'M5 12.5 10 17.5 19 7';
const CONTROLES = 'M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1M15 4v4M9 10v4M17 16v4';
const CHISPA = 'M12 0C12.7 6.7 17.3 11.3 24 12 17.3 12.7 12.7 17.3 12 24 11.3 17.3 6.7 12.7 0 12 6.7 11.3 11.3 6.7 12 0Z';

const PIEZAS = [
  { n: 1, texto: '1 licencia', ico: 'pbi' },
  { n: 2, texto: 'Control total', ico: 'control' },
  { n: 3, texto: 'IA', ico: 'ia' },
] as const;
---

<div class="an-ui an-ventana tcb-tablero">
  <div class="an-ui__in">
    <div class="an-ventana__barra"><i></i><i></i><i></i><span>{direccion}</span><em>Datos de ejemplo</em></div>
    <AnuncioReporte />
    {PIEZAS.map((p) => (
      <span class={`tcb-hueco tcb-hueco--${p.n}`}><b>{p.n}</b></span>
    ))}
    {piezas &&
      PIEZAS.map((p) => (
        <span class={`tcb-pieza tcb-pieza--${p.n}`}>
          <span class="tcb-pieza__ico">
            {p.ico === 'pbi' && <svg viewBox="0 0 41.5 41.5"><path d={PBI} /></svg>}
            {p.ico === 'control' && <svg class="tcb-pieza__trazo" viewBox="0 0 24 24"><path d={CONTROLES} /></svg>}
            {p.ico === 'ia' && <svg viewBox="0 0 24 24"><path d={CHISPA} /></svg>}
          </span>
          <b>{p.texto}</b>
          <i class="tcb-pieza__ok"><svg viewBox="0 0 24 24"><path d={TILDE} /></svg></i>
        </span>
      ))}
  </div>
</div>
