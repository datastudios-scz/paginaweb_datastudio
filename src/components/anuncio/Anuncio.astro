---
/**
 * El anuncio del Portal BI para redes sociales (/portal-bi/anuncio/): 55 segundos, nueve tomas.
 * Primero fue de 30 s y el dueño lo vio rápido ("no da tiempo de leer"): cada titular queda
 * ahora entre 3 y 4,5 s a la vista. Después pidió que el chat con IA se viera como es —al
 * costado del tablero, con su botón— y con dos preguntas difíciles: es «la bomba» del
 * producto, y la toma 6 creció de 8 a 16,5 s. El 17/10 cambió el gancho (los primeros 10 s,
 * ADR-019): ya no son mil asientos de licencias, que no se entendían, sino una escena que el
 * público vive —«¿Me pasas el reporte?» y los reportes regados— que el portal se traga entera.
 *
 * Todo el movimiento es CSS (@keyframes con su retardo contado desde el segundo 0) y el script
 * (src/scripts/anuncio.ts) lo maneja como una línea de tiempo: puede reproducir, pausar o ir a
 * cualquier instante exacto. Así el mismo anuncio se ve en la página y se graba cuadro por
 * cuadro a MP4 (scripts/grabar-anuncio.mjs) sin perder un solo cuadro.
 *
 * Cada toma declara su ventana (--a: entra, --z: sale) en anuncio.css. Los tamaños van en
 * `--u` (1/1080 del lado corto del lienzo), así que la misma pieza sirve en 9:16, 4:5, 1:1 y
 * 16:9; lo que cambia por formato es dónde va cada bloque.
 *
 * La variante «socio» es el mismo anuncio para quien lo revende (la propuesta a Ribentek,
 * ADR-020): la ráfaga dice lo que hacemos nosotros, una toma más dice lo que le cobramos y el
 * cierre firma «Data Studio × Ribentek». Dura más: el motor toma la duración del reloj.
 *
 * Reglas del sitio que aplican acá: el monto que NO es el precio va tachado en rojo y con
 * palabras ("sin el portal pagarías", ver PRODUCT.md); solo afirmaciones respaldadas; los
 * datos del reporte y del chat son de ejemplo (los mismos de las maquetas).
 */
import AnuncioReporte from './AnuncioReporte.astro';
import AnuncioPortal from './AnuncioPortal.astro';
import { TARJETAS, PBI, VARITA } from './datos';
import { CONTACTO } from '../../data/sitio';
import { LOGO_BARRAS, LOGO_WORDMARK } from '../../data/logo';
import { miles } from '../../scripts/formato';

interface Props {
  /** «publico»: el anuncio para redes. «socio»: el mismo, para quien lo revende. */
  variante?: 'publico' | 'socio';
}

const { variante = 'publico' } = Astro.props;
const socio = variante === 'socio';

const PERSONAS = 1000;

/* Lo que Data Studio le cobra a un socio, por cliente y por mes (lo definió el dueño) */
const PRECIO_SOCIO = 60;

/* La ráfaga: cuatro razones, una por tiempo. Para el socio cuenta lo que hacemos nosotros, que
   es lo que compra: él vende y cobra; nosotros lo instalamos, lo dejamos funcionando y lo
   mantenemos. (El código propio y el «lo instalas tú» son del otro camino de compra.) */
const ICONO = {
  codigo: 'M17 14 7 24l10 10M31 14l10 10-10 10M27 9l-6 30',
  tabla: 'M12 8h24a4 4 0 0 1 4 4v24a4 4 0 0 1-4 4H12a4 4 0 0 1-4-4V12a4 4 0 0 1 4-4ZM8 19h32M8 29h32M19 8v32',
  llave: 'M30 8a10 10 0 0 0-9.6 12.8L8 33.2V40h6.8l12.4-12.4A10 10 0 1 0 30 8Z',
  check: 'M10 25.5 19.5 35 38 14',
  anda: 'M24 6a18 18 0 1 0 0 36 18 18 0 0 0 0-36ZM20.5 16.5v15l12-7.5Z',
  ronda: 'M36.5 18.5A14 14 0 0 0 11.6 15.4M11.5 29.5A14 14 0 0 0 36.4 32.6M11 8.5v7h7M37 39.5v-7h-7',
};
const CORTES = socio
  ? [
      { ico: ICONO.llave, texto: 'Nosotros lo instalamos.' },
      { ico: ICONO.anda, texto: 'Lo dejamos funcionando.' },
      { ico: ICONO.ronda, texto: 'Y lo mantenemos al día.' },
      { ico: ICONO.check, texto: 'Tú vendes y cobras.' },
    ]
  : [
      { ico: ICONO.codigo, texto: 'El código es tuyo.' },
      { ico: ICONO.tabla, texto: 'Excel: tú decides quién descarga.' },
      { ico: ICONO.llave, texto: 'Lo instalas tú o lo instalamos.' },
      { ico: ICONO.check, texto: 'Nunca más una licencia por persona.' },
    ];

/* Un titular partido en palabras con ranura: la animación las sube de a una (w0, w1…). */
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const titular = (texto: string) =>
  texto
    .split(' ')
    .map((w, k) => `<span class="an-p w${k}"><span>${esc(w)}</span></span>`)
    .join(' ');

/* El gancho (ADR-019): lo que le llega suelto a cualquiera que pide reportes. Los archivos ya
   están en el primer cuadro (la miniatura); la gente cae después, una por pulso. El orden de la
   lista es el de encima/debajo: los mensajes y el aviso de la licencia van arriba de los
   archivos, porque son lo que hay que leer. Nombres de archivo de ejemplo, como los de verdad:
   «FINAL_v3», «(2)». */
type Pieza =
  | { id: string; tipo: 'archivo'; ext: 'xls' | 'pdf' | 'pbix'; nombre: string; meta: string }
  | { id: string; tipo: 'correo'; asunto: string; meta: string }
  | { id: string; tipo: 'mensaje'; de: string; texto: string }
  | { id: string; tipo: 'bloqueo' };
const PIEZAS: Pieza[] = [
  { id: 'a', tipo: 'archivo', ext: 'xls', nombre: 'ventas_FINAL_v3.xlsx', meta: 'Adjunto · 2,4 MB' },
  { id: 'd', tipo: 'archivo', ext: 'pdf', nombre: 'cierre_marzo (2).pdf', meta: 'Adjunto · 880 KB' },
  { id: 'g', tipo: 'archivo', ext: 'pbix', nombre: 'tablero_final_FINAL.pbix', meta: 'Power BI Desktop · 38 MB' },
  { id: 'b', tipo: 'correo', asunto: 'RE: RE: RE: Reporte semanal', meta: 'Finanzas · 7:48' },
  { id: 'c', tipo: 'mensaje', de: 'Ventas', texto: '¿Cuál es la versión buena?' },
  { id: 'e', tipo: 'bloqueo' },
  { id: 'f', tipo: 'mensaje', de: 'Operaciones', texto: 'No me abre el tablero' },
];
const EXT = { xls: 'XLS', pdf: 'PDF', pbix: 'PBIX' };

/* Las mil personas de la toma 2: cuatro caras y el resto en un número, como en cualquier app */
const CARAS = ['G', 'V', 'O', 'M'];

/* El ícono de la IA del portal (la lengüeta y el chat) */
const DESTELLO = 'M12 2l1.9 5.6L19.5 9l-5.6 1.9L12 16.5l-1.9-5.6L4.5 9l5.6-1.4z';

/* El lema (ADR-018): el «+», las palabras que suben desde su ranura (como todo titular) y el
   chip de IA en la esquina de «HABLAN», con sus estrellitas. Lo usan la toma 6 y el cierre */
const CHISPA = 'M12 0C12.7 6.7 17.3 11.3 24 12 17.3 12.7 12.7 17.3 12 24 11.3 17.3 6.7 12.7 0 12 6.7 11.3 11.3 6.7 12 0Z';
const chispa = (donde: string) =>
  `<svg class="an-chip-ia__chispa an-chip-ia__chispa--${donde}" viewBox="0 0 24 24"><path d="${CHISPA}" /></svg>`;
const LEMA =
  '<span class="an-lema__mas">+</span>' +
  ['Y', 'ahora', 'tus', 'datos'].map((w, k) => `<span class="an-p w${k}"><span>${w}</span></span>`).join(' ') +
  ' <span class="an-lema__fin"><span class="an-p w4 an-lema__hablan"><span>hablan</span></span>' +
  `<span class="an-chip-ia">${chispa('adentro')}IA${chispa('arriba')}${chispa('abajo')}</span></span>`;

/* El chat al costado del tablero: dos preguntas que el tablero no contesta solo.
   Datos de ejemplo, cuadrados con los del reporte (ADR-013): las siete sucursales crecen, en
   promedio ponderado, el +7,9 % del indicador; Aeropuerto vende 822.300 (6.969 tickets de
   US$ 118) contra 694.510 en 2025 (7.388 tickets de US$ 94): +18,4 %. */
const PREGUNTA_1 = '¿Qué sucursales crecieron más que el promedio contra 2025?';
const PREGUNTA_2 = '¿Y qué explica lo de Aeropuerto?';
const PROMEDIO = 7.9;
const CRECIMIENTO = [
  ['Aeropuerto', 18.4],
  ['Norte', 11.2],
  ['Centro', 9.1],
  ['Plaza Mayor', 5.6],
  ['Costanera', 3.3],
  ['Sur', -3.3],
  ['Parque Industrial', -7.4],
] as const;
const pct = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v).toFixed(1).replace('.', ',')} %`;
/* Las consultas del analista para la segunda, como las muestra el chat: «Consulta n de m» y para qué */
const CONSULTAS = ['ventas de 2025 y 2026', 'tickets de cada año', 'ticket promedio'];
---

<div class:list={['an-lienzo', { 'an-lienzo--socio': socio }]} data-a="lienzo" data-formato="9x16" data-movimiento-propio aria-hidden="true">
  <!-- El reloj: una animación lineal de 55 s que el script lee para saber en qué segundo va -->
  <i class="an-reloj" data-a="reloj"></i>

  <!-- Fondo vivo de las tomas oscuras: dos luces que respiran -->
  <div class="an-fondo"><i></i><i></i></div>

  <!-- ═══ 1 · GANCHO: «¿Me pasas el reporte?» y todo lo que llega suelto ═══
       El primer cuadro ya es el gancho (la miniatura): el pedido de siempre, con sus mensajes
       sin leer, y los reportes regados alrededor. Cada medio segundo llega otro. A los 2,9 s
       el portal se los traga a todos, también el pedido (data-a="absorbe": el script mide
       cuánto viaja cada uno hasta el centro de la ventana). -->
  <section class="an-escena an-s1">
    <div class="an-texto">
      <div class="an-s1-chat" data-a="absorbe">
        <p class="an-s1-de"><i>G</i>Gerencia</p>
        <div class="an-s1-globo">
          <p class="an-h1 an-s1-pregunta">¿Me pasas el reporte?</p>
          <span class="an-s1-aviso"><span data-a="kpi" data-desde="3" data-hasta="27" data-en="0.2" data-dur="2.6">27</span></span>
        </div>
      </div>
    </div>
    <div class="an-visual an-s1-visual">
      {PIEZAS.map((p) => (
        <div class={`an-s1-pieza an-s1-pieza--${p.id}`} data-a="absorbe">
          <div class="an-s1-arco"><div class="an-s1-flota">
            {p.tipo === 'archivo' && (
              <div class="an-s1-carta an-s1-archivo">
                <span class={`an-s1-doc an-s1-doc--${p.ext}`}>{EXT[p.ext]}</span>
                <span class="an-s1-carta__txt"><b>{p.nombre}</b><em>{p.meta}</em></span>
              </div>
            )}
            {p.tipo === 'correo' && (
              <div class="an-s1-carta">
                <span class="an-s1-ico"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m3.5 7 8.5 6 8.5-6" /></svg></span>
                <span class="an-s1-carta__txt"><b>{p.asunto}</b><em>{p.meta}</em></span>
              </div>
            )}
            {p.tipo === 'mensaje' && (
              <div class="an-s1-carta an-s1-msj">
                <span class="an-s1-msj__de">{p.de}</span>
                <span>{p.texto}</span>
              </div>
            )}
            {p.tipo === 'bloqueo' && (
              <div class="an-s1-carta an-s1-bloqueo">
                <span class="an-s1-candado">
                  <svg viewBox="0 0 41.5 41.5"><path d={PBI} /></svg>
                  <i><svg viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" rx="2" /><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" /></svg></i>
                </span>
                <span class="an-s1-carta__txt"><b>Necesitas una licencia de Power BI Pro</b><em>para ver este reporte</em></span>
              </div>
            )}
          </div></div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ 2 · EL PORTAL: todo en un solo lugar, y una licencia para mil ═══
       Lo que se tragó la toma 1 sale ordenado: el portal con los tableros. Después, sobre la
       misma ventana, la cuenta que importa: mil personas, una licencia. -->
  <section class="an-escena an-s2">
    <div class="an-texto">
      <p class="an-h1 an-s2-todos" set:html={titular('Todos tus tableros, en un solo lugar.')} />
      <div class="an-s2-lic">
        <p class="an-h3 an-s2-para">Para {miles(PERSONAS)} personas:</p>
        <p class="an-h2 an-s2-no"><span>{miles(PERSONAS)} licencias</span><i class="an-s2-tacha"></i></p>
        <p class="an-h1 an-s2-una" set:html={titular('1 licencia.')} />
      </div>
    </div>
    <div class="an-visual an-s2-visual">
      <i class="an-s2-halo"></i>
      <i class="an-s2-destello"></i>
      <i class="an-s2-centro" data-a="destino"></i>
      <div class="an-ui an-ventana an-s2-ventana">
        <div class="an-ui__in">
          <div class="an-ventana__barra"><i></i><i></i><i></i><span>portal.tuempresa.com/tableros</span><em>Datos de ejemplo</em></div>
          <AnuncioPortal tarjeta="an-s2-t--" />
        </div>
        <span class="an-s2-sello"><svg viewBox="0 0 41.5 41.5"><path d={PBI} /></svg>1 licencia de Power BI</span>
        <div class="an-s2-gente">
          {CARAS.map((c, i) => <span class={`an-s2-cara an-s2-cara--${i + 1}`}>{c}</span>)}
          <b class="an-s2-mas"><span data-a="kpi" data-signo="+" data-desde="0" data-hasta={String(PERSONAS - CARAS.length)} data-en="8.1" data-dur="0.8">+{PERSONAS - CARAS.length}</span></b>
        </div>
      </div>
    </div>
  </section>

  <!-- Las cuatro barras del logo como cortina (de la 2 a la 3) -->
  <div class="an-barras an-barras--1"><i></i><i></i><i></i><i></i></div>

  <!-- ═══ 3 · TU MARCA: la misma pantalla, tres empresas ═══ -->
  <section class="an-escena an-s3">
    <i class="an-s3-fondo an-s3-fondo--b"></i>
    <i class="an-s3-fondo an-s3-fondo--c"></i>
    <div class="an-texto">
      <p class="an-h1 an-s3-titulo" set:html={titular('Con tu marca.')} />
      <p class="an-h3 an-s3-sub">Tu logo. Tus colores.</p>
    </div>
    <div class="an-visual an-s3-visual">
      <div class="an-ui an-login">
        <div class="an-ui__in">
          <div class="an-login__giro">
            <div class="an-login__tarjeta">
              <i class="an-login__ola an-login__ola--1"></i>
              <i class="an-login__ola an-login__ola--2"></i>
              <div class="an-login__marca an-login__marca--a">
                <svg viewBox="0 0 28 28"><rect x="3" y="14" width="5" height="11" rx="1.2" /><rect x="11.5" y="8" width="5" height="17" rx="1.2" /><rect x="20" y="3" width="5" height="22" rx="1.2" /></svg>
                <span>TU EMPRESA</span>
              </div>
              <div class="an-login__marca an-login__marca--b">
                <svg viewBox="0 0 32 32"><path d="M16 2 26 16 16 30 6 16z" /><path class="an-login__marca-in" d="M16 7.5 21.5 16H10.5z" /></svg>
                <span>NORDEX</span>
              </div>
              <div class="an-login__marca an-login__marca--c">
                <svg viewBox="0 0 36 32"><path d="M4 28 16 5l12 23z" /><path class="an-login__marca-in" d="M15 28 24 12l9 16z" /></svg>
                <span>ACME</span>
              </div>
              <span class="an-login__rotulo">Usuario</span>
              <span class="an-login__campo">mariana.s</span>
              <span class="an-login__rotulo">Contraseña</span>
              <span class="an-login__campo an-login__campo--clave">••••••••••</span>
              <span class="an-login__boton">Ingresar</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 4 · CADA UNO LO SUYO: el portal y quién ve qué ═══ -->
  <section class="an-escena an-s4">
    <div class="an-texto">
      <p class="an-h1 an-s4-titulo" set:html={titular('Cada persona ve solo sus tableros.')} />
    </div>
    <div class="an-visual an-s4-visual">
      <div class="an-ui an-ventana an-portal">
        <div class="an-ui__in">
          <div class="an-ventana__barra"><i></i><i></i><i></i><span>portal.tuempresa.com/tableros</span><em>Datos de ejemplo</em></div>
          <AnuncioPortal tarjeta="an-tarjeta--" ia />
          <i class="an-toque"></i>
        </div>
      </div>
      <div class="an-personas">
        <span class="an-persona an-persona--1"><i>G</i>Gerencia</span>
        <span class="an-persona an-persona--2"><i>V</i>Ventas</span>
        <span class="an-persona an-persona--3"><i>O</i>Operaciones</span>
      </div>
    </div>
  </section>

  <!-- ═══ 5 · EL TABLERO: un toque en la tarjeta y el reporte se dibuja, completo ═══ -->
  <section class="an-escena an-s5">
    <div class="an-texto">
      <p class="an-h1 an-s5-titulo" set:html={titular('Abre tu tablero.')} />
      <p class="an-h2 an-s5-sub" set:html={titular('Completo, con sus filtros.')} />
    </div>
    <div class="an-visual an-s5-visual">
      <div class="an-ui an-ventana an-reporte">
        <div class="an-ui__in">
          <div class="an-ventana__barra"><i></i><i></i><i></i><span>portal.tuempresa.com/visor</span><em>Datos de ejemplo</em></div>
          <AnuncioReporte contar />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 6 · LA IA AL COSTADO DEL TABLERO: la bomba del producto ═══
       El mismo reporte de la toma 5; se apagan las luces, asoma la lengüeta «Chat IA», un toque
       y el panel se abre al costado (el reporte se encaja en lo que queda, como en el portal).
       La cámara se acerca al panel y el chat resuelve dos preguntas que el tablero no contesta
       solo; al final se aleja: el tablero y su IA, juntos. -->
  <section class="an-escena an-s6">
    <i class="an-s6-luz"></i>
    <div class="an-texto an-s6-texto">
      <p class="an-h1 an-s6-titulo an-lema" set:html={LEMA} />
      <p class="an-h3 an-s6-sub">A un clic, al lado de tu tablero.</p>
    </div>
    <div class="an-texto an-s6-final">
      <p class="an-h1 an-s6-final__t" set:html={titular('Pregúntale lo que el tablero no muestra.')} />
    </div>
    <div class="an-visual an-s6-visual">
      <div class="an-ui an-ventana an-s6-ventana">
        <div class="an-ui__in">
          <div class="an-ventana__barra"><i></i><i></i><i></i><span>portal.tuempresa.com/visor</span><em>Datos de ejemplo</em></div>
          <div class="an-s6-escena">
            <div class="an-s6-rep"><AnuncioReporte /></div>
            <span class="an-s6-lengueta"><svg viewBox="0 0 24 24"><path d={DESTELLO} /></svg><b>Chat IA</b></span>
            <i class="an-toque an-s6-toque"></i>
            <div class="an-s6-panel">
              <div class="an-s6-cab">
                <span class="an-s6-cab__ico"><svg viewBox="0 0 24 24"><path d={DESTELLO} /></svg></span>
                <span class="an-s6-cab__id"><b>Ventas por sucursal</b><span>Pregunta sobre los datos de este tablero</span></span>
              </div>
              <div class="an-s6-hilo">
                <div class="an-s6-hilo__in">
                  <div class="an-s6-turno an-s6-turno--1">
                    <p class="an-s6-yo">{PREGUNTA_1}</p>
                    <div class="an-s6-pasos">
                      <span class="an-s6-paso an-s6-paso--1"><i></i>Leyendo la estructura del modelo</span>
                      <span class="an-s6-paso an-s6-paso--2"><i></i>Redactando la consulta</span>
                      <span class="an-s6-paso an-s6-paso--3"><i></i>Consultando Power BI</span>
                    </div>
                    <p class="an-s6-resp"><b>3 de 7</b> sucursales crecieron más que el promedio. <b>Aeropuerto</b> lidera: <b>+18,4 %</b>.</p>
                    <div class="an-s6-graf">
                      <p class="an-s6-graf__t">Crecimiento contra 2025<span class="an-s6-graf__ley"><i></i>promedio {pct(PROMEDIO)}</span></p>
                      <div class="an-s6-graf__filas">
                        {CRECIMIENTO.map(([n, v], i) => (
                          <div class:list={['an-s6-fila', `an-s6-fila--${i + 1}`, { 'an-s6-fila--arriba': v > PROMEDIO, 'an-s6-fila--neg': v < 0 }]}>
                            <span class="an-s6-fila__n">{n}</span>
                            <span class="an-s6-fila__b"><i></i></span>
                            <span class="an-s6-fila__v">{pct(v)}</span>
                          </div>
                        ))}
                        <i class="an-s6-graf__prom"></i>
                      </div>
                    </div>
                  </div>
                  <div class="an-s6-turno an-s6-turno--2">
                    <p class="an-s6-yo">{PREGUNTA_2}</p>
                    <div class="an-s6-pasos">
                      {CONSULTAS.map((c, i) => (
                        <span class={`an-s6-paso an-s6-consulta an-s6-consulta--${i + 1}`}><i></i><b>Consulta {i + 1} de {CONSULTAS.length}</b><em>{c}</em></span>
                      ))}
                    </div>
                    <p class="an-s6-resp">Lo explica <b>el ticket promedio</b>, no la cantidad de tickets.</p>
                    <div class="an-s6-fichas">
                      <div class="an-s6-ficha an-s6-ficha--si">
                        <p class="an-s6-ficha__cab"><span>Ticket promedio · Aeropuerto</span><b class="an-s6-ficha__d">+26 %</b></p>
                        <p class="an-s6-par"><em>2025</em><span class="an-s6-par__b"><i class="an-s6-par__r an-s6-par__r--antes an-s6-par__r--80"></i></span><span class="an-s6-par__v">US$ 94</span></p>
                        <p class="an-s6-par an-s6-par--ahora"><em>2026</em><span class="an-s6-par__b"><i class="an-s6-par__r an-s6-par__r--100"></i></span><b class="an-s6-par__v">US$ <span data-a="kpi" data-desde="94" data-hasta="118" data-en="36.4" data-dur="0.8">118</span></b></p>
                      </div>
                      <div class="an-s6-ficha">
                        <p class="an-s6-ficha__cab"><span>Tickets · Aeropuerto</span><b class="an-s6-ficha__d an-s6-ficha__d--no">−6 %</b></p>
                        <p class="an-s6-par"><em>2025</em><span class="an-s6-par__b"><i class="an-s6-par__r an-s6-par__r--antes an-s6-par__r--100"></i></span><span class="an-s6-par__v">7.388</span></p>
                        <p class="an-s6-par an-s6-par--ahora an-s6-par--gris"><em>2026</em><span class="an-s6-par__b"><i class="an-s6-par__r an-s6-par__r--94"></i></span><b class="an-s6-par__v"><span data-a="kpi" data-desde="7388" data-hasta="6969" data-en="36.5" data-dur="0.8">6.969</span></b></p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="an-s6-campo">
                <span class="an-s6-input">
                  <span class="an-s6-ph">Pregunta algo sobre estos datos…</span>
                  <span class="an-s6-txt">
                    <span data-a="tipeo" data-texto={PREGUNTA_1} data-en="27.5" data-fin="29.2"></span>
                    <span data-a="tipeo" data-texto={PREGUNTA_2} data-en="33.2" data-fin="34.1"></span>
                  </span>
                  <i class="an-s6-caret"></i>
                </span>
                <span class="an-s6-enviar"><svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7" /></svg></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 7 · EN EL CELULAR ═══ -->
  <section class="an-escena an-s7">
    <div class="an-texto">
      <p class="an-h1 an-s7-titulo" set:html={titular('También desde el celular.')} />
    </div>
    <div class="an-visual an-s7-visual">
      <div class="an-ui an-celular">
        <div class="an-ui__in">
          <div class="an-celular__pantalla">
            <div class="an-celular__barra">
              <span class="an-portal__logo"><svg viewBox="0 0 28 28"><rect x="3" y="14" width="5" height="11" rx="1.2" /><rect x="11.5" y="8" width="5" height="17" rx="1.2" /><rect x="20" y="3" width="5" height="22" rx="1.2" /></svg>Portal BI</span>
              <i class="an-celular__menu"></i>
            </div>
            <div class="an-celular__lista">
              <span class="an-celular__hola">Comercial</span>
              {TARJETAS.slice(0, 4).map((t) => (
                <div class="an-celular__tarjeta">
                  <svg class="an-tarjeta__pbi" viewBox="0 0 41.5 41.5"><path d={PBI} /></svg>
                  <span>{t.titulo}</span>
                  {t.ia && <span class="an-tarjeta__ia"><svg viewBox="0 0 24 24"><path d={VARITA} /></svg>IA</span>}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 8 · RÁFAGA: cuatro razones, una por tiempo (las del socio, si es para él) ═══ -->
  <section class="an-escena an-s8">
    {CORTES.map((c, i) => (
      <div class={`an-corte an-corte--${i + 1}`}>
        <svg class="an-corte__ico" viewBox="0 0 48 48"><path d={c.ico} pathLength="1" /></svg>
        <p class="an-h1" set:html={titular(c.texto)} />
      </div>
    ))}
  </section>

  <!-- Las barras otra vez, para entrar al cierre (o, para el socio, a lo que le cobramos) -->
  <div class="an-barras an-barras--2"><i></i><i></i><i></i><i></i></div>

  {socio && (
    <>
      <!-- ═══ 10 · SOLO PARA EL SOCIO: lo que le cobramos ═══ -->
      <section class="an-escena an-s10">
        <div class="an-precio">
          <p class="an-h3 an-precio__a">A ti te cobramos</p>
          <p class="an-precio__n"><span>US$</span>{PRECIO_SOCIO}</p>
          <p class="an-h2 an-precio__por">al mes, por cliente.</p>
          <i class="an-precio__linea"></i>
          <p class="an-h2 an-precio__tu" set:html={titular('Tu precio lo pones tú.')} />
          <p class="an-h3 an-precio__ia">La IA la paga cada cliente, a su proveedor.</p>
        </div>
      </section>
      <div class="an-barras an-barras--3"><i></i><i></i><i></i><i></i></div>
    </>
  )}

  <!-- ═══ 9 · CIERRE: la marca y a dónde escribir ═══ -->
  <section class="an-escena an-s9">
    <div class="an-cierre">
      <div class="an-logo">
        <svg class="an-logo__icono" viewBox="0 0 1893 1895">
          <path class="an-logo__pantalla" d="M0 1107V130A130 130 0 0 1 130 0h1633a130 130 0 0 1 130 130v977Z" />
          {LOGO_BARRAS.map((b, i) => (
            <rect class={`an-logo__barra an-logo__barra--${i + 1}`} x={b.x} y={b.y} width="233" height={b.alto} />
          ))}
          <path class="an-logo__pie" d="M0 1181h1893v201a120 120 0 0 1-120 120h-669v153h273a120 120 0 0 1 120 120v120H396v-120a120 120 0 0 1 120-120h273v-153H120A120 120 0 0 1 0 1382ZM596.5 1260h70a41.5 41.5 0 0 1 0 83h-70a41.5 41.5 0 0 1 0-83ZM911.5 1260h70a41.5 41.5 0 0 1 0 83h-70a41.5 41.5 0 0 1 0-83ZM1226.5 1260h70a41.5 41.5 0 0 1 0 83h-70a41.5 41.5 0 0 1 0-83Z" fill-rule="evenodd" />
        </svg>
        <svg class="an-logo__wordmark" viewBox="0 0 4733 484"><path d={LOGO_WORDMARK} /></svg>
      </div>
      <p class="an-h1 an-s9-titulo" set:html={titular('Power BI para toda tu empresa.')} />
      <!-- El lema (ADR-018): lo presenta la toma 6 y lo firma el cierre -->
      <p class="an-h3 an-s9-lema an-lema" set:html={LEMA} />
      <ul class="an-fichas">
        <li>1 licencia</li>
        <li>Con tu marca</li>
        <li>Chat con IA</li>
        <li>En el celular</li>
      </ul>
      <p class="an-cta">
        <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.3-.1.6.2.3.8 1.4 1.8 2.2 1.2 1.1 2.3 1.4 2.6 1.6.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.8-.1 1.4Z" /></svg>
        <span>Escríbenos: {CONTACTO.telefonoVisible}</span>
      </p>
      <p class="an-url">{socio ? 'Data Studio × Ribentek' : 'datastudio.es/portal-bi'}</p>
    </div>
  </section>

  <!-- La firma: chica, arriba, mientras dura el anuncio (el cierre trae la grande) -->
  <div class="an-firma">
    <svg viewBox="0 0 28 28"><rect x="3" y="14" width="5" height="11" rx="1.2" /><rect x="11.5" y="8" width="5" height="17" rx="1.2" /><rect x="20" y="3" width="5" height="22" rx="1.2" /></svg>
    <span>Portal BI</span>
  </div>
</div>
