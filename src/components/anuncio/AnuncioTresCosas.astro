---
/**
 * El anuncio «A tu Power BI le faltan 3 cosas» (/anuncios/tres-cosas/): 30 segundos (ADR-022).
 *
 * Nace de la primera venta: el comprador dijo que lo que más le interesó fueron los roles (darle
 * solo lectura a algunos) y el chat con IA, y ningún anuncio mostraba lo primero. Y de una queja
 * del dueño sobre «Power BI primero»: muestra el chat dos veces. Acá cada cosa se muestra UNA vez.
 *
 * La estructura es una lista con los tres pilares a la vista desde el primer cuadro (el mapa de
 * lo que se va a ver: quien lee «Ahorro» se queda), con sus casillas vacías, y una toma para cada
 * uno:
 *  1 · Ahorro: deja de pagar por cada usuario (1.000 licencias que bajan a 1, y la gente con
 *      acceso que no baja);
 *  2 · Control total: tú decides qué ve cada persona (la misma ventana vista por Gerencia, por
 *      Ventas con su filtro y por un cliente con páginas ocultas y solo lectura);
 *  3 · Lo mejor de todo, potenciado con IA: el chip, el toque, el chat que escribe y contesta, y
 *      una segunda pregunta difícil que el chat resuelve con dos consultas y un gráfico de
 *      pesas (2025 contra 2026 en cada sucursal): el valor del chat a la vista.
 * Y la lista otra vez, con sus tres tildes («Ahora sí, no le falta nada.»), antes del cierre.
 *
 * El dueño pidió «seguridad y control total» para el segundo pilar. Dice «Control total»: el
 * portal decide qué ve cada uno, pero el token del visor no está acotado a un reporte (ver
 * docs/seguridad.md del portal), y prometer seguridad sería prometer de más.
 *
 * Solo promete lo que el portal hace: qué tablero y qué página ve cada uno, con qué filtro. No
 * dice que los datos queden aislados por persona (eso no lo garantiza un filtro de Power BI, ver
 * docs/seguridad.md del portal). Sin precios (pedido del dueño). Español neutro: sirve igual en
 * América y en España («teléfono», no «celular»).
 *
 * Usa el motor del anuncio de 55 s (src/scripts/anuncio.ts) y su base de estilos (anuncio.css):
 * tomas con su ventana --a/--z, todo el movimiento en @keyframes contados desde el segundo 0 y
 * tamaños en --u. El reporte y el chat son las mismas maquetas (ADR-014). Lo propio vive en
 * anuncio-3c.css.
 */
import AnuncioReporte from './AnuncioReporte.astro';
import { PBI } from './datos';
import { CONTACTO } from '../../data/sitio';
import { LOGO_BARRAS, LOGO_WORDMARK } from '../../data/logo';

/* Un titular partido en palabras con ranura: la animación las sube de a una (w0, w1…). Un tramo
   con clase (["Power BI", "tc-amarillo"]) va junto y en su color */
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const frase = (...partes: (string | [string, string])[]) => {
  let k = 0;
  const palabra = (w: string) => `<span class="an-p w${k++}"><span>${esc(w)}</span></span>`;
  return partes
    .map((p) => (typeof p === 'string' ? p.split(' ').map(palabra).join(' ') : `<span class="${p[1]}">${p[0].split(' ').map(palabra).join(' ')}</span>`))
    .join(' ');
};

/* Las tres cosas: el título de cada renglón y lo que dice cuando se destapa */
const COSAS = [
  { n: 1, titulo: 'Ahorro', texto: '1 licencia para toda tu empresa' },
  { n: 2, titulo: 'Control total', texto: 'Tú decides qué ve cada persona' },
  { n: 3, titulo: 'Potenciado con IA', texto: 'Le preguntas y te responde' },
];

/* Los trazos */
const TILDE = 'M5 12.5 10 17.5 19 7';
const ARCO = 'M8 10.5V8a4 4 0 0 1 8 0v2.5';
const GENTE = 'M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM2.5 21v-.5A6.5 6.5 0 0 1 9 14a6.5 6.5 0 0 1 6.5 6.5v.5M16 3.3a4 4 0 0 1 0 7.4M21.5 21v-.5a6.5 6.5 0 0 0-3.8-5.9';
const OJO = 'M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z';
const EMBUDO = 'M3.5 4.5h17l-6.5 7.7v6.1l-4 2.2v-8.3Z';
const DESTELLO = 'M12 2l1.9 5.6L19.5 9l-5.6 1.9L12 16.5l-1.9-5.6L4.5 9l5.6-1.4z';
const CHISPA = 'M12 0C12.7 6.7 17.3 11.3 24 12 17.3 12.7 12.7 17.3 12 24 11.3 17.3 6.7 12.7 0 12 6.7 11.3 11.3 6.7 12 0Z';

/* La toma 2: las licencias que harían falta, una por persona, y las que hacen falta con el portal */
const PERSONAS = 1000;

/* La toma 3: quién mira la misma ventana */
const QUIEN = [
  { id: 1, inicial: 'G', nombre: 'Gerencia' },
  { id: 2, inicial: 'V', nombre: 'Ventas' },
  { id: 3, inicial: 'C', nombre: 'Cliente' },
];

/* La toma 4: la pregunta que la IA escribe y contesta. Los datos son los del reporte de ejemplo
   (ADR-013): Aeropuerto creció +18,4 %, más del doble del promedio ponderado (+7,9 %) */
const PREGUNTA = '¿Qué sucursal creció más?';

/* La segunda: la difícil. El chat hace dos consultas y contesta con un gráfico de pesas (el
   «dumbbell» del portal: antes contra después). Los mismos datos de ejemplo, cuadrados (ADR-013):
   las ventas 2026 del reporte y el crecimiento de cada sucursal dan las de 2025 (2026 / (1 + g)),
   y las siete suman el +7,9 % del indicador. En miles; el eje va de 0 a 1.300 */
const PREGUNTA_2 = 'Compara cada sucursal contra 2025: ¿quién subió y quién bajó?';
const CONSULTAS = ['ventas de 2025 por sucursal', 'ventas de 2026 por sucursal'];
const PESAS = [
  ['Aeropuerto', 694.5, 822.3, 18.4],
  ['Norte', 841.5, 935.8, 11.2],
  ['Centro', 1157.1, 1262.4, 9.1],
  ['Plaza Mayor', 986.0, 1041.2, 5.6],
  ['Costanera', 686.3, 708.9, 3.3],
  ['Sur', 277.7, 268.5, -3.3],
  ['Parque Industrial', 191.1, 177.0, -7.4],
] as const;
const pct = (v: number) => `${v > 0 ? '+' : '−'}${Math.abs(v).toFixed(1).replace('.', ',')} %`;
---

<div class="an-lienzo an-lienzo--tc" data-a="lienzo" data-formato="9x16" data-movimiento-propio aria-hidden="true">
  <!-- El reloj: una animación lineal de 30 s que el script lee para saber en qué segundo va -->
  <i class="an-reloj" data-a="reloj"></i>

  <!-- Fondo vivo de las tomas oscuras -->
  <div class="an-fondo"><i></i><i></i></div>

  <!-- ═══ 1 · EL GANCHO (0 – 4,75 s): «A tu Power BI le faltan 3 cosas.» ═══
       El primer cuadro ya lo dice (y dice Power BI, que es lo que segmenta). Debajo, la lista con
       los tres pilares a la vista —el mapa de lo que viene— y sus casillas vacías. Se iluminan de
       a uno para guiar la lectura, y el primero se queda encendido justo antes del corte: es el
       que viene ahora. -->
  <section class="an-escena tc-s1">
    <div class="an-texto tc-s1-texto">
      <p class="an-h1 tc-s1-titular">A tu <span class="tc-amarillo">Power BI</span> le faltan <span class="tc-tres">3 cosas.</span></p>
    </div>
    <div class="an-visual tc-s1-visual">
      <div class="tc-lista">
        <div class="tc-lista__cab">
          <span class="tc-lista__pbi"><svg viewBox="0 0 41.5 41.5"><path d={PBI} /></svg></span>
          <b>Tu Power BI</b>
          <span class="tc-lista__cuenta">0 de 3</span>
        </div>
        {COSAS.map((c) => (
          <div class={`tc-item tc-item--${c.n}`}>
            <span class="tc-item__n">{c.n}</span>
            <span class="tc-item__txt"><b>{c.titulo}</b><em>{c.texto}</em></span>
            <span class="tc-item__caja"></span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 2 · AHORRO (4,5 – 9 s): deja de pagar por cada usuario ═══
       Dos medidas, una debajo de la otra: las licencias que harían falta (una por persona) bajan
       de 1.000 a 1; la gente con acceso no baja. Lo que se ahorra se lee sin hacer ninguna
       cuenta, y sin precio (pedido del dueño). -->
  <section class="an-escena tc-s2">
    <div class="an-texto">
      <span class="tc-paso"><b>1</b>Ahorro</span>
      <p class="an-h1 tc-s2-titulo" set:html={frase('Deja de pagar por cada usuario.')} />
      <p class="an-h3 tc-s2-sub">1 sola licencia para toda tu empresa.</p>
    </div>
    <div class="an-visual tc-s2-visual">
      <div class="tc-medidor">
        <div class="tc-fila tc-fila--lic">
          <span class="tc-fila__ico"><svg viewBox="0 0 41.5 41.5"><path d={PBI} /></svg></span>
          <span class="tc-fila__t">Licencias de Power BI</span>
          <b class="tc-fila__v"><span data-a="kpi" data-desde={String(PERSONAS)} data-hasta="1" data-en="5.9" data-dur="1.1">1.000</span></b>
          <span class="tc-fila__barra"><i></i></span>
        </div>
        <div class="tc-fila tc-fila--gente">
          <span class="tc-fila__ico"><svg viewBox="0 0 24 24"><path d={GENTE} /></svg></span>
          <span class="tc-fila__t">Personas con acceso</span>
          <b class="tc-fila__v">1.000</b>
          <span class="tc-fila__barra"><i></i></span>
        </div>
        <span class="tc-sello"><svg viewBox="0 0 24 24"><path d={TILDE} /></svg>999 licencias que ya no pagas</span>
      </div>
    </div>
  </section>

  <!-- ═══ 3 · CONTROL TOTAL (9 – 14 s): tú decides qué ve cada persona ═══
       La misma ventana del visor, vista por tres personas. Gerencia la ve entera; Ventas, con su
       filtro (Sucursal: Norte); el cliente, sin las páginas que no le tocan y en solo lectura.
       Los verbos del subtítulo llegan con cada cambio: filtra, oculta, muestra. -->
  <section class="an-escena tc-s3">
    <div class="an-texto">
      <span class="tc-paso"><b>2</b>Control total</span>
      <p class="an-h1 tc-s3-titulo" set:html={frase('Tú decides qué ve cada persona.')} />
      <p class="an-h3 tc-verbos"><span class="tc-verbo tc-verbo--1">Filtra.</span> <span class="tc-verbo tc-verbo--2">Oculta.</span> <span class="tc-verbo tc-verbo--3">Muestra solo lo que debe.</span></p>
    </div>
    <div class="an-visual tc-s3-visual">
      <div class="tc-quien">
        {QUIEN.map((q) => (
          <span class={`tc-quien__p tc-quien__p--${q.id}`}><i>{q.inicial}</i>{q.nombre}</span>
        ))}
      </div>
      <!-- Lo que ve quien mira ahora, en grande: en la ventana se ve chico en un teléfono -->
      <div class="tc-estado">
        <span class="tc-estado__e tc-estado__e--1"><svg viewBox="0 0 24 24"><path d={OJO} /><circle cx="12" cy="12" r="3" /></svg>Ve todo</span>
        <span class="tc-estado__e tc-estado__e--2"><svg viewBox="0 0 24 24"><path d={EMBUDO} /></svg>Solo la sucursal Norte</span>
        <span class="tc-estado__e tc-estado__e--3"><svg viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" rx="2" /><path d={ARCO} /></svg>2 páginas ocultas · solo lectura</span>
      </div>
      <div class="an-ui an-ventana tc-s3-ventana">
        <div class="an-ui__in">
          <div class="an-ventana__barra"><i></i><i></i><i></i><span>portal.tuempresa.com/visor</span><em>Datos de ejemplo</em></div>
          <div class="tc-s3-rep">
            <AnuncioReporte />
            <span class="tc-filtro"><svg viewBox="0 0 24 24"><path d={EMBUDO} /></svg>Sucursal: <b>Norte</b></span>
          </div>
          <div class="tc-pestanas">
            <span class="tc-pestana tc-pestana--si">Ventas</span>
            <span class="tc-pestana tc-pestana--2">Margen<svg viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" rx="2" /><path d={ARCO} /></svg></span>
            <span class="tc-pestana tc-pestana--3">Cartera<svg viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" rx="2" /><path d={ARCO} /></svg></span>
            <span class="tc-lectura"><svg viewBox="0 0 24 24"><path d={OJO} /><circle cx="12" cy="12" r="3" /></svg>Solo lectura</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 4 · LO MEJOR DE TODO: POTENCIADO CON IA (14 – 24 s) ═══
       El plus, y la única vez que se ve el chat: el tablero con la lengüeta «Chat IA» que llama,
       un toque, el chat se abre al costado (el reporte se encaja, como en el portal), la cámara
       entra y la IA escribe la pregunta, muestra sus pasos (los rótulos de chat.ejs del Portal BI)
       y contesta con el dato. Después, la difícil: dos consultas («Consulta n de 2», como las
       muestra el chat) y el gráfico de pesas. Un turno por pregunta, como en el de 55 s: al enviar
       la segunda, el hilo sube un turno entero. -->
  <section class="an-escena tc-s4">
    <div class="an-texto tc-s4-texto">
      <span class="tc-paso tc-paso--ia"><b>3</b>Lo mejor de todo</span>
      <p class="an-h1 tc-s4-titulo"><span class="an-p w0"><span>Potenciado</span></span> <span class="an-p w1"><span>con</span></span> <span class="tc-chip"><svg class="tc-chip__chispa" viewBox="0 0 24 24"><path d={CHISPA} /></svg>IA</span></p>
    </div>
    <div class="an-visual tc-ia">
      <div class="an-ui an-ventana tc-ia__ventana">
        <div class="an-ui__in">
          <div class="an-ventana__barra"><i></i><i></i><i></i><span>portal.tuempresa.com/visor</span><em>Datos de ejemplo</em></div>
          <div class="an-s6-escena">
            <div class="an-s6-rep"><AnuncioReporte /></div>
            <span class="an-s6-lengueta"><svg viewBox="0 0 24 24"><path d={DESTELLO} /></svg><b>Chat IA</b></span>
            <i class="an-toque an-s6-toque"></i>
            <div class="an-s6-panel">
              <div class="an-s6-cab">
                <span class="an-s6-cab__ico"><svg viewBox="0 0 24 24"><path d={DESTELLO} /></svg></span>
                <span class="an-s6-cab__id"><b>Ventas por sucursal</b><span>Pregunta sobre los datos de este tablero</span></span>
              </div>
              <div class="an-s6-hilo">
                <div class="an-s6-hilo__in">
                  <div class="an-s6-turno tc-turno--1">
                    <p class="an-s6-yo">{PREGUNTA}</p>
                    <div class="an-s6-pasos">
                      <span class="an-s6-paso tc-ia-paso--1"><i></i>Leyendo la estructura del modelo</span>
                      <span class="an-s6-paso tc-ia-paso--2"><i></i>Redactando la consulta</span>
                      <span class="an-s6-paso tc-ia-paso--3"><i></i>Consultando Power BI</span>
                    </div>
                    <p class="an-s6-resp"><b>Aeropuerto</b> lidera: <b>+18,4 %</b>, más del doble del promedio.</p>
                    <div class="tc-ia__dato"><span>Aeropuerto · contra 2025</span><b>+18,4 %</b></div>
                  </div>
                  <div class="an-s6-turno tc-turno--2">
                    <p class="an-s6-yo">{PREGUNTA_2}</p>
                    <div class="an-s6-pasos">
                      {CONSULTAS.map((c, i) => (
                        <span class={`an-s6-paso an-s6-consulta tc-ia-c--${i + 1}`}><i></i><b>Consulta {i + 1} de {CONSULTAS.length}</b><em>{c}</em></span>
                      ))}
                    </div>
                    <p class="an-s6-resp"><b>5 de 7</b> subieron; <b>Sur</b> y <b>Parque Industrial</b> bajaron. <b>Aeropuerto</b> sumó <b>+127,8 mil</b>.</p>
                    <div class="tc-pesas">
                      <p class="tc-pesas__t">Ventas por sucursal · miles<span class="tc-pesas__ley"><i class="tc-pesas__antes"></i>2025<i class="tc-pesas__ahora"></i>2026</span></p>
                      <div class="tc-pesas__filas">
                        <i class="tc-pesas__guia tc-pesas__guia--1"></i>
                        <i class="tc-pesas__guia tc-pesas__guia--2"></i>
                        <i class="tc-pesas__guia tc-pesas__guia--3"></i>
                        {PESAS.map(([n, , , v], i) => (
                          <div class:list={['tc-pesa', `tc-pesa--${i + 1}`, { 'tc-pesa--baja': v < 0 }]}>
                            <span class="tc-pesa__n">{n}</span>
                            <span class="tc-pesa__pista"><i class="tc-pesa__barra"></i><i class="tc-pesa__antes"></i><i class="tc-pesa__ahora"></i></span>
                            <span class="tc-pesa__v">{pct(v)}</span>
                          </div>
                        ))}
                        <p class="tc-pesas__eje"><span>0</span><span>650</span><span>1.300</span></p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="an-s6-campo">
                <span class="an-s6-input">
                  <span class="an-s6-ph">Pregunta algo sobre estos datos…</span>
                  <span class="an-s6-txt">
                    <span data-a="tipeo" data-texto={PREGUNTA} data-en="16" data-fin="16.6"></span>
                    <span data-a="tipeo" data-texto={PREGUNTA_2} data-en="18.7" data-fin="19.9"></span>
                  </span>
                  <i class="an-s6-caret"></i>
                </span>
                <span class="an-s6-enviar"><svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7" /></svg></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 5 · AHORA SÍ (24 – 26,3 s): la lista otra vez, con sus tres tildes ═══
       Cierra el bucle que abrió el gancho: los mismos renglones, ahora con lo que dicen, y una
       tilde por pulso. -->
  <section class="an-escena tc-s5">
    <div class="an-texto">
      <p class="an-h1 tc-s5-titulo" set:html={frase('Ahora sí, no le falta nada.')} />
    </div>
    <div class="an-visual tc-s5-visual">
      <div class="tc-lista tc-lista--llena">
        <div class="tc-lista__cab">
          <span class="tc-lista__pbi"><svg viewBox="0 0 41.5 41.5"><path d={PBI} /></svg></span>
          <b>Tu Power BI</b>
          <span class="tc-lista__cuenta">3 de 3</span>
        </div>
        {COSAS.map((c) => (
          <div class={`tc-item tc-item--${c.n}`}>
            <span class="tc-item__n">{c.n}</span>
            <span class="tc-item__txt"><b>{c.titulo}</b><em>{c.texto}</em></span>
            <span class="tc-item__caja"><svg viewBox="0 0 24 24"><path d={TILDE} /></svg></span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Las cuatro barras del logo como cortina, para entrar al cierre -->
  <div class="an-barras tc-barras"><i></i><i></i><i></i><i></i></div>

  <!-- ═══ 6 · CIERRE (26,3 s – fin): la marca, las tres cosas y a dónde escribir ═══ -->
  <section class="an-escena tc-s6">
    <div class="an-cierre">
      <div class="an-logo">
        <svg class="an-logo__icono" viewBox="0 0 1893 1895">
          <path class="an-logo__pantalla" d="M0 1107V130A130 130 0 0 1 130 0h1633a130 130 0 0 1 130 130v977Z" />
          {LOGO_BARRAS.map((b, i) => (
            <rect class={`an-logo__barra an-logo__barra--${i + 1}`} x={b.x} y={b.y} width="233" height={b.alto} />
          ))}
          <path class="an-logo__pie" d="M0 1181h1893v201a120 120 0 0 1-120 120h-669v153h273a120 120 0 0 1 120 120v120H396v-120a120 120 0 0 1 120-120h273v-153H120A120 120 0 0 1 0 1382ZM596.5 1260h70a41.5 41.5 0 0 1 0 83h-70a41.5 41.5 0 0 1 0-83ZM911.5 1260h70a41.5 41.5 0 0 1 0 83h-70a41.5 41.5 0 0 1 0-83ZM1226.5 1260h70a41.5 41.5 0 0 1 0 83h-70a41.5 41.5 0 0 1 0-83Z" fill-rule="evenodd" />
        </svg>
        <svg class="an-logo__wordmark" viewBox="0 0 4733 484"><path d={LOGO_WORDMARK} /></svg>
      </div>
      <p class="an-h1 an-s9-titulo" set:html={frase('Power BI para toda tu empresa.')} />
      <ul class="an-fichas">
        <li>1 licencia</li>
        <li>Control total</li>
        <li>Potenciado con IA</li>
        <li>El código es tuyo</li>
      </ul>
      <p class="an-cta">
        <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.3-.1.6.2.3.8 1.4 1.8 2.2 1.2 1.1 2.3 1.4 2.6 1.6.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.8-.1 1.4Z" /></svg>
        <span>Pide tu demo: {CONTACTO.telefonoVisible}</span>
      </p>
      <p class="an-url">datastudio.es/portal-bi</p>
    </div>
  </section>

  <!-- La firma: chica, arriba, mientras dura el anuncio (el cierre trae la grande) -->
  <div class="an-firma">
    <svg viewBox="0 0 28 28"><rect x="3" y="14" width="5" height="11" rx="1.2" /><rect x="11.5" y="8" width="5" height="17" rx="1.2" /><rect x="20" y="3" width="5" height="22" rx="1.2" /></svg>
