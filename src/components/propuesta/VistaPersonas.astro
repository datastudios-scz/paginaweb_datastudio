---
/**
 * Lámina 6 de la propuesta a Ribentek (ADR-020): el mismo tablero, tres personas, y cada una ve
 * su parte. En el portal, el administrador arma el filtro de cada persona recorriendo el modelo
 * semántico (tabla, columna, valor) y lo deja invisible y bloqueado; acá se muestra para
 * explicarlo. Se llama «vista personalizada», no seguridad (docs del portal: filtros-por-usuario).
 *
 * Los botones eligen quién abre el tablero; mientras nadie los toca, cambian solos (el script,
 * sin hacerlo con «reducir movimiento»). Lo de cada persona ya está en el marcado: el atributo
 * data-persona decide qué se ve.
 * Datos de ejemplo (ADR-013): las tres regiones suman lo que ve gerencia (5.216.100), y las
 * sucursales, lo de su región.
 */
import Icono from '../Icono.astro';
import { PBI } from '../anuncio/datos';

/* [nombre, valor, ancho en pasos de 5 % (pr-w-N), relativo a la barra más larga de esa vista] */
const PERSONAS = [
  {
    id: 'gerencia',
    inicial: 'G',
    nombre: 'Gerencia',
    filtro: 'Sin filtro: ve todo',
    total: '5.216.100',
    barras: [
      ['Santa Cruz', '2.420.000', 20],
      ['La Paz', '1.730.000', 14],
      ['Cochabamba', '1.066.100', 9],
    ],
  },
  {
    id: 'santa-cruz',
    inicial: 'S',
    nombre: 'Santa Cruz',
    filtro: "Región = 'Santa Cruz'",
    total: '2.420.000',
    barras: [
      ['Equipetrol', '1.020.000', 20],
      ['Norte', '830.000', 16],
      ['Plan 3000', '570.000', 11],
    ],
  },
  {
    id: 'la-paz',
    inicial: 'L',
    nombre: 'La Paz',
    filtro: "Región = 'La Paz'",
    total: '1.730.000',
    barras: [
      ['Sopocachi', '690.000', 20],
      ['Zona Sur', '610.000', 18],
      ['El Alto', '430.000', 12],
    ],
  },
] as const;
---

<div class="pr-vista-p" data-p="vista" data-persona="gerencia">
  <div class="pr-quien" role="group" aria-label="Quién abre el tablero">
    {PERSONAS.map((p, i) => (
      <button type="button" data-p="persona" data-id={p.id} aria-pressed={i === 0 ? 'true' : 'false'}>
        <i aria-hidden="true">{p.inicial}</i>{p.nombre}
      </button>
    ))}
  </div>
  <div class="pr-tab" aria-live="polite">
    <div class="pr-tab__cab">
      <span class="pr-tab__nombre"><svg viewBox="0 0 41.5 41.5" aria-hidden="true"><path d={PBI} /></svg>Ventas por sucursal</span>
      {PERSONAS.map((p) => (
        <span class="pr-tab__filtro" data-de={p.id}><Icono nombre="candado" />{p.filtro}</span>
      ))}
    </div>
    <div class="pr-tab__kpi">
      <span>Ventas del mes, en US$</span>
      {PERSONAS.map((p) => <b data-de={p.id}>{p.total}</b>)}
    </div>
    {PERSONAS.map((p) => (
      <ul class="pr-barras" data-de={p.id} role="list">
        {p.barras.map(([n, v, w]) => (
          <li><span>{n}</span><i class={`pr-w-${w}`}></i><b>{v}</b></li>
        ))}
      </ul>
    ))}
    <span class="pr-ejemplo">Datos de ejemplo</span>
  </div>
</div>
