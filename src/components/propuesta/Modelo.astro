---
/**
 * Lámina 9 de la propuesta a Ribentek (ADR-020): cómo trabajamos juntos. Tres actores y lo que
 * va de uno al otro: el cliente le paga a Ribentek, Ribentek le paga a Data Studio un fijo por
 * cliente, y Data Studio se encarga de todo lo técnico. Abajo, lo que pone el cliente.
 * Las flechas corren en el sentido del dinero (el trazo se mueve; quieto con «reducir
 * movimiento»). Los términos (US$ 60 al mes por cliente, la IA la paga el cliente) son los que
 * definió el dueño el 17/10/2026.
 */
interface Props {
  costo: number;
}

const { costo } = Astro.props;
---

<div class="pr-modelo">
  <div class="pr-flujo">
    <div class="pr-nodo pr-a d1">
      <b class="pr-nodo__quien">Tu cliente</b>
      <ul role="list">
        <li>Pone su licencia de Power BI: la que ya tiene</li>
        <li>Usa el portal con su propia marca</li>
      </ul>
    </div>
    <div class="pr-flecha pr-a d2">
      <span>Te paga cada mes</span>
      <i aria-hidden="true"></i>
    </div>
    <div class="pr-nodo pr-nodo--socio pr-a d3">
      <b class="pr-nodo__quien">Ribentek</b>
      <ul role="list">
        <li>Encuentra al cliente y le vende</li>
        <li>Pone su precio y cobra cada mes</li>
        <li>Es la cara comercial</li>
      </ul>
    </div>
    <div class="pr-flecha pr-a d4">
      <span>US$ {costo} al mes por cliente</span>
      <i aria-hidden="true"></i>
    </div>
    <div class="pr-nodo pr-a d5">
      <b class="pr-nodo__quien">Data Studio</b>
      <ul role="list">
        <li>Instala y configura el portal del cliente</li>
        <li>Capacita a quien lo administra</li>
        <li>Da el soporte y lo mantiene al día</li>
      </ul>
    </div>
  </div>

  <ul class="pr-pone" role="list">
    <li class="pr-a d6">
      <b>La licencia de Power BI</b>
      <span>Una sola, la de la cuenta que publica los reportes. Tu cliente ya la tiene.</span>
    </li>
    <li class="pr-a d7">
      <b>La IA, si la quiere</b>
      <span>Cada cliente la paga directo a su proveedor (Claude, Gemini, OpenAI…), por lo que usa. Se prende por tablero.</span>
    </li>
    <li class="pr-a d8">
      <b>El precio, lo pones tú</b>
      <span>Nuestro costo para ti es fijo: US$ {costo} al mes por cliente. Lo demás es tu margen.</span>
    </li>
  </ul>
</div>
