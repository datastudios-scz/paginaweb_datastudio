---
/**
 * Vitrinas del inicio: un bloque por producto, con su maqueta real y el mismo recorrido en
 * cada una: la pregunta que nombra el dolor → el nombre → la promesa (en acento) → tres puntos
 * que la respaldan → un llamado específico que lleva a su subpágina.
 * El inicio NO explica todo ni lleva a WhatsApp ni muestra montos: distribuye (la explicación
 * completa, los montos y los botones de contacto viven en cada subpágina).
 * Cada vitrina tiene su propio campo de color para que se lea como un producto distinto.
 * Rótulos de los botones: que quepan en una línea a 320 px (unos 270 px con el ícono).
 */
import Icono from '../Icono.astro';
import Ventana from '../portal/Ventana.astro';
import MaquetaPortal from '../portal/MaquetaPortal.astro';
import MaquetaTablero from '../social/MaquetaTablero.astro';
import Catalogo from '../tienda/Catalogo.astro';
import BarrasMarca from '../BarrasMarca.astro';
import Flujo from '../consultoria/Flujo.astro';

const VITRINAS = [
  {
    id: 'portal-bi',
    tema: 'oscuro',
    nombre: 'Portal BI',
    pregunta: '',
    frase: 'Power BI para toda tu empresa. Nunca más una licencia por persona.',
    puntos: [
      'Basta la licencia de la cuenta que publica. Cada persona entra con su usuario y ve solo sus tableros, con tu marca.',
      'Chat con IA que responde con tus datos y te muestra la consulta.',
      'Dos caminos: lo implementas tú con el código, la guía y el curso, o lo implementamos por ti.',
    ],
    href: '/portal-bi/',
    accion: 'Ver más detalles',
  },
  {
    id: 'social-metrics',
    tema: 'petroleo',
    nombre: 'Social Metrics BI',
    pregunta: '¿Cuántas pestañas abres para armar el reporte de redes?',
    frase: 'Deja de juntar métricas a mano: todas tus redes en un solo tablero.',
    puntos: [
      'Conexión de solo lectura con las APIs oficiales de Meta, YouTube y TikTok.',
      'Todo tu histórico, no solo los últimos días, con actualizaciones automáticas programadas.',
      'Tu equipo lo abre con su usuario o dentro de tu sitio web.',
    ],
    href: '/social-metrics-bi/',
    accion: 'Mira cómo se ve el tablero',
  },
  {
    id: 'ecommerce',
    tema: 'salvia',
    nombre: 'Tienda e‑commerce',
    pregunta: '¿Quieres vender en línea sin atarte a una mensualidad?',
    frase: 'Una tienda online que es tuya: pagas una vez y los pedidos llegan a tu WhatsApp.',
    puntos: [
      'Código fuente completo y guía de implementación paso a paso.',
      'Personalizable con tu marca y adaptable a cualquier rubro.',
      'Sin mensualidades: compras la tienda, no la alquilas.',
    ],
    href: '/tienda-ecommerce/',
    accion: 'Mira cómo sería tu tienda',
  },
  {
    id: 'consultoria',
    tema: 'blanco',
    nombre: 'Consultoría de datos',
    pregunta: '¿Quieres tomar decisiones basadas en datos?',
    frase: 'Ordenamos tus datos para que todos miren la misma cifra.',
    puntos: [
      'Integramos tus fuentes con procesos que se actualizan solos.',
      'Un modelo único define cada indicador una sola vez, en Power BI a tu medida.',
      'Reportes automáticos, sin consolidar Excels a mano.',
    ],
    href: '/consultoria/',
    accion: 'Así ordenamos tus datos',
  },
] as const;
---

{VITRINAS.map((v, i) => (
  <section
    class:list={['seccion', 'vitrina', { 'vitrina--invertida': i % 2 === 1 }]}
    id={`vitrina-${v.id}`}
    data-tema={v.tema}
    aria-labelledby={`vitrina-${v.id}-titulo`}
  >
    <div class="contenedor vitrina__rejilla">
      <div class="vitrina__texto">
        <div class="vitrina__cabecera">
          {v.pregunta && <p class="vitrina__pregunta">{v.pregunta}</p>}
          <h2 id={`vitrina-${v.id}-titulo`} class="vitrina__nombre">
            <BarrasMarca activa={v.id} class="vitrina__barras" />{v.nombre}
          </h2>
        </div>
        <p class="vitrina__frase">{v.frase}</p>
        <ul class="lista-check vitrina__puntos">
          {v.puntos.map((p) => (
            <li><Icono nombre="check" /><span>{p}</span></li>
          ))}
        </ul>
        {v.id === 'social-metrics' && (
          <p class="vitrina__nota">
            Solo leemos las métricas de las cuentas que tú autorizas, para tus tableros internos: no las compartimos
            con terceros y puedes revocar el acceso cuando quieras. <a class="enlace" href="/privacidad/">Política de Privacidad</a>
          </p>
        )}
        <div class="acciones">
          <a class="boton boton--primario" href={v.href}>
            <span>{v.accion}</span>
            <Icono nombre="flecha" />
          </a>
        </div>
      </div>

      <div class="vitrina__visual">
        {v.id === 'portal-bi' && (
          <Ventana url="portal.tuempresa.com/tableros" descripcion="Maqueta del Portal BI: menú lateral con tableros por área y tarjetas de tableros de Power BI, una con chat de IA.">
            <MaquetaPortal />
          </Ventana>
        )}
        {v.id === 'social-metrics' && (
          <Ventana url="portal.tuempresa.com/tableros/redes" descripcion="Maqueta de un tablero de Social Metrics BI con indicadores y gráficos de redes sociales, con datos de ejemplo.">
            <MaquetaTablero variante="compacta" />
          </Ventana>
        )}
        {v.id === 'ecommerce' && <Catalogo variante="compacta" />}
        {v.id === 'consultoria' && <Flujo variante="compacta" />}
      </div>
    </div>
  </section>
))}

<style>
  .vitrina__rejilla {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .vitrina__texto {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  /* Pregunta que nombra el dolor, pegada al nombre del producto que lo responde */
  .vitrina__cabecera {
    display: grid;
    gap: var(--space-3);
  }

  .vitrina__pregunta {
    max-width: 32ch;
    font-size: var(--text-lg);
    font-weight: var(--peso-medio);
    line-height: 1.35;
    color: var(--texto-2);
    text-wrap: balance;
  }

  /* Las barras del logo con la de este producto encendida: la tesis de la portada, en cada vitrina */
  .vitrina__nombre :global(.vitrina__barras) {
    height: 0.62em;
    margin-inline-end: 0.28em;
  }

  .vitrina__nombre {
    font-size: clamp(2.25rem, 1.4rem + 3.2vw, 3.75rem);
    font-weight: var(--peso-semi);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--texto);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .vitrina__frase {
    max-width: 26ch;
    font-size: var(--text-2xl);
    font-weight: var(--peso-medio);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--acento);
    text-wrap: balance;
  }

  .vitrina__puntos li {
    max-width: 34rem;
  }

  .vitrina__nota {
    font-size: var(--text-sm);
    color: var(--texto-3);
  }

  .vitrina__visual {
    min-width: 0;
  }

  /* Respaldo: con zoom o en pantallas muy angostas, el rótulo del botón se parte en vez de
     desbordar la página (los rótulos actuales caben en una línea a 320 px). */
  @media (max-width: 30rem) {
    .vitrina__texto .boton {
      white-space: normal;
      text-align: center;
      line-height: 1.25;
      padding-block: var(--space-3);
    }
  }

  @media (min-width: 64rem) {
    .vitrina__rejilla {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-9);
    }

    .vitrina--invertida .vitrina__texto {
      order: 2;
    }

    .vitrina--invertida .vitrina__rejilla {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
  }
</style>
