---
/**
 * Portada de marca a pantalla completa (solo en el inicio).
 *
 * Momento focal del sitio:
 *  1. Al cargar, el logo se arma: el monitor aparece, sus cuatro barras suben una a una y
 *     el wordmark "DATA STUDIO" se revela de izquierda a derecha.
 *  2. Al bajar, la sección de soluciones sube como un telón (la portada es sticky). Con la
 *     misma línea de tiempo del scroll, las barras del logo se vacían mientras se llenan las
 *     cuatro barras de las soluciones: el logo "se abre" en los cuatro productos.
 *     (CSS scroll-driven animations con fallback: sin soporte, todo queda quieto y visible.)
 * El fondo es un tablero de datos en perspectiva hecho en HTML/SVG: el mundo del producto,
 * tenue para no competir con la marca.
 *
 * La geometría del ícono es la del logo oficial (ver Logo.astro): pantalla 1893×1107,
 * barras de 233 px con alturas 473/626/786/473, bisel y pie.
 */
import Icono from '../Icono.astro';
import { SITIO } from '../../data/sitio';

const WORDMARK =
  'm4 7 58 63 55 59h122l122 1-21 76-20 75h-39l-39-1 29-116-83-1-82 1-31 114-32 118v3h372l24-18 24-19 84-313-14-20-14-19h-24L35 4H1zm618 18-27 22-48 172-49 175-1 5h170l13-55 15-58 1-3h75l-27 115 82 1h82l48-174 47-176c1-2-2-6-14-23L974 5 810 4H647zm434-19-33 123h61l61 1-72 268c-1 1 16 1 81 1h83l37-135 38-135h121l1-6 32-117c0-2-10-2-205-2-194 0-205 0-205 2m476 20-27 22-46 169-48 176-2 6h170l13-55 15-58 1-3h75l-27 115 82 1h82l48-174 47-176c1-2-2-6-14-24l-15-20-164-1h-163zm639-17 56 63 52 58h206c196 0 207 0 207-2l32-122c0-2-14-2-279-2h-278zm599-4-33 124h123l-1 5-72 264 82 1h82l8-28 38-135 30-107h120l1-5 32-119a16562 16562 0 0 0-410 0m438 11-48 179-45 168 16 21 15 20h330l23-19 25-21c3-2 6-15 49-178l48-179V4h-83l-82 1-27 96-38 138-11 43h-76v-3l74-274-83-1h-84zm460-11-106 398 183 1h184l13-11 26-22 13-10 42-158 41-159-17-19-16-19h-106zm454 3-107 395 83 1h82l54-197 54-199 1-2h-83c-78 0-83 0-84 2m228 17-25 21-88 320c0 2 28 36 30 37l164 1h162l28-21 28-23 42-158 42-157-17-20-16-19h-328zM735 130l-18 73 41 1h41l9-39 9-39h-81zm912 0-18 73 41 1h41l9-39 9-39h-81zm2151-3-41 154 40 1h40l1-4 40-149v-3h-40zm668 0-41 153 80 1 41-155zm-2196 37-22 79 243 3q1 3-4 18l-6 18h-245l-1 4-32 117 187 1h187l23-19 24-21c2-1 49-175 49-180l-8-11-7-9z';

// Barras del ícono: x, y (tope), alto. Base común en y = 1028.
const BARRAS = [
  { x: 240, y: 555, h: 473 },
  { x: 633, y: 402, h: 626 },
  { x: 1027, y: 242, h: 786 },
  { x: 1420, y: 555, h: 473 },
];

// Alturas de las barras del gráfico de fondo (proporciones de una serie creciente con pausas).
const SERIE = [34, 46, 41, 58, 52, 66, 61, 74, 69, 82, 78, 92];
---

<section class="portada" data-tema="oscuro" aria-labelledby="portada-titulo">
  <!-- Escena: un tablero de datos en perspectiva (decorativo) -->
  <div class="escena" aria-hidden="true">
    <div class="escena__plano">
      <div class="panel panel--kpi">
        <span class="panel__rotulo"></span>
        <span class="panel__cifra"></span>
        <span class="panel__tendencia"></span>
      </div>
      <div class="panel panel--kpi">
        <span class="panel__rotulo"></span>
        <span class="panel__cifra"></span>
        <span class="panel__tendencia"></span>
      </div>
      <div class="panel panel--kpi">
        <span class="panel__rotulo"></span>
        <span class="panel__cifra"></span>
        <span class="panel__tendencia"></span>
      </div>
      <div class="panel panel--barras">
        <span class="panel__rotulo"></span>
        <div class="panel__serie">
          {SERIE.map((_, i) => <span class:list={['panel__barra', `panel__barra--${i}`]} />)}
        </div>
      </div>
      <div class="panel panel--linea">
        <span class="panel__rotulo"></span>
        <svg viewBox="0 0 300 120" preserveAspectRatio="none">
          <polyline class="escena__rejilla" points="0,30 300,30" />
          <polyline class="escena__rejilla" points="0,60 300,60" />
          <polyline class="escena__rejilla" points="0,90 300,90" />
          <polyline class="escena__serie escena__serie--b" points="0,96 25,90 50,93 75,80 100,84 125,70 150,74 175,58 200,62 225,46 250,40 275,34 300,22" />
          <polyline class="escena__serie escena__serie--a" points="0,104 25,100 50,101 75,94 100,96 125,88 150,90 175,82 200,84 225,76 250,74 275,70 300,64" />
        </svg>
      </div>
      <div class="panel panel--dona">
        <svg viewBox="0 0 120 120">
          <circle class="dona__pista" cx="60" cy="60" r="42" />
          <circle class="dona__valor" cx="60" cy="60" r="42" />
        </svg>
      </div>
      <div class="panel panel--tabla">
        <span class="panel__rotulo"></span>
        <span class="panel__fila"></span>
        <span class="panel__fila"></span>
        <span class="panel__fila"></span>
        <span class="panel__fila"></span>
      </div>
      <div class="panel panel--mapa">
        <span class="panel__rotulo"></span>
        <div class="panel__calor">
          {Array.from({ length: 24 }, (_, i) => <span class:list={['celda', `celda--${(i * 7) % 5}`]} />)}
        </div>
      </div>
    </div>
    <div class="escena__velo"></div>
  </div>

  <div class="portada__contenido">
    <h1 id="portada-titulo" class="portada__marca">
      <span class="solo-lectores">{SITIO.nombre}: {SITIO.lema}</span>
      <svg class="portada__icono" viewBox="0 0 1893 1895" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="portada-plata" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ffffff" />
            <stop offset="0.55" stop-color="#e3eced" />
            <stop offset="1" stop-color="#9fbcc2" />
          </linearGradient>
        </defs>
        <path class="icono__pantalla" d="M0 1107V130A130 130 0 0 1 130 0h1633a130 130 0 0 1 130 130v977Z" />
        {BARRAS.map((b, i) => (
          <g class:list={['icono__vaciar', `icono__vaciar--${i}`]}>
            <rect class:list={['icono__barra', `icono__barra--${i}`]} x={b.x} y={b.y} width="233" height={b.h} />
          </g>
        ))}
        <path
          class="icono__base"
          fill-rule="evenodd"
          d="M0 1181h1893v201a120 120 0 0 1-120 120h-669v153h273a120 120 0 0 1 120 120v120H396v-120a120 120 0 0 1 120-120h273v-153H120A120 120 0 0 1 0 1382ZM596.5 1260h70a41.5 41.5 0 0 1 0 83h-70a41.5 41.5 0 0 1 0-83ZM911.5 1260h70a41.5 41.5 0 0 1 0 83h-70a41.5 41.5 0 0 1 0-83ZM1226.5 1260h70a41.5 41.5 0 0 1 0 83h-70a41.5 41.5 0 0 1 0-83Z"
        />
      </svg>
      <svg class="portada__wordmark" viewBox="1 4 4732 399" aria-hidden="true" focusable="false">
        <path d={WORDMARK} />
      </svg>
    </h1>

    <span class="portada__regla" aria-hidden="true"></span>
    <p class="portada__lema" aria-hidden="true">{SITIO.lema}</p>

    <p class="portada__pregunta">Bienvenido, ¿estás preparado para <span>innovar</span>?</p>
  </div>

  <a class="portada__bajar" href="#soluciones">
    <span>Descubre nuestras soluciones</span>
    <Icono nombre="chevronAbajo" />
  </a>
</section>

<style>
  /* ── Contenedor: pantalla completa, fija mientras sube el telón ───── */
  .portada {
    position: sticky;
    top: 0;
    z-index: 0;
    display: grid;
    place-items: center;
    min-height: 100svh;
    /* El encabezado se superpone a la portada (margen negativo en Encabezado.astro) */
    padding: calc(var(--alto-encabezado) + var(--space-6)) var(--gutter) var(--space-9);
    overflow: hidden;
    background: linear-gradient(180deg, var(--color-abismo) 0%, #01202b 55%, var(--color-abismo) 100%);
    color: var(--texto);
    text-align: center;
  }

  /* ── Escena de fondo: tablero en perspectiva ─────────────────────── */
  .escena {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .escena__plano {
    position: absolute;
    left: 50%;
    top: 78%;
    width: min(150vw, 110rem);
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: 7.5rem;
    gap: 1.25rem;
    transform: translate(-50%, -30%) perspective(1600px) rotateX(58deg) rotateZ(-9deg);
    transform-origin: 50% 50%;
    opacity: 0.45;
    mask-image: radial-gradient(60% 55% at 50% 45%, #000 20%, transparent 78%);
  }

  .panel {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1rem 1.1rem;
    border-radius: 10px;
    background: rgb(0 57 78 / 0.55);
    box-shadow: inset 0 0 0 1px rgb(206 217 189 / 0.12);
    overflow: hidden;
  }

  .panel__rotulo {
    width: 42%;
    height: 0.4rem;
    border-radius: 999px;
    background: rgb(206 217 189 / 0.3);
  }

  .panel--kpi { grid-column: span 1; }
  .panel--barras { grid-column: span 2; grid-row: span 2; }
  .panel--linea { grid-column: span 2; grid-row: span 2; }
  /* La dona va al final de la grilla: en el centro caía detrás de la pregunta y del botón de bajar */
  .panel--dona { grid-column: span 1; grid-row: span 2; place-items: center; order: 1; }

  @media (max-width: 48rem) {
    .panel--dona { visibility: hidden; }
  }
  .panel--tabla { grid-column: span 2; }
  .panel--mapa { grid-column: span 2; }

  .panel__cifra {
    width: 64%;
    height: 1.35rem;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.55);
  }

  .panel__tendencia {
    width: 30%;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-verde-claro);
    opacity: 0.8;
  }

  .panel__serie {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
    gap: 0.4rem;
    height: 11rem;
  }

  .panel__barra {
    height: 100%;
    background: linear-gradient(to top, rgb(77 207 193 / 0.85), rgb(77 207 193 / 0.35));
    transform-origin: 50% 100%;
  }

  /* Alturas por clase (la CSP no admite style en el HTML) */
  .panel__barra--0 { transform: scaleY(0.34); }
  .panel__barra--1 { transform: scaleY(0.46); }
  .panel__barra--2 { transform: scaleY(0.41); }
  .panel__barra--3 { transform: scaleY(0.58); }
  .panel__barra--4 { transform: scaleY(0.52); }
  .panel__barra--5 { transform: scaleY(0.66); }
  .panel__barra--6 { transform: scaleY(0.61); }
  .panel__barra--7 { transform: scaleY(0.74); }
  .panel__barra--8 { transform: scaleY(0.69); }
  .panel__barra--9 { transform: scaleY(0.82); }
  .panel__barra--10 { transform: scaleY(0.78); }
  .panel__barra--11 { transform: scaleY(0.92); }

  .panel--linea svg {
    width: 100%;
    height: 12rem;
  }

  .escena__rejilla {
    fill: none;
    stroke: rgb(206 217 189 / 0.14);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .escena__serie {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .escena__serie--a { stroke: rgb(206 217 189 / 0.5); }
  .escena__serie--b { stroke: var(--color-verde-claro); }

  .panel--dona svg {
    width: 8.5rem;
    height: 8.5rem;
    transform: rotate(-90deg);
  }

  .dona__pista,
  .dona__valor {
    fill: none;
    stroke-width: 14;
  }

  .dona__pista { stroke: rgb(206 217 189 / 0.16); }

  .dona__valor {
    stroke: var(--color-verde-claro);
    stroke-dasharray: 264;
    stroke-dashoffset: 84;
    stroke-linecap: round;
  }

  .panel__fila {
    height: 0.55rem;
    border-radius: 999px;
    background: rgb(206 217 189 / 0.18);
  }

  .panel__fila:nth-child(odd) {
    width: 80%;
  }

  .panel__calor {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.25rem;
  }

  .celda { height: 1.1rem; border-radius: 2px; }
  .celda--0 { background: rgb(77 207 193 / 0.12); }
  .celda--1 { background: rgb(77 207 193 / 0.28); }
  .celda--2 { background: rgb(77 207 193 / 0.45); }
  .celda--3 { background: rgb(77 207 193 / 0.62); }
  .celda--4 { background: rgb(77 207 193 / 0.8); }

  /* Velo: oscurece el centro para que la marca se lea siempre */
  .escena__velo {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(52rem 34rem at 50% 52%, rgb(0 23 32 / 0.92), transparent 76%),
      linear-gradient(to bottom, rgb(0 23 32 / 0.9), transparent 28%, transparent 72%, rgb(0 23 32 / 0.95));
  }

  /* ── Marca ───────────────────────────────────────────────────────── */
  .portada__contenido {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    width: 100%;
    max-width: 60rem;
  }

  .portada__marca {
    display: grid;
    justify-items: center;
    gap: clamp(1.25rem, 3.4vh, 2.25rem);
    margin: 0;
  }

  .portada__icono {
    width: clamp(6.5rem, 4rem + 11vh, 12.5rem);
    height: auto;
    overflow: visible;
  }

  .icono__pantalla,
  .icono__base {
    fill: url(#portada-plata);
  }

  .icono__barra {
    fill: var(--color-abismo);
  }

  .icono__barra,
  .icono__vaciar {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  .portada__wordmark {
    width: min(86vw, 52rem);
    height: auto;
    fill: var(--color-blanco);
  }

  .portada__regla {
    display: block;
    width: min(86vw, 52rem);
    height: 2px;
    margin-top: clamp(0.75rem, 2vh, 1.25rem);
    background: rgb(255 255 255 / 0.85);
    transform-origin: 50% 50%;
  }

  .portada__lema {
    margin-top: clamp(0.75rem, 2vh, 1.1rem);
    font-size: clamp(0.6875rem, 0.55rem + 0.6vw, 1rem);
    font-weight: var(--peso-medio);
    letter-spacing: 0.24em;
    text-indent: 0.24em;
    text-transform: uppercase;
    color: var(--color-blanco);
  }

  .portada__pregunta {
    max-width: 24ch;
    margin-top: clamp(2rem, 6vh, 3.5rem);
    font-size: clamp(1.375rem, 1rem + 1.6vw, 2.25rem);
    font-weight: var(--peso-medio);
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--color-blanco);
  }

  .portada__pregunta span {
    color: var(--color-verde-claro);
  }

  .portada__bajar {
    position: absolute;
    left: 50%;
    bottom: clamp(1.25rem, 4vh, 2.5rem);
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-4);
    transform: translateX(-50%);
    border-radius: var(--radio-pill);
    color: var(--color-salvia);
    font-size: var(--text-sm);
    font-weight: var(--peso-medio);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-1) var(--ease-out);
  }

  .portada__bajar:hover {
    color: var(--color-blanco);
  }

  .portada__bajar :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (max-height: 40rem) {
    .portada__bajar {
      display: none;
    }
  }

  /* ── 1. Entrada: el logo se arma (una sola vez) ──────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    /* La escena no hace fundido de entrada: un fundido de toda la pantalla retrasa el
       "Speed Index". Solo su serie crece y su línea se traza. */
    .panel__barra {
      animation: escena-crecer 900ms var(--ease-out) both;
      animation-delay: calc(200ms + var(--i, 0) * 40ms);
    }

    .escena__serie {
      stroke-dasharray: 520;
      animation: escena-trazar 1200ms var(--ease-out) 300ms both;
    }

    .icono__pantalla,
    .icono__base {
      animation: icono-aparecer 500ms var(--ease-out) both;
    }

    .icono__barra {
      animation: barra-subir 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .icono__barra--0 { animation-delay: 250ms; }
    .icono__barra--1 { animation-delay: 330ms; }
    .icono__barra--2 { animation-delay: 410ms; }
    .icono__barra--3 { animation-delay: 490ms; }

    .portada__wordmark {
      animation: revelar-izquierda 700ms cubic-bezier(0.16, 1, 0.3, 1) 600ms both;
    }

    .portada__regla {
      animation: regla-extender 500ms var(--ease-out) 900ms both;
    }

    .portada__lema {
      animation: aparecer-suave 500ms var(--ease-out) 1000ms both;
    }

    .portada__bajar :global(svg) {
      animation: invitar 2400ms var(--ease-in-out) 2000ms infinite;
    }
  }

  @keyframes escena-crecer {
    from { transform: scaleY(0); }
  }

  @keyframes escena-trazar {
    from { stroke-dashoffset: 520; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes icono-aparecer {
    from { opacity: 0; }
  }

  @keyframes barra-subir {
    from { transform: scaleY(0); }
  }

  @keyframes revelar-izquierda {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }

  @keyframes regla-extender {
    from { transform: scaleX(0); }
  }

  @keyframes aparecer-suave {
    from { opacity: 0; transform: translateY(0.5rem); }
  }

  @keyframes invitar {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  /* Retrasos escalonados de la serie de fondo (clases, sin style en línea) */
  .panel__barra--0 { --i: 0; }
  .panel__barra--1 { --i: 1; }
  .panel__barra--2 { --i: 2; }
  .panel__barra--3 { --i: 3; }
  .panel__barra--4 { --i: 4; }
  .panel__barra--5 { --i: 5; }
  .panel__barra--6 { --i: 6; }
  .panel__barra--7 { --i: 7; }
  .panel__barra--8 { --i: 8; }
  .panel__barra--9 { --i: 9; }
  .panel__barra--10 { --i: 10; }
  .panel__barra--11 { --i: 11; }

  /* ── 2. Al bajar: el telón de soluciones sube y el logo "se abre" ─── */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .portada__contenido { animation: marca-alejarse linear both; }
      .escena { animation: escena-hundir linear both; }
      .icono__vaciar { animation: barra-vaciar linear both; }
      .portada__bajar { animation: aparecer-inverso linear both; }

      /*
       * La línea de tiempo va en reglas aparte y más específicas. Si comparte regla con el
       * atajo `animation`, el minificador la fusiona dentro del atajo ("animation: … --telon")
       * y Chrome descarta la declaración entera. Ver docs/aprendizajes.md.
       */
      .portada .portada__contenido { animation-timeline: --telon; animation-range: entry 25% entry 100%; }
      .portada .escena { animation-timeline: --telon; animation-range: entry 0% entry 100%; }
      /* Las barras del logo se vacían en el mismo tramo en que se llenan las del gráfico */
      .portada .icono__vaciar { animation-timeline: --grafico; }
      .portada .icono__vaciar--0 { animation-range: entry 0% entry 62%; }
      .portada .icono__vaciar--1 { animation-range: entry 5% entry 67%; }
      .portada .icono__vaciar--2 { animation-range: entry 10% entry 72%; }
      .portada .icono__vaciar--3 { animation-range: entry 15% entry 77%; }
      .portada .portada__bajar { animation-timeline: --telon; animation-range: entry 0% entry 25%; }
    }
  }

  @keyframes marca-alejarse {
    to { opacity: 0; transform: translateY(-6vh) scale(0.94); }
  }

  @keyframes escena-hundir {
    to { opacity: 0.25; }
  }

  @keyframes barra-vaciar {
    to { transform: scaleY(0); }
  }

  @keyframes aparecer-inverso {
    to { opacity: 0; }
  }
</style>
