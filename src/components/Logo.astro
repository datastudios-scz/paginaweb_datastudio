---
/**
 * Logo de Data Studio en SVG en línea (hereda `currentColor`).
 * - Ícono: reconstrucción geométrica exacta del monitor del logo oficial
 *   (99,7 % de coincidencia de píxeles con el PNG maestro de 4739 px).
 * - Wordmark "DATA STUDIO": trazado vectorial (potrace + SVGO) del PNG oficial
 *   en tipografía Costa Rica. Procedimiento en docs/marca.md.
 * Nunca se recrea el wordmark con texto: la tipografía Costa Rica es solo del logo.
 */
interface Props {
  variante?: 'horizontal' | 'icono';
  class?: string;
  /** Si el logo está dentro de un enlace con su propio nombre accesible. */
  decorativo?: boolean;
}

