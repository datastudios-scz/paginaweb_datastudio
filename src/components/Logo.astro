---
/**
 * Logo de Data Studio en SVG en línea (hereda `currentColor`).
 * - Ícono: reconstrucción geométrica exacta del monitor del logo oficial
 *   (99,7 % de coincidencia de píxeles con el PNG maestro de 4739 px).
 * - Wordmark "DATA STUDIO": trazado vectorial (potrace + SVGO) del PNG oficial
 *   en tipografía Costa Rica. Procedimiento en docs/marca.md.
 * Nunca se recrea el wordmark con texto: la tipografía Costa Rica es solo del logo.
 */
import { LOGO_ICONO, LOGO_WORDMARK } from '../data/logo';

interface Props {
  variante?: 'horizontal' | 'icono';
  class?: string;
  /** Si el logo está dentro de un enlace con su propio nombre accesible. */
  decorativo?: boolean;
}

const { variante = 'horizontal', class: clase, decorativo = false } = Astro.props;
const ICONO = LOGO_ICONO;
const WORDMARK = LOGO_WORDMARK;

const a11y = decorativo
  ? { 'aria-hidden': 'true' as const }
  : { role: 'img', 'aria-label': 'Data Studio' };
---

{variante === 'icono' ? (
  <svg class={clase} viewBox="0 0 1893 1895" fill="currentColor" focusable="false" {...a11y}>
    <path fill-rule="evenodd" d={ICONO} />
  </svg>
) : (
  <svg class={clase} viewBox="0 0 5481 560" fill="currentColor" focusable="false" {...a11y}>
    <g transform="scale(0.29551)">
      <path fill-rule="evenodd" d={ICONO} />
    </g>
    <g transform="translate(748.4 76.5)">
      <path d={WORDMARK} />
    </g>
  </svg>
)}
