---
/**
 * Preguntas frecuentes con <details> nativo: accesible por teclado y funciona sin JS.
 * `respuesta` admite HTML propio (textos del sitio, nunca contenido de terceros).
 * Las mismas preguntas se publican como FAQPage en JSON-LD desde cada página.
 */
import Icono from './Icono.astro';

export interface Pregunta {
  pregunta: string;
  respuesta: string;
}

interface Props {
  id?: string;
  etiqueta?: string;
  titulo: string;
  bajada?: string;
  preguntas: Pregunta[];
  tema?: 'claro' | 'salvia' | 'oscuro';
}

const { id = 'preguntas', etiqueta = 'Preguntas', titulo, bajada, preguntas, tema = 'claro' } = Astro.props;
---

<section class="seccion preguntas" id={id} data-tema={tema} aria-labelledby={`${id}-titulo`}>
  <div class="contenedor preguntas__rejilla">
    <header class="preguntas__cabecera" data-revelar>
      <p class="etiqueta">{etiqueta}</p>
      <h2 id={`${id}-titulo`} class="titulo-seccion">{titulo}</h2>
      {bajada && <p class="entrada" set:html={bajada} />}
      <slot />
    </header>

    <div class="preguntas__lista" data-revelar>
      {preguntas.map((p, i) => (
        <details open={i === 0}>
          <summary>
            <span>{p.pregunta}</span>
            <Icono nombre="mas" class="preguntas__icono" />
          </summary>
          <div class="preguntas__respuesta" set:html={p.respuesta} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .preguntas__rejilla {
    display: grid;
    gap: var(--space-7);
  }

  .preguntas__cabecera {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .preguntas__lista {
    border-top: 1px solid var(--linea-fuerte);
  }

  details {
    border-bottom: 1px solid var(--linea);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 3.5rem;
    padding-block: var(--space-4);
    font-size: var(--text-md);
    font-weight: var(--peso-semi);
    line-height: 1.4;
    color: var(--texto);
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--acento);
  }

  .preguntas :global(.preguntas__icono) {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    color: var(--acento);
    transition: transform var(--dur-2) var(--ease-out);
  }

  details[open] :global(.preguntas__icono) {
    transform: rotate(45deg);
  }

  .preguntas__respuesta {
    display: grid;
    gap: var(--space-3);
    max-width: 44rem;
    padding-bottom: var(--space-5);
    color: var(--texto-2);
  }

  .preguntas__respuesta :global(a) {
    color: var(--acento);
    font-weight: var(--peso-medio);
    text-underline-offset: 0.2em;
  }

  .preguntas__respuesta :global(strong) {
    color: var(--texto);
  }

  /* Apertura suave donde el navegador lo soporta; en el resto abre al instante */
  @supports (interpolate-size: allow-keywords) {
    .preguntas__lista {
      interpolate-size: allow-keywords;
    }

    details::details-content {
      height: 0;
      overflow: clip;
      transition:
        height var(--dur-2) var(--ease-out),
        content-visibility var(--dur-2) allow-discrete;
    }

    details[open]::details-content {
      height: auto;
    }
  }

  @media (min-width: 64rem) {
    .preguntas__rejilla {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--space-8);
    }
  }
</style>
