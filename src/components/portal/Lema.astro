---
/**
 * El lema del Portal BI (ADR-018): «+ Y ahora tus datos HABLAN», con el chip de IA en la
 * esquina y sus estrellitas. Lo usan la portada de /portal-bi/ y la narración de los dos
 * recorridos (que clona este mismo marcado al llegar a su paso).
 *
 * Todo va en em: toma el tamaño del texto donde se pone. El «+» y el chip son dibujo; un lector
 * de pantalla lee «Y ahora tus datos hablan, con IA». «HABLAN» va en mayúsculas por CSS, para
 * que se lea como palabra y no letra por letra.
 *
 * Las estrellitas titilan solas: es el único movimiento que no responde a nada, y lo pidió el
 * dueño. Su reposo es el estado visible: con «reducir movimiento» quedan quietas, no ocultas.
 * El chip no lleva `transform` junto a `translate`/`rotate`/`scale` en una misma regla: el
 * minificador borra la suelta (aprendizajes). Y nada en 700: ese peso no se precarga, llegaba
 * tarde y el lema saltaba de dos renglones a uno (CLS en el recorrido, medido).
 */
const CHISPA = 'M12 0C12.7 6.7 17.3 11.3 24 12 17.3 12.7 12.7 17.3 12 24 11.3 17.3 6.7 12.7 0 12 6.7 11.3 11.3 6.7 12 0Z';
---

<span class="lema">
  <span class="lema__mas" aria-hidden="true">+</span><span class="lema__frase">Y ahora tus datos <span class="lema__fin"><span class="lema__hablan">hablan</span><span class="solo-lectores">, con IA</span><span class="chip-ia" aria-hidden="true"><svg class="chip-ia__chispa chip-ia__chispa--adentro" viewBox="0 0 24 24"><path d={CHISPA} /></svg>IA<svg class="chip-ia__chispa chip-ia__chispa--arriba" viewBox="0 0 24 24"><path d={CHISPA} /></svg><svg class="chip-ia__chispa chip-ia__chispa--abajo" viewBox="0 0 24 24"><path d={CHISPA} /></svg></span></span></span>
</span>

<style>
  /* El «+»: más grande que el texto, en el verde de acento y con un brillo que lo despega */
  .lema__mas {
    display: inline-block;
    margin-right: 0.22em;
    font-size: 1.35em;
    font-weight: var(--peso-semi);
    line-height: 0.7;
    color: var(--color-verde-claro);
    text-shadow: 0 0 0.4em rgb(77 207 193 / 0.65);
    vertical-align: -0.04em;
  }

  .lema__hablan {
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  /* «HABLAN» y su chip se cortan juntos: el chip nunca queda solo en el renglón de abajo */
  .lema__fin {
    white-space: nowrap;
  }

  /* El chip, en la esquina de «HABLAN»: el índigo de la IA del producto (el del chat), con
     un aro de luz. Sube por posición, no por transform */
  .chip-ia {
    position: relative;
    top: -0.95em;
    display: inline-flex;
    align-items: center;
    gap: 0.32em;
    margin-left: 0.4em;
    padding: 0.36em 0.7em 0.34em 0.55em;
    border-radius: 999px;
    background: linear-gradient(135deg, #4f46e5, #8b5cf6);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.25),
      0 0.3em 1.2em rgb(99 102 241 / 0.55);
    color: #fff;
    font-size: 0.46em;
    font-weight: var(--peso-semi);
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
    vertical-align: baseline;
  }

  .chip-ia__chispa {
    width: 1.2em;
    height: 1.2em;
    flex: none;
    fill: #fff;
  }

  /* Dos más, afuera, en las esquinas del chip */
  .chip-ia__chispa--arriba,
  .chip-ia__chispa--abajo {
    position: absolute;
    fill: #c4b5fd;
  }

  .chip-ia__chispa--arriba {
    top: -0.85em;
    right: -0.55em;
    width: 1.15em;
    height: 1.15em;
  }

  /* Abajo a la derecha: del lado de afuera, lejos de la última letra */
  .chip-ia__chispa--abajo {
    right: -0.75em;
    bottom: -0.45em;
    width: 0.8em;
    height: 0.8em;
    fill: #a5f3fc;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* La de adentro late, siempre a la vista; las de afuera titilan */
    .chip-ia__chispa--adentro {
      animation: lema-late 2.4s ease-in-out infinite;
    }

    .chip-ia__chispa--arriba,
    .chip-ia__chispa--abajo {
      animation: lema-chispa 1.8s ease-in-out infinite;
    }

    .chip-ia__chispa--arriba {
      animation-delay: 0.6s;
    }

    .chip-ia__chispa--abajo {
      animation-delay: 1.2s;
    }
  }

  /* Sin girar: una estrella de cuatro puntas a 45° parece una «×» */
  @keyframes lema-late {
    0%,
    100% {
      scale: 0.8;
      opacity: 0.85;
    }

    50% {
      scale: 1.12;
      opacity: 1;
    }
  }

  @keyframes lema-chispa {
    0%,
    100% {
      scale: 1;
      rotate: 0deg;
      opacity: 1;
    }

    30% {
      scale: 0.3;
      rotate: 45deg;
      opacity: 0.4;
    }

    60% {
      scale: 1.2;
      rotate: 90deg;
      opacity: 1;
    }
  }
</style>
