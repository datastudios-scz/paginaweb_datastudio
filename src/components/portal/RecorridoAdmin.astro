<div class="rc-pantalla ra" data-r="pantalla" data-escena="tablero">
  <!-- ═══ EL MENÚ (admin-layout.ejs) ═══════════════════════════════════════════ -->
  <aside class="ra-menu" data-r="menu">
    <p class="ra-marca"><svg viewBox="0 0 24 24"><path d={I.escudo} /></svg>Admin panel</p>
    <div class="ra-nav">
      {MENU_ADMIN.map((m) =>
        m.seccion ? (
          <p class="ra-seccion">{m.seccion}</p>
        ) : (
          <div class="ra-item" data-clave={m.clave} data-r={`item-${m.clave}`}>
            <svg viewBox="0 0 24 24"><path d={m.ico} /></svg>
            <span>{m.nombre}</span>
          </div>
        ),
      )}
    </div>
    <div class="ra-pie"><svg viewBox="0 0 24 24"><path d={I.salir} /></svg>Cerrar Sesión</div>
  </aside>

  <div class="ra-cuerpo">
    <div class="ra-barra">
      <p class="ra-barra__t">
        <svg viewBox="0 0 24 24"><path d={I.derecha} /></svg>
        <span class="ra-titulo" data-para="tablero">Panel de Administración</span>
        <span class="ra-titulo" data-para="usuarios">Gestión de Usuarios</span>
        <span class="ra-titulo" data-para="workspaces">Workspaces / Tableros BI</span>
        <span class="ra-titulo" data-para="licencia">Tableros con Licencia AAD</span>
        <span class="ra-titulo" data-para="personalizacion">Personalización</span>
        <span class="ra-titulo" data-para="registros">Registros</span>
      </p>
      <span class="ra-quien"><svg viewBox="0 0 24 24"><path d={I.quien} /></svg>admin</span>
    </div>

    <div class="ra-main">
      <!-- ═══ 1. DASHBOARD (dashboard.ejs) ═══════════════════════════════════ -->
      <section class="rc-escena ra-v ra-tablero" data-r="v-tablero">
        <div class="ra-stats" data-r="stats">
          {STATS.map((s) => (
            <div class="ra-stat">
              <span class:list={['ra-stat__ico', s.tono && `ra-stat__ico--${s.tono}`]}><svg viewBox="0 0 24 24"><path d={s.ico} /></svg></span>
              <span class="ra-stat__info">
                <span class="ra-stat__n" data-contar={s.n}>{miles(s.n)}</span>
                <span class="ra-stat__t">{s.t}</span>
                <span class="ra-stat__sub">{s.sub}</span>
              </span>
            </div>
          ))}
        </div>
        <div class="ra-tarjeta ra-rapidas">
          <p class="ra-tarjeta__t">Acciones rápidas</p>
          <div class="ra-rapidas__lista">
            {ACCIONES.map((a) => (
              <span class="ra-rapida"><svg viewBox="0 0 24 24"><path d={a.ico} /></svg>{a.t}</span>
            ))}
          </div>
        </div>
      </section>

      <!-- ═══ 2. USUARIOS (credenciales.ejs) ═════════════════════════════════ -->
      <section class="rc-escena ra-v ra-usuarios" data-r="v-usuarios">
        <div class="ra-tarjeta" data-r="lista-usuarios">
          <div class="ra-herr">
            <p class="ra-herr__t">
              <svg viewBox="0 0 24 24"><path d={I.usuarios} /></svg>Usuarios registrados
              <span class="ra-n" data-r="usuarios-n">1000 usuarios</span>
            </p>
            <span class="ra-buscar"><svg viewBox="0 0 24 24"><path d={I.lupa} /></svg>Buscar usuario, tipo, estado...</span>
            <span class="ra-boton" data-r="nuevo-usuario"><svg viewBox="0 0 24 24"><path d={I.mas} /></svg>Nuevo usuario</span>
          </div>
          <div class="ra-agrupar">
            <span class="ra-agrupar__t">Agrupar por:</span>
            <span class="ra-ficha ra-ficha--on">Tipo</span>
            <span class="ra-ficha">Estado</span>
            <span class="ra-agrupar__acc">Expandir todo</span>
            <span class="ra-agrupar__acc">Colapsar todo</span>
          </div>

          <div class="ra-grupo">
            <p class="ra-grupo__cab"><svg viewBox="0 0 24 24"><path d={I.derecha} /></svg><b>gerente</b><span class="ra-cuenta">12</span><em>Tipo</em></p>
          </div>
          <div class="ra-grupo">
            <p class="ra-grupo__cab"><svg viewBox="0 0 24 24"><path d={I.derecha} /></svg><b>supervisor</b><span class="ra-cuenta">86</span><em>Tipo</em></p>
          </div>
          <div class="ra-grupo ra-grupo--abierto">
            <p class="ra-grupo__cab"><svg viewBox="0 0 24 24"><path d={I.abajo} /></svg><b>usuario</b><span class="ra-cuenta" data-r="grupo-n">902</span><em>Tipo</em></p>
            <table class="ra-tabla">
              <thead><tr><th>Usuario</th><th>Contraseña</th><th>Estado</th><th></th></tr></thead>
              <tbody>
