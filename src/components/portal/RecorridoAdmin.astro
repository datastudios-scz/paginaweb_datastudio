/* ── Registros ─────────────────────────────────────────────────────────────── */
const SERIE = [699, 760, 803, 751, 646, 192, 131, 723, 786, 831, 777, 669, 199, 136, 747, 813, 860, 804, 691, 206, 140, 772, 839, 1024, 830, 714, 212, 145, 796, 730];
const TOTAL_PERIODO = SERIE.reduce((a, b) => a + b, 0); // 18.426
const MAX = Math.max(...SERIE);
/* El gráfico de tendencia, como lo arma registros.ejs: 780 × 190, curva suave entre puntos */
const G = { W: 780, H: 190, pL: 48, pR: 18, pT: 18, pB: 34 };
const cW = G.W - G.pL - G.pR;
const cH = G.H - G.pT - G.pB;
const PUNTOS = SERIE.map((v, i) => ({ x: G.pL + (i / (SERIE.length - 1)) * cW, y: G.pT + (1 - v / 1100) * cH }));
const f1 = (n: number) => n.toFixed(1);
let LINEA = `M ${f1(PUNTOS[0].x)},${f1(PUNTOS[0].y)}`;
for (let i = 1; i < PUNTOS.length; i++) {
  const a = PUNTOS[i - 1];
  const b = PUNTOS[i];
  const mx = f1((a.x + b.x) / 2);
  LINEA += ` C ${mx},${f1(a.y)} ${mx},${f1(b.y)} ${f1(b.x)},${f1(b.y)}`;
}
const BASE_Y = G.pT + cH;
const AREA = `${LINEA} L ${f1(PUNTOS[PUNTOS.length - 1].x)},${f1(BASE_Y)} L ${f1(PUNTOS[0].x)},${f1(BASE_Y)} Z`;
const MARCAS_Y = [0, 275, 550, 825, 1100].map((v) => ({ v, y: G.pT + (1 - v / 1100) * cH }));
