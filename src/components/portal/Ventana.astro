---
/**
 * Marco de pantalla para las maquetas del Portal BI.
 * Las maquetas reproducen el portal real en HTML/CSS (no son capturas): se ven nítidas,
 * pesan casi nada y se editan como cualquier componente.
 * Dentro del marco los colores son fijos: una pantalla no cambia según el tema de quien mira.
 * Los tokens viven en maqueta.css (los comparte con <MaquetaTelefono>).
 * Solo la barra de dirección, sin botones de navegador falsos: la URL es lo que informa
 * (el portal vive en el dominio del cliente).
 *
 * Estilos globales (is:global) a propósito: con alcance, Astro marca cada elemento con un
 * atributo data-astro-cid, y en /portal-bi/ eso sumaba lo justo para que el documento cruzara
 * un viaje más de TCP en la simulación de Lighthouse. Todas las clases llevan el prefijo de
 * su maqueta, así que no chocan. Ver docs/aprendizajes.md.
 */
import './maqueta.css';

interface Props {
  url: string;
  /** Descripción para lectores de pantalla; la maqueta en sí queda oculta para ellos. */
  descripcion: string;
  /** Identidad del portal dibujado: el mismo producto con distintas marcas. */
  marca?: 'datastudio' | 'acme' | 'nordex';
  variante?: 'normal' | 'mini';
  /** Rótulo "Datos de ejemplo" en la barra (ADR-013): para las pantallas con cifras. */
  ejemplo?: boolean;
  class?: string;
}

const { url, descripcion, marca = 'datastudio', variante = 'normal', ejemplo = false, class: clase } = Astro.props;
---

<figure class:list={['ventana', 'mq', `mq--${marca}`, `ventana--${marca}`, { 'ventana--mini': variante === 'mini' }, clase]}>
  <figcaption class="solo-lectores">{descripcion}</figcaption>
  <div class="ventana__cuerpo" aria-hidden="true">
    <div class="ventana__barra">
      <span class="ventana__url">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
        {url}
      </span>
      {ejemplo && <span class="ventana__ejemplo">Datos de ejemplo</span>}
    </div>
    <slot />
  </div>
</figure>

<style is:global>
  .ventana {
    margin: 0;
    min-width: 0;
    border-radius: 14px;
    overflow: hidden;
    background: var(--mq-tarjeta);
    box-shadow: 0 2px 4px rgb(0 23 32 / 0.06), 0 28px 56px -30px rgb(0 23 32 / 0.5);
    color: var(--mq-tinta);
    font-family: var(--font-texto);
    line-height: 1.4;
  }

  [data-tema='oscuro'] .ventana,
  [data-tema='petroleo'] .ventana {
    box-shadow: 0 0 0 1px rgb(206 217 189 / 0.18), 0 32px 64px -32px rgb(0 0 0 / 0.75);
  }

  .ventana__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 12px;
    background: var(--mq-fondo);
    border-bottom: 1px solid var(--mq-borde-2);
  }

  .ventana__url {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    max-width: 100%;
    padding: 4px 11px;
    border-radius: var(--radio-pill);
    background: var(--mq-tarjeta);
    border: 1px solid var(--mq-borde-2);
    font-family: var(--font-datos);
    font-size: 0.6875rem;
    color: var(--mq-tinta-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ventana__url svg {
    width: 11px;
    height: 11px;
    flex: none;
  }

  .ventana__ejemplo {
    flex: none;
    font-family: var(--font-datos);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    color: var(--mq-tinta-3);
    white-space: nowrap;
  }

  .ventana--mini .ventana__url {
    font-size: 0.625rem;
  }

  /* El rótulo no se esconde nunca (ADR-013): en pantallas angostas cede la dirección,
     que se corta con puntos suspensivos. */
</style>
