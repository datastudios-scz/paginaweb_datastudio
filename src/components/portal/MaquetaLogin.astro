---
/**
 * Maqueta de la pantalla de ingreso del Portal BI (views/login.ejs + login.css), la más "de
 * marca" del producto: el fondo, el botón, las olas, la tipografía, el nombre y el logo salen
 * de la hoja `configuracion`. Dos de estas, con marcas distintas, son la misma instalación.
 *
 * Va dentro de <Ventana marca="…">: los colores de cada marca de ejemplo viven en
 * maqueta.css (.mq--acme, .mq--nordex).
 *
 * Estilos globales (is:global) a propósito: con alcance, Astro marca cada elemento con un
 * atributo data-astro-cid, y en /portal-bi/ eso sumaba lo justo para que el documento cruzara
 * un viaje más de TCP en la simulación de Lighthouse. Todas las clases llevan el prefijo de
 * su maqueta, así que no chocan. Ver docs/aprendizajes.md.
 */
interface Props {
  marca: 'acme' | 'nordex';
}

const { marca } = Astro.props;

const MARCAS = {
  acme: { titulo: 'ACME Analytics', usuario: 'mariana.s' },
  nordex: { titulo: 'Nordex Datos', usuario: 'j.paredes' },
} as const;

const { titulo, usuario } = MARCAS[marca];
---

<div class="ml">
  <div class="ml-tarjeta">
    <p class="ml-titulo">{titulo}</p>

    <div class="ml-campo">
      <span class="ml-rotulo">Usuario</span>
      <span class="ml-input ml-input--foco">{usuario}</span>
    </div>
    <div class="ml-campo">
      <span class="ml-rotulo">Contraseña</span>
      <span class="ml-input">
        <span class="ml-clave">••••••••••</span>
        <svg class="ml-ojo" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
      </span>
    </div>

    <span class="ml-boton">Ingresar</span>

    <div class="ml-logo">
      {marca === 'acme' ? (
        <svg viewBox="0 0 120 32">
          <path class="ml-logo__forma" d="M4 28 16 5l12 23z" />
          <path class="ml-logo__forma2" d="M15 28 24 12l9 16z" />
          <text class="ml-logo__txt" x="40" y="24.5">ACME</text>
        </svg>
      ) : (
        <svg viewBox="0 0 132 32">
          <path class="ml-logo__forma" d="M16 2 26 16 16 30 6 16z" />
          <path class="ml-logo__forma2" d="M16 7.5 21.5 16H10.5z" />
          <text class="ml-logo__txt" x="34" y="23.5">NORDEX</text>
        </svg>
      )}
    </div>
  </div>
</div>

<style is:global>
  /* El fondo es el color de marca a pantalla completa (color_login_fondo) */
  /* Alto mínimo común: las dos marcas, una al lado de la otra, miden lo mismo */
  .ml {
    display: grid;
    place-items: center;
    min-height: 20.5rem;
    padding: 30px 18px;
    background: var(--mq-login-fondo, var(--mq-marca));
    font-family: var(--mq-fuente);
  }

  /* La tarjeta de vidrio: casi opaca, con filo y las olas adentro (login.css) */
  .ml-tarjeta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: min(15.5rem, 100%);
    padding: 22px 18px 16px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.9);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.85),
      0 22px 40px rgb(0 0 0 / 0.3),
      0 8px 16px rgb(0 0 0 / 0.16);
    color: #111827;
  }

  /* Las olas: dos manchas grandes de borde irregular, corridas abajo a la derecha */
  .ml-tarjeta::before,
  .ml-tarjeta::after {
    content: '';
    position: absolute;
    z-index: -1;
    width: 22rem;
    height: 22rem;
    border-radius: 40% 45% 35% 40%;
  }

  .ml-tarjeta::before {
    left: 42%;
    bottom: -18.5rem;
    background: var(--mq-onda-1);
    transform: rotate(28deg);
  }

  .ml-tarjeta::after {
    left: 34%;
    bottom: -19.5rem;
    background: var(--mq-onda-2);
    transform: rotate(-12deg);
  }

  .ml-titulo {
    margin: 0 0 14px;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-align: center;
  }

  .ml-campo {
    margin-bottom: 10px;
  }

  .ml-rotulo {
    display: block;
    margin-bottom: 4px;
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4b5563;
  }

  .ml-input {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    height: 29px;
    padding: 0 10px;
    border: 1px solid #e5e7eb;
    border-radius: 7px;
    background: #f8fafc;
    font-size: 0.6875rem;
    color: #111827;
  }

  /* El campo activo, con el anillo del color del botón (login__input:focus-visible) */
  .ml-input--foco {
    border-color: var(--mq-login-boton, var(--mq-marca));
    background: #fff;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--mq-login-boton, var(--mq-marca)) 20%, transparent);
  }

  .ml-clave {
    letter-spacing: 0.08em;
    color: #374151;
  }

  .ml-ojo {
    width: 12px;
    height: 12px;
    flex: none;
    fill: none;
    stroke: #6b7280;
    stroke-width: 2;
  }

  .ml-boton {
    display: grid;
    place-items: center;
    height: 30px;
    margin-top: 14px;
    border-radius: 7px;
    background: var(--mq-login-boton, var(--mq-marca));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.28),
      0 6px 14px -6px rgb(0 0 0 / 0.45);
    color: #fff;
    font-size: 0.65625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ml-logo {
    display: grid;
    place-items: center;
    margin-top: 16px;
  }

  .ml-logo svg {
    width: 6.25rem;
    height: auto;
  }

  .ml-logo__forma { fill: var(--mq-marca); }
  .ml-logo__forma2 { fill: var(--mq-login-boton, var(--mq-acento)); }

  .ml-logo__txt {
    font-family: var(--mq-fuente);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.02em;
    fill: #111827;
  }
</style>
