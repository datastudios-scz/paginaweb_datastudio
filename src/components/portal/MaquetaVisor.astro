---
/**
 * Maqueta del visor del Portal BI con el chat abierto AL COSTADO del tablero
 * (views/modules/visor-embed.ejs, opción "Dónde se abre el chat: al costado").
 *
 * A la izquierda, el reporte de Power BI del cliente, con el tema por defecto del servicio
 * (#118DFF / #12239E): no es diseño del portal, es lo que dibuja Power BI. A la derecha, el
 * chat respondiendo sobre ese mismo modelo. Las cifras de los dos lados cuadran:
 * 5.216.100 en 2026 contra 4.832.200 en 2025 (+7,9 %). Datos de ejemplo.
 *
 * En un contenedor angosto queda solo el chat, como en un celular, donde el panel cubre el
 * reporte.
 *
 * Estilos globales (is:global) a propósito: con alcance, Astro marca cada elemento con un
 * atributo data-astro-cid, y en /portal-bi/ eso sumaba lo justo para que el documento cruzara
 * un viaje más de TCP en la simulación de Lighthouse. Todas las clases llevan el prefijo de
 * su maqueta, así que no chocan. Ver docs/aprendizajes.md.
 */
import MaquetaChat from './MaquetaChat.astro';

/* Ventas netas por mes, en miles (ene–sep). Suman 5.216 (2026) y 4.832 (2025). */
const M26 = [548, 532, 571, 560, 589, 602, 571, 617, 626];
const M25 = [521, 498, 532, 526, 541, 553, 538, 558, 565];
const MESES = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep'];
const TOPE = 750; // eje: 0 a 750 mil

/* Columnas agrupadas: un solo trazado por serie (cada columna es un subtrazado). El lienzo
   mide 90 × 100 y se estira; como no lleva texto, estirarlo no deforma nada. */
const columnas = (serie: number[], desplazamiento: number) =>
  serie
    .map((v, i) => {
      const alto = (v / TOPE) * 100;
      return `M${i * 10 + desplazamiento} 100V${(100 - alto).toFixed(2)}h3.4V100z`;
    })
    .join('');

const COL_25 = columnas(M25, 1.4);
const COL_26 = columnas(M26, 5.2);

const SUCURSALES = [
  { nombre: 'Centro', clase: 'mv-sb-1', valor: '1,28 M' },
  { nombre: 'Norte', clase: 'mv-sb-2', valor: '1,11 M' },
  { nombre: 'Online', clase: 'mv-sb-3', valor: '0,94 M' },
  { nombre: 'Sur', clase: 'mv-sb-4', valor: '0,77 M' },
  { nombre: 'Este', clase: 'mv-sb-5', valor: '0,62 M' },
  { nombre: 'Oeste', clase: 'mv-sb-6', valor: '0,50 M' },
];
---

<div class="mv">
  <div class="mv-rejilla">
    <div class="mv-reporte">
      <div class="mv-lienzo">
        <div class="mv-cab">
          <p class="mv-titulo">Ventas por sucursal</p>
          <span class="mv-seg"><span>2025</span><span class="mv-seg--on">2026</span></span>
        </div>

        <div class="mv-kpis">
          <div class="mv-kpi"><p>Ventas netas</p><b>5,22 M</b><span class="mv-var"><i></i>7,9 % vs 2025</span></div>
          <div class="mv-kpi"><p>Margen %</p><b>31,4 %</b><span class="mv-var"><i></i>1,2 pp</span></div>
          <div class="mv-kpi"><p>Ticket promedio</p><b>48,60</b><span class="mv-var"><i></i>3,1 %</span></div>
          <div class="mv-kpi"><p>Unidades</p><b>184 mil</b><span class="mv-var mv-var--baja"><i></i>0,8 %</span></div>
        </div>

        <div class="mv-graf mv-graf--meses">
          <p class="mv-graf__t">Ventas netas por mes</p>
          <p class="mv-ley"><span class="mv-ley--26">2026</span><span class="mv-ley--25">2025</span></p>
          <div class="mv-col">
            <span class="mv-eje"><span>750 mil</span><span>500 mil</span><span>250 mil</span><span>0</span></span>
            <svg class="mv-col__trazo" viewBox="0 0 90 100" preserveAspectRatio="none">
              <path class="mv-c25" d={COL_25} />
              <path class="mv-c26" d={COL_26} />
            </svg>
            <span class="mv-meses">{MESES.map((m) => <span>{m}</span>)}</span>
          </div>
        </div>

        <div class="mv-graf mv-graf--sucursales">
          <p class="mv-graf__t">Ventas netas por sucursal</p>
          <p class="mv-ley"><span class="mv-ley--26">2026</span><span class="mv-ley--25">2025</span></p>
          <div class="mv-barras">
            {SUCURSALES.map((s) => (
              <div class:list={['mv-barra', s.clase]}>
                <span class="mv-barra__nombre">{s.nombre}</span>
                <span class="mv-barra__pista">
                  <span class="mv-barra__b25"></span>
                  <span class="mv-barra__b26"><em>{s.valor}</em></span>
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="mv-pags">
        <span class="mv-pags--on">Resumen</span><span>Por sucursal</span><span>Por producto</span><span>Detalle</span>
      </div>
    </div>

    <div class="mv-chat">
      <MaquetaChat vista="consulta" />
    </div>
  </div>
</div>

<style is:global>
  .mv {
    container: maqueta-visor / inline-size;
  }

  .mv-rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    height: 34rem;
    background: #eaeaea;
  }

  .mv-reporte {
    display: none;
  }

  .mv-chat {
    min-width: 0;
    min-height: 0;
  }

  /* Con lugar, el reporte a la izquierda y el chat al costado: el panel se apoya con una
     sombra corta sobre el reporte, como en el visor real. */
  @container maqueta-visor (min-width: 50rem) {
    .mv-rejilla {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
      height: 40rem;
    }

    .mv-reporte {
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 0;
    }

    .mv-chat {
      position: relative;
      box-shadow: -10px 0 28px -16px rgb(17 24 39 / 0.35);
    }
  }

  /* ═══ El reporte: lo que dibuja Power BI (Segoe UI, tema por defecto) ═══════ */
  .mv-lienzo {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto auto minmax(0, 1fr);
    gap: 9px;
    margin: 8px 8px 0;
    padding: 13px 14px 12px;
    background: #fff;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    color: var(--pbi-tinta);
  }

  .mv-cab {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .mv-titulo {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .mv-seg {
    display: flex;
    gap: 4px;
  }

  .mv-seg span {
    padding: 2px 8px;
    border: 1px solid #c8c6c4;
    border-radius: 2px;
    background: #fff;
    font-size: 0.5625rem;
    color: var(--pbi-tinta-2);
  }

  .mv-seg .mv-seg--on {
    border-color: #0f6cbd;
    background: #0f6cbd;
    color: #fff;
  }

  .mv-kpis {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .mv-kpi {
    min-width: 0;
    padding: 7px 9px 8px;
    border: 1px solid var(--pbi-linea);
    border-radius: 3px;
  }

  .mv-kpi p {
    margin: 0;
    overflow: hidden;
    font-size: 0.5625rem;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--pbi-tinta-2);
  }

  .mv-kpi b {
    display: block;
    margin-top: 2px;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .mv-var {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.5rem;
    white-space: nowrap;
    color: var(--pbi-sube);
  }

  /* El triángulo de la variación, dibujado: las fuentes del sitio no traen flechas */
  .mv-var i {
    width: 6px;
    height: 5px;
    flex: none;
    background: currentColor;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .mv-var--baja {
    color: var(--pbi-baja);
  }

  .mv-var--baja i {
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  .mv-graf {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    padding: 8px 10px 8px;
    border: 1px solid var(--pbi-linea);
    border-radius: 3px;
  }

  .mv-graf__t {
    margin: 0;
    font-size: 0.625rem;
    font-weight: 600;
  }

  .mv-ley {
    display: flex;
    gap: 10px;
    margin: 3px 0 8px;
    font-size: 0.5rem;
    color: var(--pbi-tinta-2);
  }

  .mv-ley span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .mv-ley span::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .mv-ley--26::before { background: var(--pbi-azul); }
  .mv-ley--25::before { background: var(--pbi-azul-hondo); }

  /* Columnas por mes: eje a la izquierda, rejilla de fondo, meses abajo */
  .mv-col {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    column-gap: 6px;
  }

  .mv-eje {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin: -5px 0;
    font-size: 0.46875rem;
    text-align: right;
    color: var(--pbi-tinta-2);
  }

  .mv-col__trazo {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(to bottom, var(--pbi-linea) 0 1px, transparent 1px 33.33%);
    border-bottom: 1px solid #c8c6c4;
  }

  .mv-c25 { fill: var(--pbi-azul-hondo); }
  .mv-c26 { fill: var(--pbi-azul); }

  .mv-meses {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    padding-top: 4px;
    font-size: 0.46875rem;
    text-align: center;
    color: var(--pbi-tinta-2);
  }

  /* Barras por sucursal: dos barras por fila y la etiqueta de datos al final */
  .mv-barras {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    gap: 6px;
  }

  .mv-barra {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    align-items: center;
    gap: 6px;
  }

  .mv-barra__nombre {
    font-size: 0.5rem;
    text-align: right;
    color: var(--pbi-tinta-2);
  }

  .mv-barra__pista {
    display: grid;
    gap: 2px;
    padding-right: 2.2rem;
  }

  .mv-barra__b25,
  .mv-barra__b26 {
    position: relative;
    height: 9px;
  }

  .mv-barra__b25 {
    width: var(--b25);
    background: var(--pbi-azul-hondo);
  }

  .mv-barra__b26 {
    width: var(--b26);
    background: var(--pbi-azul);
  }

  .mv-barra__b26 em {
    position: absolute;
    top: 50%;
    left: calc(100% + 4px);
    transform: translateY(-50%);
    font-size: 0.46875rem;
    font-style: normal;
    white-space: nowrap;
    color: var(--pbi-tinta-2);
  }

  /* Anchos sobre 1.300.000 */
  .mv-sb-1 { --b25: 92.2%; --b26: 98.8%; }
  .mv-sb-2 { --b25: 87.9%; --b26: 85.1%; }
  .mv-sb-3 { --b25: 53.9%; --b26: 72.5%; }
  .mv-sb-4 { --b25: 56.2%; --b26: 59.1%; }
  .mv-sb-5 { --b25: 46.3%; --b26: 47.4%; }
  .mv-sb-6 { --b25: 35.1%; --b26: 38.3%; }

  /* Las pestañas de páginas del reporte, abajo, como en Power BI */
  .mv-pags {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 24px;
    padding: 0 8px;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  }

  .mv-pags span {
    padding: 4px 10px;
    border-radius: 2px 2px 0 0;
    background: #e1dfdd;
    font-size: 0.5625rem;
    white-space: nowrap;
    color: #484644;
  }

  .mv-pags .mv-pags--on {
    background: #fff;
    box-shadow: inset 0 2px 0 var(--pbi-azul);
    font-weight: 600;
    color: var(--pbi-tinta);
  }
</style>
