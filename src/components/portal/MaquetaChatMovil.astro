---
/**
 * Maqueta del chat con IA del Portal BI en un celular, tal como responde hoy
 * (views/modules/chat.ejs + chat.css del repositorio del portal): el análisis y el gráfico que
 * se pide aparte, con el campo, el micrófono y la memoria de la conversación. El hilo está
 * abajo del todo, como lo deja el portal cuando llega el gráfico. Va dentro de
 * <MaquetaTelefono>. Datos de ejemplo: 5.216.100 en 2026 contra 4.832.200 en 2025 (+7,9 %); el gráfico muestra 2026 por sucursal.
 *
 * Estilos globales (is:global) a propósito: con alcance, Astro marca cada elemento con un
 * atributo data-astro-cid, y en /portal-bi/ eso sumaba lo justo para que el documento cruzara
 * un viaje más de TCP en la simulación de Lighthouse. Todas las clases llevan el prefijo de
 * su maqueta, así que no chocan. Ver docs/aprendizajes.md.
 */
const VARITA =
  'M3 19.6 14.2 8.4l1.4 1.4L4.4 21zM15.6 7l1.4-1.4 1.4 1.4-1.4 1.4zM8 2l.7 1.8 1.8.7-1.8.7L8 7l-.7-1.8-1.8-.7 1.8-.7zM19 11l.6 1.4 1.4.6-1.4.6L19 15l-.6-1.4L17 13l1.4-.6zM20 1.5l.5 1.2 1.2.5-1.2.5-.5 1.2-.5-1.2-1.2-.5 1.2-.5z';

/* Barras horizontales de mayor a menor: en el ancho de un celular se leen de un vistazo.
   Ventas 2026 por sucursal, en miles (suman 5.216.100, como dice el análisis). El ancho de
   cada barra es su valor sobre el mayor (Centro); va por clase porque la CSP no admite style.
   Online, la que más crece, en verde; Norte, la única que cae, en rojo. */
const BARRAS = [
  { nombre: 'Centro', valor: '1.285', clase: 'mc-bh-1' },
  { nombre: 'Norte', valor: '1.106', clase: 'mc-bh-2', marca: 'baja' },
  { nombre: 'Online', valor: '943', clase: 'mc-bh-3', marca: 'sube' },
  { nombre: 'Sur', valor: '769', clase: 'mc-bh-4' },
  { nombre: 'Este', valor: '616', clase: 'mc-bh-5' },
  { nombre: 'Oeste', valor: '498', clase: 'mc-bh-6' },
];
---

<div class="mc mc--grafico">
  <div class="mc-cab">
    <span class="mc-marca"><svg viewBox="0 0 24 24"><path d={VARITA} /></svg></span>
    <div class="mc-id">
      <p class="mc-titulo">Ventas por sucursal</p>
      <p class="mc-sub">Pregunta sobre los datos de este tablero</p>
    </div>
    <span class="mc-resumen">4 tablas · 13 columnas · 4 medidas</span>
    <span class="mc-boton"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M12 5v14" /></svg></span>
    <span class="mc-boton"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg></span>
  </div>

  <div class="mc-hilo" data-hilo>
    <div class="mc-mov">
      <div class="mc-analisis">
        <p class="mc-analisis__t">
          <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-4 12.7V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.3A7 7 0 0 0 12 2zM9 20h6v1.2a.8.8 0 0 1-.8.8H9.8a.8.8 0 0 1-.8-.8z" /></svg>
          Análisis
        </p>
        <p><strong>Este año las sucursales venden 5.216.100, un 7,9 % más que en 2025</strong> (4.832.200).</p>
        <ul>
          <li><strong>Online</strong> es la que más crece: +34,4 %, de 701.300 a 942.800.</li>
          <li><strong>Norte</strong> es la única que cae: −3,2 %.</li>
          <li><strong>Centro</strong> sigue primera en volumen, con 1.284.500.</li>
        </ul>
      </div>

          <div class="mc-grafico">
            <p class="mc-grafico__titulo">Ventas 2026 por sucursal</p>
            <p class="mc-grafico__porque">En miles, de mayor a menor.</p>
            <p class="mc-leyenda"><span><i class="mc-s1"></i>Crece más</span><span><i class="mc-s2"></i>Única que cae</span></p>
            <div class="mc-bh">
              {BARRAS.map((r) => (
                <div class:list={['mc-bh__fila', r.clase, r.marca && `mc-bh__fila--${r.marca}`]}>
                  <span class="mc-bh__nombre">{r.nombre}</span>
                  <span class="mc-bh__pista"><span class="mc-bh__barra"></span></span>
                  <span class="mc-bh__valor">{r.valor}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="mc-acciones">
            <span class="mc-accion"><svg class="mc-trazo" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 16l5-5 4 4 3-3 6 6" /></svg>Copiar imagen</span>
          </div>
    </div>
  </div>

  <div class="mc-pie">
    <div class="mc-campo">
      <span class="mc-placeholder">Pregunta algo sobre estos datos…</span>
      <span class="mc-mic"><svg viewBox="0 0 24 24"><path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3z" /><path class="mc-trazo-mic" d="M18.5 11.5a6.5 6.5 0 0 1-13 0M12 18v3" /></svg></span>
      <span class="mc-enviar"><svg viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6" /></svg></span>
    </div>
    <div class="mc-memoria">
      <svg viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg>
      <span>Recuerda la pregunta anterior</span>
      <span class="mc-cero">Empezar de cero</span>
    </div>
    <p class="mc-nota">Las respuestas salen de una consulta al modelo. La consulta siempre queda a la vista.</p>
  </div>
</div>

<style is:global>
  /* ═══ Marco: claro y quieto, para acompañar a un reporte blanco y denso (chat.css) ═══ */
  .mc {
    container: maqueta-chat / inline-size;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    background: #f7f8fa;
    font-family: var(--mq-ui);
    color: var(--mq-g900);
    line-height: 1.45;
  }

  /* ── Encabezado ── */
  .mc-cab {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 10px 14px;
    background: #fff;
    border-bottom: 1px solid var(--mq-g200);
  }

  .mc-marca {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--mq-ia-2), var(--mq-ia-3));
  }

  .mc-marca svg {
    width: 13px;
    height: 13px;
    fill: #fff;
  }

  .mc-id {
    flex: 1;
    min-width: 0;
  }

  .mc-titulo {
    margin: 0;
    overflow: hidden;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mc-sub {
    margin: 0;
    overflow: hidden;
    font-size: 0.5625rem;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--mq-g500);
  }

  .mc-resumen {
    flex: none;
    font-size: 0.53125rem;
    white-space: nowrap;
    color: var(--mq-g500);
  }

  .mc-boton {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    flex: none;
    border: 1px solid var(--mq-g200);
    border-radius: 7px;
    background: #fff;
  }

  .mc-boton svg {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: var(--mq-g700);
    stroke-width: 2;
    stroke-linecap: round;
  }

  /* ── El hilo: recorta, y lo de adentro se mueve como un scroll ── */
  .mc-hilo {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  /* Donde el hilo se corta, se funde: se lee como algo que sigue, no como un recorte */
  .mc-hilo::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 24px;
    background: linear-gradient(rgb(247 248 250 / 0), #f7f8fa);
  }

  .mc-mov {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 16px 26px;
  }

  /* En el celular el chat acaba de recibir el gráfico: el hilo está abajo del todo, como lo
     deja el portal (alFinal), y lo que se corta es el principio del análisis. */
  .mc--grafico .mc-hilo {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .mc--grafico .mc-mov {
    flex: none;
    padding-bottom: 12px;
  }

  .mc--grafico .mc-hilo::after {
    top: 0;
    bottom: auto;
    background: linear-gradient(#f7f8fa, rgb(247 248 250 / 0));
  }

  .mc-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: -4px;
  }

  .mc-accion {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 9px;
    border: 1px solid var(--mq-g200);
    border-radius: 7px;
    background: #fff;
    font-size: 0.5625rem;
    color: var(--mq-g700);
  }

  .mc-accion svg {
    width: 10px;
    height: 10px;
    fill: currentColor;
  }

  .mc-accion .mc-trazo {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  /* El análisis: la conclusión en palabras, después de mostrar de dónde sale */
  .mc-analisis {
    padding: 11px 13px;
    border: 1px solid var(--mq-ia-borde);
    border-radius: 10px;
    background: var(--mq-ia-tenue);
  }

  .mc-analisis__t {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 6px;
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mq-g900);
  }

  .mc-analisis__t svg {
    width: 10px;
    height: 10px;
    fill: var(--mq-g900);
  }

  .mc-analisis p {
    margin: 0 0 5px;
    font-size: 0.65625rem;
    line-height: 1.55;
  }

  .mc-analisis ul {
    margin: 0;
    padding-left: 16px;
  }

  .mc-analisis li {
    margin-bottom: 2px;
    font-size: 0.65625rem;
    line-height: 1.5;
  }

  .mc-analisis strong {
    font-weight: 650;
  }

  /* ── El gráfico: barras horizontales de mayor a menor, con el valor al lado ── */
  .mc-grafico {
    padding: 11px 12px 12px;
    border: 1px solid var(--mq-g200);
    border-radius: 10px;
    background: #fff;
  }

  .mc-grafico__titulo {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--mq-g800, #1f2937);
  }

  .mc-grafico__porque {
    margin: 1px 0 7px;
    font-size: 0.5625rem;
    line-height: 1.45;
    color: var(--mq-g500);
  }

  .mc-leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0 0 9px;
    font-size: 0.5625rem;
    color: var(--mq-g700);
  }

  .mc-leyenda span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .mc-leyenda i {
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }

  .mc-s1 { background: #14b8a6; }
  .mc-s2 { background: #dc2626; }

  .mc-bh {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 5px 8px;
    align-items: center;
  }

  .mc-bh__fila {
    display: contents;
  }

  .mc-bh__nombre {
    font-size: 0.625rem;
    color: var(--mq-g700);
  }

  .mc-bh__pista {
    display: block;
    height: 9px;
  }

  .mc-bh__barra {
    display: block;
    width: var(--w);
    height: 100%;
    border-radius: 0 3px 3px 0;
    background: rgb(99 102 241 / 0.55);
  }

  .mc-bh__fila--sube .mc-bh__barra { background: #14b8a6; }
  .mc-bh__fila--baja .mc-bh__barra { background: #dc2626; }

  .mc-bh__valor {
    font-size: 0.625rem;
    font-weight: 600;
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--mq-g700);
  }

  /* Ancho = valor / mayor (Centro, 1.284.500) */
  .mc-bh-1 { --w: 100%; }
  .mc-bh-2 { --w: 86.1%; }
  .mc-bh-3 { --w: 73.4%; }
  .mc-bh-4 { --w: 59.8%; }
  .mc-bh-5 { --w: 48%; }
  .mc-bh-6 { --w: 38.8%; }

  /* ── Pie: el campo, el micrófono, enviar, y la memoria de la conversación ── */
  .mc-pie {
    padding: 9px 14px 8px;
    background: #fff;
    border-top: 1px solid var(--mq-g200);
  }

  .mc-campo {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 5px 5px 5px 12px;
    border: 1px solid var(--mq-g200);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 4px 14px rgb(17 24 39 / 0.06);
  }

  .mc-placeholder {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: 0.6875rem;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--mq-g500);
  }

  .mc-mic,
  .mc-enviar {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    flex: none;
    border-radius: 50%;
  }

  .mc-mic {
    border: 1px solid var(--mq-g200);
    background: #fff;
  }

  .mc-mic svg {
    width: 11px;
    height: 11px;
    fill: var(--mq-g700);
  }

  .mc-trazo-mic {
    fill: none;
    stroke: var(--mq-g700);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .mc-enviar {
    background: var(--mq-ia-2);
    box-shadow: 0 4px 10px -4px rgb(99 102 241 / 0.7);
  }

  .mc-enviar svg {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: #fff;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mc-memoria {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    padding: 4px 6px 4px 10px;
    border: 1px solid var(--mq-ia-borde);
    border-radius: 10px;
    background: var(--mq-ia-tenue);
    font-size: 0.5625rem;
    color: var(--mq-ia);
  }

  .mc-memoria svg {
    width: 10px;
    height: 10px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .mc-memoria span:first-of-type {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mc-cero {
    flex: none;
    padding: 1px 8px;
    border: 1px solid var(--mq-ia-borde);
    border-radius: 999px;
    background: #fff;
  }

  .mc-nota {
    margin: 5px 0 0;
    font-size: 0.5rem;
    text-align: center;
    color: var(--mq-g500);
  }

  /* ═══ Contenedor angosto (celular): lo que el portal esconde o achica en un teléfono ═══ */
  @container maqueta-chat (max-width: 26rem) {
    .mc-resumen {
      display: none;
    }
  }

  @container maqueta-chat (max-width: 17rem) {
    .mc-cab {
      gap: 7px;
      padding: 8px 9px;
    }

    .mc-marca {
      width: 22px;
      height: 22px;
      border-radius: 7px;
    }

    .mc-boton {
      width: 21px;
      height: 21px;
    }

    .mc-mov {
      gap: 8px;
      padding: 9px 9px 12px;
    }

    .mc-analisis {
      padding: 9px 10px;
    }

    .mc-analisis p,
    .mc-analisis li {
      font-size: 0.59375rem;
    }

    .mc-pie {
      padding: 7px 9px;
    }

    .mc-placeholder {
      font-size: 0.59375rem;
    }

    .mc-memoria {
      font-size: 0.5rem;
    }
  }

</style>
