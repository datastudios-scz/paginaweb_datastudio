---
/**
 * Marco de teléfono para las maquetas del Portal BI: bisel, barra de estado y la pantalla
 * donde va la app (<MaquetaPortal variante="telefono" /> o <MaquetaChat vista="grafico" />).
 * Como <Ventana>, es una ilustración: <figure> con su descripción para lectores de pantalla y
 * el cuerpo oculto para ellos. Los tokens vienen de maqueta.css.
 *
 * Estilos globales (is:global) a propósito: con alcance, Astro marca cada elemento con un
 * atributo data-astro-cid, y en /portal-bi/ eso sumaba lo justo para que el documento cruzara
 * un viaje más de TCP en la simulación de Lighthouse. Todas las clases llevan el prefijo de
 * su maqueta, así que no chocan. Ver docs/aprendizajes.md.
 */
import './maqueta.css';

interface Props {
  /** Descripción para lectores de pantalla; la maqueta en sí queda oculta para ellos. */
  descripcion: string;
  class?: string;
}

const { descripcion, class: clase } = Astro.props;
---

<figure class:list={['tel', 'mq', clase]}>
  <figcaption class="solo-lectores">{descripcion}</figcaption>
  <div class="tel__cuerpo" aria-hidden="true">
    <div class="tel__pantalla">
      <div class="tel__estado">
        <span>9:41</span>
        <span class="tel__isla"></span>
        <span class="tel__iconos">
          <svg viewBox="0 0 18 12"><path d="M1 9h2.5v3H1zM5.5 6.5H8V12H5.5zM10 4h2.5v8H10zM14.5 1H17v11h-2.5z" /></svg>
          <span class="tel__bateria"></span>
        </span>
      </div>
      <div class="tel__app"><slot /></div>
    </div>
  </div>
</figure>

<style is:global>
  /* El ancho lo puede fijar quien lo usa (--tel-ancho); la pantalla guarda la proporción */
  .tel {
    margin: 0;
    width: var(--tel-ancho, 13.25rem);
    flex: none;
  }

  /* El bisel es el fondo del cuerpo; la pantalla va adentro con su propio radio */
  .tel__cuerpo {
    padding: 7px;
    border-radius: 34px;
    background: #0b1216;
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.12),
      0 26px 48px -24px rgb(0 0 0 / 0.55),
      0 10px 18px -12px rgb(0 0 0 / 0.35);
  }

  .tel__pantalla {
    display: flex;
    flex-direction: column;
    height: calc(var(--tel-ancho, 13.25rem) * 2.07);
    overflow: hidden;
    border-radius: 27px;
    background: #fff;
  }

  .tel__estado {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    flex: none;
    height: 26px;
    padding: 0 16px;
    background: #fff;
    font-family: var(--mq-ui);
    font-size: 0.5625rem;
    font-weight: 600;
    color: #111827;
  }

  .tel__isla {
    width: 54px;
    height: 15px;
    border-radius: 999px;
    background: #0b1216;
  }

  .tel__iconos {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
  }

  .tel__iconos svg {
    width: 11px;
    height: 8px;
    fill: #111827;
  }

  .tel__bateria {
    position: relative;
    width: 15px;
    height: 7.5px;
    border: 1px solid #111827;
    border-radius: 2.5px;
  }

  .tel__bateria::after {
    content: '';
    position: absolute;
    inset: 1px 3px 1px 1px;
    border-radius: 1px;
    background: #111827;
  }

  .tel__app {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
</style>
